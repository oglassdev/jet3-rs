{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/access97-rs/g6-core-inventory.schema.json",
  "title": "G6 checked core-module inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_root", "modules"],
  "properties": {
    "schema_version": {"const": 1},
    "source_root": {"const": "crates/jet3/src"},
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "classification", "sha256"],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^crates/jet3/src/[A-Za-z0-9_-]+[.]rs$"
          },
          "classification": {
            "enum": ["format", "safety", "format_safety"]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
