{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jet3-rs:validation:repository-contract:1",
  "title": "jet3-rs repository contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "workspace_packages",
    "allowed_runtime_packages",
    "format_knowledge",
    "fixtures"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "workspace_packages": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "production",
        "support"
      ],
      "properties": {
        "production": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/productionPackage"
          }
        },
        "support": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/supportPackage"
          }
        }
      }
    },
    "allowed_runtime_packages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]+$"
      }
    },
    "format_knowledge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assertion_files",
        "reviewed_non_assertion_files"
      ],
      "properties": {
        "assertion_files": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/assertionFile"
          }
        },
        "reviewed_non_assertion_files": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/reviewedFile"
          }
        }
      }
    },
    "fixtures": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_manifest",
        "seed_manifest",
        "external_observational"
      ],
      "properties": {
        "repository_manifest": {
          "$ref": "#/$defs/repositoryPath"
        },
        "seed_manifest": {
          "$ref": "#/$defs/repositoryPath"
        },
        "external_observational": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "manifest",
            "documentation",
            "provenance",
            "redistributable",
            "regenerable",
            "acceptance_fixture"
          ],
          "properties": {
            "manifest": {
              "$ref": "#/$defs/repositoryPath"
            },
            "documentation": {
              "$ref": "#/$defs/repositoryPath"
            },
            "provenance": {
              "$ref": "#/$defs/repositoryPath"
            },
            "redistributable": {
              "const": false
            },
            "regenerable": {
              "const": false
            },
            "acceptance_fixture": {
              "const": false
            }
          }
        }
      }
    }
  },
  "$defs": {
    "repositoryPath": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+(?:[.][A-Za-z0-9_-]+)*(?:/[A-Za-z0-9_-]+(?:[.][A-Za-z0-9_-]+)*)*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "package": {
      "type": "object",
      "required": [
        "name",
        "manifest"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "manifest": {
          "$ref": "#/$defs/repositoryPath"
        }
      }
    },
    "productionPackage": {
      "allOf": [
        {
          "$ref": "#/$defs/package"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "manifest",
            "crate_root"
          ],
          "properties": {
            "name": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "manifest": {
              "$ref": "#/$defs/repositoryPath"
            },
            "crate_root": {
              "$ref": "#/$defs/repositoryPath"
            }
          }
        }
      ]
    },
    "supportPackage": {
      "allOf": [
        {
          "$ref": "#/$defs/package"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "manifest"
          ],
          "properties": {
            "name": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "manifest": {
              "$ref": "#/$defs/repositoryPath"
            }
          }
        }
      ]
    },
    "assertionFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "provenance_ids"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/repositoryPath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "provenance_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(SRC|OBS|EXP)-[0-9]{4}$"
          }
        }
      }
    },
    "reviewedFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "reason"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/repositoryPath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
