{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jet3-rs:validation:release-evidence-overlay:1",
  "title": "Detached exact-HEAD release-evidence overlay",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repository",
    "contracts",
    "files",
    "evidence"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "dirty"],
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "dirty": {
          "const": false,
          "description": "Clean under the commit-bound policy: tracked index/worktree exact, with only its declared untracked output exceptions."
        }
      }
    },
    "contracts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "overlay_schema_path",
        "overlay_schema_sha256",
        "policy_path",
        "policy_sha256"
      ],
      "properties": {
        "overlay_schema_path": {
          "const": "docs/validation/schema/release-evidence-overlay.schema.json"
        },
        "overlay_schema_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "policy_path": {
          "const": "docs/validation/evidence-policy.json"
        },
        "policy_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "size"],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*(?:/[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*)*$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "capability_id",
          "verification",
          "adapter",
          "files",
          "expected_output"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$"
          },
          "capability_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$"
          },
          "verification": {
            "enum": [
              "internal_only",
              "independent_check",
              "dao_opened",
              "dao_differential"
            ]
          },
          "adapter": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*_v[1-9][0-9]*$"
          },
          "files": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*(?:/[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*)*$"
            }
          },
          "expected_output": {
            "type": "object"
          }
        }
      }
    }
  }
}
