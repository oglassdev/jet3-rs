{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jet3-rs:validation:acceptance-summary:1",
  "title": "jet3-rs acceptance run summary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "git_commit",
    "dirty",
    "run_id",
    "release_eligible",
    "required_gates",
    "status",
    "counts",
    "gates",
    "manifest_path",
    "manifest_sha256"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "git_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "dirty": {
      "type": "boolean"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "release_eligible": {
      "type": "boolean"
    },
    "required_gates": {
      "const": [
        "G0",
        "G1",
        "G2",
        "G3",
        "G4",
        "G5",
        "G6",
        "G7",
        "G8"
      ]
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED"
      ]
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "PASS",
        "FAIL",
        "BLOCKED"
      ],
      "properties": {
        "PASS": {
          "type": "integer",
          "minimum": 0
        },
        "FAIL": {
          "type": "integer",
          "minimum": 0
        },
        "BLOCKED": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 9,
      "items": {
        "$ref": "#/$defs/gate"
      }
    },
    "manifest_path": {
      "$ref": "#/$defs/repositoryPath"
    },
    "manifest_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "repositoryPath": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+(?:[.][A-Za-z0-9_-]+)*(?:/[A-Za-z0-9_-]+(?:[.][A-Za-z0-9_-]+)*)*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate",
        "status",
        "report_path",
        "report_sha256"
      ],
      "properties": {
        "gate": {
          "pattern": "^G[0-8]$"
        },
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "BLOCKED"
          ]
        },
        "report_path": {
          "$ref": "#/$defs/repositoryPath"
        },
        "report_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
