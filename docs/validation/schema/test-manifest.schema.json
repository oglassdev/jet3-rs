{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jet3-rs:validation:test-manifest:2",
  "title": "jet3-rs deterministic test manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "inventory_policy",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 2
    },
    "inventory_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["include_ignored"],
      "properties": {
        "include_ignored": {"const": true}
      }
    },
    "cases": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "repositoryPath": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+(?:[.][A-Za-z0-9_-]+)*(?:/[A-Za-z0-9_-]+(?:[.][A-Za-z0-9_-]+)*)*$"
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/repositoryPath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "target",
        "runtime_name",
        "traceability_ids",
        "purpose",
        "distinct_invariant",
        "fixtures",
        "expected_result"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(UT|IT|PROP|GOLD|CORR|REG)-[A-Z0-9][A-Z0-9_-]*$"
        },
        "target": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "runtime_name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_]+(?:::[A-Za-z0-9_]+)*$"
        },
        "platforms": {
          "oneOf": [
            {"const": ["unix"]},
            {"const": ["windows"]},
            {"const": ["unix", "windows"]}
          ]
        },
        "traceability_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z]+-[0-9]{2}$"
          }
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "distinct_invariant": {
          "type": "string",
          "minLength": 1
        },
        "fixtures": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/fixture"
          }
        },
        "expected_result": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
