{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jet3-rs:validation:test-manifest:1",
  "title": "jet3-rs deterministic test manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "cargo_command",
    "meaningful_case_count",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "cargo_command": {
      "const": [
        "cargo",
        "test",
        "--workspace",
        "--all-targets",
        "--all-features",
        "--locked",
        "--",
        "--list"
      ]
    },
    "meaningful_case_count": {
      "type": "integer",
      "minimum": 0
    },
    "cases": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "repositoryPath": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+(?:[.][A-Za-z0-9_-]+)*(?:/[A-Za-z0-9_-]+(?:[.][A-Za-z0-9_-]+)*)*$"
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/repositoryPath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "target",
        "runtime_name",
        "traceability_ids",
        "purpose",
        "distinct_invariant",
        "fixtures",
        "expected_result",
        "ignored",
        "execution_status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(UT|IT|PROP|GOLD|CORR|REG)-[A-Z0-9][A-Z0-9_-]*$"
        },
        "target": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "runtime_name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_]+(?:::[A-Za-z0-9_]+)*$"
        },
        "traceability_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z]+-[0-9]{2}$"
          }
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "distinct_invariant": {
          "type": "string",
          "minLength": 1
        },
        "fixtures": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/fixture"
          }
        },
        "expected_result": {
          "type": "string",
          "minLength": 1
        },
        "ignored": {
          "type": "boolean"
        },
        "execution_status": {
          "enum": [
            "not_run",
            "listed",
            "ignored",
            "passed",
            "failed",
            "blocked",
            "skipped"
          ]
        }
      }
    }
  }
}
