{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jet3-rs:validation:acceptance-manifest:1",
  "title": "jet3-rs acceptance run manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "git_commit",
    "dirty",
    "run_id",
    "files"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "git_commit": {
      "$ref": "#/$defs/gitCommit"
    },
    "dirty": {
      "type": "boolean"
    },
    "run_id": {
      "$ref": "#/$defs/runId"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/runMetadata"
          },
          {
            "$ref": "#/$defs/gateResult"
          },
          {
            "$ref": "#/$defs/stream"
          }
        ]
      }
    }
  },
  "$defs": {
    "gitCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "runId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "repositoryPath": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+(?:[.][A-Za-z0-9_-]+)*(?:/[A-Za-z0-9_-]+(?:[.][A-Za-z0-9_-]+)*)*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "baseFile": {
      "type": "object",
      "required": [
        "kind",
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/repositoryPath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "runMetadata": {
      "allOf": [
        {
          "$ref": "#/$defs/baseFile"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "path",
            "sha256"
          ],
          "properties": {
            "kind": {
              "const": "run_metadata"
            },
            "path": {
              "$ref": "#/$defs/repositoryPath"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        }
      ]
    },
    "gateResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "gate",
        "path",
        "sha256"
      ],
      "properties": {
        "kind": {
          "const": "gate_result"
        },
        "gate": {
          "pattern": "^G[0-8]$"
        },
        "path": {
          "$ref": "#/$defs/repositoryPath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "stream": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "gate",
        "path",
        "sha256"
      ],
      "properties": {
        "kind": {
          "enum": [
            "stdout",
            "stderr"
          ]
        },
        "gate": {
          "pattern": "^G[0-8]$"
        },
        "path": {
          "$ref": "#/$defs/repositoryPath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
