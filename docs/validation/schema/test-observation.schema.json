{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jet3-rs:validation:test-observation:1",
  "title": "jet3-rs Cargo test inventory observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "git_commit",
    "dirty",
    "cargo_command",
    "tests",
    "counts"
  ],
  "properties": {
    "schema_version": {"type":"integer","const":1},
    "git_commit": {"type":"string","pattern":"^[0-9a-f]{40}$"},
    "dirty": {"type":"boolean"},
    "cargo_command": {
      "const": [
        "cargo","test","--workspace","--all-targets","--all-features",
        "--locked","--","--list"
      ]
    },
    "tests": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref":"#/$defs/observedTest"}
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime_total","ignored","meaningful"],
      "properties": {
        "runtime_total": {"type":"integer","minimum":0},
        "ignored": {"type":"integer","minimum":0},
        "meaningful": {"type":"integer","minimum":0}
      }
    }
  },
  "$comment": "This records test discovery and ignored state only. Pass/fail execution is separate acceptance-gate evidence.",
  "$defs": {
    "observedTest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target","runtime_name","ignored"],
      "properties": {
        "target": {"type":"string","pattern":"^[a-z][a-z0-9_]*$"},
        "runtime_name": {
          "type":"string",
          "pattern":"^[A-Za-z0-9_]+(?:::[A-Za-z0-9_]+)*$"
        },
        "ignored": {"type":"boolean"}
      }
    }
  }
}
