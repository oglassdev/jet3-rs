{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jet3-rs:validation:benchmark-manifest:1",
  "title": "jet3-rs benchmark baseline manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "baselines"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "baselines": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/baseline"
      }
    }
  },
  "$defs": {
    "repositoryPath": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+(?:[.][A-Za-z0-9_-]+)*(?:/[A-Za-z0-9_-]+(?:[.][A-Za-z0-9_-]+)*)*$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/repositoryPath"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "traceability_ids",
        "operation",
        "scenario_id",
        "row_count",
        "artifacts",
        "hardware",
        "os",
        "toolchain",
        "sample_count",
        "median_latency_ns",
        "latency_percentiles_ns",
        "throughput_per_second",
        "peak_rss_bytes",
        "output_size_bytes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^BENCH-[A-Z0-9][A-Z0-9_-]*$"
        },
        "traceability_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z]+-[0-9]{2}$"
          }
        },
        "operation": {
          "enum": [
            "open",
            "catalog_load",
            "table_scan",
            "indexed_lookup",
            "database_create",
            "insert",
            "update",
            "delete",
            "memo_ole_access",
            "semantic_verification",
            "adversarial_parse"
          ]
        },
        "scenario_id": {
          "type": "string",
          "minLength": 1
        },
        "row_count": {
          "type": "integer",
          "minimum": 0
        },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/artifact"
          }
        },
        "hardware": {
          "type": "string",
          "minLength": 1
        },
        "os": {
          "type": "string",
          "minLength": 1
        },
        "toolchain": {
          "type": "string",
          "minLength": 1
        },
        "sample_count": {
          "type": "integer",
          "minimum": 2
        },
        "median_latency_ns": {
          "type": "integer",
          "minimum": 0
        },
        "latency_percentiles_ns": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "p50",
            "p90",
            "p99"
          ],
          "properties": {
            "p50": {
              "type": "integer",
              "minimum": 0
            },
            "p90": {
              "type": "integer",
              "minimum": 0
            },
            "p99": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "throughput_per_second": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "peak_rss_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "output_size_bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
