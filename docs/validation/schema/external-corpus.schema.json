{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jet3-rs:validation:external-corpus:1",
  "title": "jet3-rs external corpus manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "environment_variable",
    "purpose",
    "fixtures"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "environment_variable": {
      "type": "string",
      "const": "JET3_EXTERNAL_FIXTURE_ROOT"
    },
    "purpose": {
      "type": "string",
      "const": "nonredistributable-read-only-corpus-verification"
    },
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/fixture"
      }
    }
  },
  "$defs": {
    "externalPath": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+(?:[.][A-Za-z0-9_-]+)*(?:/[A-Za-z0-9_-]+(?:[.][A-Za-z0-9_-]+)*)*$"
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "size_bytes",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^FIX-[0-9]{4}$"
        },
        "path": {
          "$ref": "#/$defs/externalPath"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 19
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
