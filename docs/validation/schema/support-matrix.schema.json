{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jet3-rs:validation:support-matrix:3",
  "title": "jet3-rs capability support matrix",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "capabilities"],
  "properties": {
    "schema_version": {"const": 3},
    "capabilities": {
      "type": "array",
      "minItems": 28,
      "maxItems": 28,
      "items": false,
      "prefixItems": [
        {"$ref": "#/$defs/capability", "properties": {"id": {"const": "database.open"}}},
        {"$ref": "#/$defs/capability", "properties": {"id": {"const": "database.create_empty"}}},
        {"$ref": "#/$defs/capability", "properties": {"id": {"const": "database.validate"}}},
        {"$ref": "#/$defs/capability", "properties": {"id": {"const": "format.header_and_version"}}},
        {"$ref": "#/$defs/capability", "properties": {"id": {"const": "format.pages_allocation_usage"}}},
        {"$ref": "#/$defs/capability", "properties": {"id": {"const": "schema.catalog_and_table_definitions"}}},
        {"$ref": "#/$defs/capability", "properties": {"id": {"const": "schema.create_drop_tables"}}},
        {"$ref": "#/$defs/capability", "properties": {"id": {"const": "values.all_dao_jet3_table_types"}}},
        {"$ref": "#/$defs/capability", "properties": {"id": {"const": "values.null_fixed_variable"}}},
        {"$ref": "#/$defs/capability", "properties": {"id": {"const": "values.code_pages_lossless_raw"}}},
        {"$ref": "#/$defs/capability", "properties": {"id": {"const": "values.date_currency_binary_guid_replication"}}},
        {"$ref": "#/$defs/capability", "properties": {"id": {"const": "values.memo_ole_multi_page"}}},
        {"$ref": "#/$defs/capability", "properties": {"id": {"const": "rows.streaming_read"}}},
        {"$ref": "#/$defs/capability", "properties": {"id": {"const": "rows.insert_update_delete"}}},
        {"$ref": "#/$defs/capability", "properties": {"id": {"const": "indexes.primary_unique_non_unique"}}},
        {"$ref": "#/$defs/capability", "properties": {"id": {"const": "indexes.composite_ascending_descending"}}},
        {"$ref": "#/$defs/capability", "properties": {"id": {"const": "indexes.crud_maintenance"}}},
        {"$ref": "#/$defs/capability", "properties": {"id": {"const": "relationships.create_drop_preserve_metadata"}}},
        {"$ref": "#/$defs/capability", "properties": {"id": {"const": "transactions.copy_on_write_atomic_publish"}}},
        {"$ref": "#/$defs/capability", "properties": {"id": {"const": "output.deterministic_configuration"}}},
        {"$ref": "#/$defs/capability", "properties": {"id": {"const": "safety.malformed_input_bounds_and_limits"}}},
        {"$ref": "#/$defs/capability", "properties": {"id": {"const": "ui.forms_reports_vba_macros"}}},
        {"$ref": "#/$defs/capability", "properties": {"id": {"const": "queries.execute_saved"}}},
        {"$ref": "#/$defs/capability", "properties": {"id": {"const": "security.passwords_encryption"}}},
        {"$ref": "#/$defs/capability", "properties": {"id": {"const": "replication.active_behavior"}}},
        {"$ref": "#/$defs/capability", "properties": {"id": {"const": "locking.concurrent_multi_user"}}},
        {"$ref": "#/$defs/capability", "properties": {"id": {"const": "format.jet4_accdb"}}},
        {"$ref": "#/$defs/capability", "properties": {"id": {"const": "recovery.jet_equivalent_in_place"}}}
      ]
    }
  },
  "$defs": {
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "implementation", "verification", "evidence"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*(?:[.][a-z][a-z0-9_]*)+$"},
        "implementation": {"enum": ["not_started", "partial", "implemented", "out_of_scope_v1"]},
        "verification": {"enum": ["unverified", "internal_only", "independent_check", "dao_opened", "dao_differential", "not_applicable"]},
        "evidence": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)[.]{1,2}(?:/|$)).+$"}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"implementation": {"const": "not_started"}}, "required": ["implementation"]},
          "then": {"properties": {"verification": {"const": "unverified"}, "evidence": {"maxItems": 0}}}
        },
        {
          "if": {"properties": {"implementation": {"const": "out_of_scope_v1"}}, "required": ["implementation"]},
          "then": {"properties": {"verification": {"const": "not_applicable"}, "evidence": {"maxItems": 0}}},
          "else": {"properties": {"verification": {"not": {"const": "not_applicable"}}}}
        },
        {
          "if": {"properties": {"verification": {"const": "unverified"}}, "required": ["verification"]},
          "then": {"properties": {"evidence": {"maxItems": 0}}},
          "else": {
            "if": {"properties": {"verification": {"not": {"const": "not_applicable"}}}, "required": ["verification"]},
            "then": {"properties": {"evidence": {"minItems": 1}}}
          }
        }
      ]
    }
  }
}
