{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/access97-rs/g6-cargo-mutants-outcomes-v26.schema.json",
  "title": "Supported cargo-mutants v26 outcomes.json subset",
  "$defs": {
    "line_column": {
      "type": "object",
      "additionalProperties": false,
      "required": ["line", "column"],
      "properties": {
        "line": {"type": "integer", "minimum": 1},
        "column": {"type": "integer", "minimum": 1}
      }
    },
    "mutant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "package",
        "file",
        "function",
        "span",
        "replacement",
        "genre"
      ],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "package": {"type": "string", "minLength": 1},
        "file": {"type": "string", "minLength": 1},
        "function": {"type": ["object", "null"]},
        "span": {
          "type": "object",
          "additionalProperties": false,
          "required": ["start", "end"],
          "properties": {
            "start": {"$ref": "#/$defs/line_column"},
            "end": {"$ref": "#/$defs/line_column"}
          }
        },
        "replacement": {"type": "string"},
        "genre": {"type": "string", "minLength": 1}
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "outcomes",
    "total_mutants",
    "missed",
    "caught",
    "timeout",
    "unviable",
    "success",
    "start_time",
    "end_time",
    "cargo_mutants_version"
  ],
  "properties": {
    "outcomes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scenario",
          "summary",
          "log_path",
          "diff_path",
          "phase_results"
        ],
        "properties": {
          "scenario": {
            "oneOf": [
              {"const": "Baseline"},
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["Mutant"],
                "properties": {"Mutant": {"$ref": "#/$defs/mutant"}}
              }
            ]
          },
          "summary": {
            "enum": [
              "Success",
              "CaughtMutant",
              "MissedMutant",
              "Timeout",
              "Unviable"
            ]
          },
          "log_path": {"type": "string", "minLength": 1},
          "diff_path": {"type": ["string", "null"]},
          "phase_results": {"type": "array", "minItems": 1}
        }
      }
    },
    "total_mutants": {"type": "integer", "minimum": 0},
    "missed": {"type": "integer", "minimum": 0},
    "caught": {"type": "integer", "minimum": 0},
    "timeout": {"type": "integer", "minimum": 0},
    "unviable": {"type": "integer", "minimum": 0},
    "success": {"const": 1},
    "start_time": {"type": "string", "minLength": 1},
    "end_time": {"type": "string", "minLength": 1},
    "cargo_mutants_version": {
      "type": "string",
      "pattern": "^26[.][0-9]+[.][0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
    }
  }
}
