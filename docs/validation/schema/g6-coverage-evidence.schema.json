{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/access97-rs/g6-coverage-evidence.schema.json",
  "title": "G6 commit-bound coverage evidence envelope",
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "git_commit",
    "git_dirty",
    "rust_toolchain_sha256",
    "tool",
    "command",
    "inventory_sha256",
    "sources",
    "report"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "coverage"},
    "git_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "git_dirty": {"const": false},
    "rust_toolchain_sha256": {"$ref": "#/$defs/sha256"},
    "tool": {"type": "string", "minLength": 1},
    "command": {"type": "string", "minLength": 1},
    "inventory_sha256": {"$ref": "#/$defs/sha256"},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/source"}
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "format"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "format": {"enum": ["llvm-cov-json", "lcov"]}
      }
    }
  }
}
