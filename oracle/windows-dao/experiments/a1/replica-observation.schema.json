{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/oglassdev/jet3-rs/oracle/windows-dao/experiments/a1/replica-observation.schema.json",
  "title": "DAO A1 replica checkpoint and page-hash observation",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "document_type", "experiment_id", "plan_sha256", "producer_commit", "repository_url", "run_id", "environment_sha256", "provider_sha256", "replica", "role_binding", "logical_checkpoint_read_bytes", "inserted_rows_total", "changed_hash_entries", "checkpoints"],
  "properties": {
    "protocol_version": {"const": "1.0.0"},
    "document_type": {"const": "dao_a1_replica_observation"},
    "experiment_id": {"const": "DAO-A1-ALLOCATION-MAPS-001"},
    "plan_sha256": {"$ref": "#/$defs/sha256"},
    "producer_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "repository_url": {"const": "https://github.com/oglassdev/jet3-rs.git"},
    "run_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "environment_sha256": {"$ref": "#/$defs/sha256"},
    "provider_sha256": {"$ref": "#/$defs/sha256"},
    "replica": {"type": "integer", "minimum": 1, "maximum": 3},
    "role_binding": {"$ref": "#/$defs/roleBinding"},
    "logical_checkpoint_read_bytes": {"type": "integer", "minimum": 0, "maximum": 8589934592},
    "inserted_rows_total": {"type": "integer", "minimum": 0, "maximum": 200000},
    "changed_hash_entries": {"type": "integer", "minimum": 0, "maximum": 1500000},
    "checkpoints": {"type": "array", "minItems": 71, "maxItems": 71, "items": {"$ref": "#/$defs/checkpoint"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "roleBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["D", "L", "P", "H"],
      "properties": {
        "D": {"type": "string", "enum": ["A1TAB_A", "A1TAB_B", "A1TAB_C", "A1TAB_D"]},
        "L": {"type": "string", "enum": ["A1TAB_A", "A1TAB_B", "A1TAB_C", "A1TAB_D"]},
        "P": {"type": "string", "enum": ["A1TAB_A", "A1TAB_B", "A1TAB_C", "A1TAB_D"]},
        "H": {"type": "string", "enum": ["A1TAB_A", "A1TAB_B", "A1TAB_C", "A1TAB_D"]}
      }
    },
    "rowCounts": {
      "type": "object", "additionalProperties": false,
      "required": ["D", "L", "P", "H"],
      "properties": {
        "D": {"type": "integer", "minimum": 0, "maximum": 200000},
        "L": {"type": "integer", "minimum": 0, "maximum": 200000},
        "P": {"type": "integer", "minimum": 0, "maximum": 200000},
        "H": {"type": "integer", "minimum": 0, "maximum": 200000}
      }
    },
    "reread": {
      "type": "object", "additionalProperties": false,
      "required": ["role", "row_count", "rolling_sha256"],
      "properties": {
        "role": {"type": "string", "enum": ["D", "L", "P", "H"]},
        "row_count": {"type": "integer", "minimum": 0, "maximum": 200000},
        "rolling_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "companion": {
      "type": "object", "additionalProperties": false,
      "required": ["present_after_close", "observed_size_bytes", "retained_for_physical_analysis"],
      "properties": {
        "present_after_close": {"const": false},
        "observed_size_bytes": {"type": "integer", "minimum": 0, "maximum": 65536},
        "retained_for_physical_analysis": {"const": false}
      }
    },
    "artifactRef": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^page-indexes/replica-[0-9]{2}/[0-9]{2}-[A-Z0-9_]+\\.json$"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1, "maximum": 67108864}
      }
    },
    "checkpoint": {
      "type": "object", "additionalProperties": false,
      "required": ["checkpoint_id", "ordinal", "actual_file_pages", "actual_size_bytes", "target_baseline_pages", "target_threshold_pages", "target_overshoot_pages", "inserted_rows_total", "table_row_counts", "dao_reread", "quiescent", "post_close_companion", "page_index"],
      "properties": {
        "checkpoint_id": {"type": "string", "minLength": 2, "maxLength": 32, "pattern": "^[A-Z0-9_]+$"},
        "ordinal": {"type": "integer", "minimum": 0, "maximum": 70},
        "actual_file_pages": {"type": "integer", "minimum": 1, "maximum": 20480},
        "actual_size_bytes": {"type": "integer", "minimum": 2048, "maximum": 41943040},
        "target_baseline_pages": {"anyOf": [{"type": "null"}, {"type": "integer", "minimum": 1, "maximum": 20480}]},
        "target_threshold_pages": {"anyOf": [{"type": "null"}, {"type": "integer", "minimum": 1, "maximum": 20480}]},
        "target_overshoot_pages": {"anyOf": [{"type": "null"}, {"type": "integer", "minimum": 0, "maximum": 20479}]},
        "inserted_rows_total": {"type": "integer", "minimum": 0, "maximum": 200000},
        "table_row_counts": {"$ref": "#/$defs/rowCounts"},
        "dao_reread": {"type": "array", "minItems": 0, "maxItems": 4, "uniqueItems": true, "items": {"$ref": "#/$defs/reread"}},
        "quiescent": {"const": true},
        "post_close_companion": {"$ref": "#/$defs/companion"},
        "page_index": {"$ref": "#/$defs/artifactRef"}
      }
    }
  }
}
