{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/oglassdev/jet3-rs/oracle/windows-dao/experiments/a1/bundle-manifest.schema.json",
  "title": "DAO A1 complete evidence bundle manifest",
  "type": "object", "additionalProperties": false,
  "required": ["protocol_version", "document_type", "experiment_id", "run_id", "producer_commit", "repository_url", "created_utc", "plan_sha256", "environment_sha256", "provider_sha256", "replica_count", "checkpoint_count", "page_blob_count", "bundle_size_bytes_excluding_manifest", "inventory_closed", "hashes_verified", "paths_closed", "execution_status", "files"],
  "properties": {
    "protocol_version": {"const": "1.0.0"}, "document_type": {"const": "dao_a1_bundle_manifest"},
    "experiment_id": {"const": "DAO-A1-ALLOCATION-MAPS-001"},
    "run_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "producer_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "repository_url": {"const": "https://github.com/oglassdev/jet3-rs.git"},
    "created_utc": {"type": "string", "format": "date-time", "maxLength": 64},
    "plan_sha256": {"$ref": "#/$defs/sha256"}, "environment_sha256": {"$ref": "#/$defs/sha256"}, "provider_sha256": {"$ref": "#/$defs/sha256"},
    "replica_count": {"const": 3}, "checkpoint_count": {"const": 213},
    "page_blob_count": {"type": "integer", "minimum": 1, "maximum": 262144},
    "bundle_size_bytes_excluding_manifest": {"type": "integer", "minimum": 1, "maximum": 805306368},
    "inventory_closed": {"const": true}, "hashes_verified": {"const": true}, "paths_closed": {"const": true},
    "execution_status": {"const": "pass"},
    "files": {"type": "array", "minItems": 220, "maxItems": 262500, "uniqueItems": true, "items": {"$ref": "#/$defs/file"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "file": {"type": "object", "additionalProperties": false, "required": ["path", "role", "sha256", "size_bytes", "media_type"], "properties": {
      "path": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"},
      "role": {"type": "string", "enum": ["plan", "environment", "replica_observation", "page_index", "page_blob", "analysis_report", "acquisition_log"]},
      "sha256": {"$ref": "#/$defs/sha256"}, "size_bytes": {"type": "integer", "minimum": 1, "maximum": 67108864},
      "media_type": {"type": "string", "enum": ["application/json", "application/octet-stream", "text/plain"]}
    }}
  }
}
