{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/oglassdev/jet3-rs/oracle/windows-dao/experiments/a1/plan.schema.json",
  "title": "DAO A1 allocation-map preregistration",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "document_type", "experiment_id", "preregistration", "execution_gate", "repository_binding", "environment_binding", "question", "replicas", "tables", "checkpoint_design", "page_capture", "hypotheses", "decision_rules", "artifacts", "bounds", "claims"],
  "properties": {
    "protocol_version": {"const": "1.0.0"},
    "document_type": {"const": "dao_a1_allocation_maps_plan"},
    "experiment_id": {"const": "DAO-A1-ALLOCATION-MAPS-001"},
    "preregistration": {"$ref": "#/$defs/preregistration"},
    "execution_gate": {"$ref": "#/$defs/executionGate"},
    "repository_binding": {"$ref": "#/$defs/repositoryBinding"},
    "environment_binding": {"$ref": "#/$defs/environmentBinding"},
    "question": {"type": "string", "minLength": 1, "maxLength": 1024},
    "replicas": {"$ref": "#/$defs/replicas"},
    "tables": {"type": "object"},
    "checkpoint_design": {"type": "object"},
    "page_capture": {"type": "object"},
    "hypotheses": {"type": "object"},
    "decision_rules": {"type": "object"},
    "artifacts": {"type": "object"},
    "bounds": {"$ref": "#/$defs/bounds"},
    "claims": {"$ref": "#/$defs/claims"}
  },
  "$defs": {
    "preregistration": {
      "type": "object", "additionalProperties": false,
      "required": ["provenance_entry", "recorded_utc_date", "acquisition_started", "checkpoint_ceiling_correction", "amendment_rule"],
      "properties": {
        "provenance_entry": {"const": "EXP-0037"},
        "recorded_utc_date": {"const": "2026-08-19"},
        "acquisition_started": {"const": false},
        "checkpoint_ceiling_correction": {"type": "string", "minLength": 1, "maxLength": 512},
        "amendment_rule": {"type": "string", "minLength": 1, "maxLength": 512}
      }
    },
    "executionGate": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "blocking_requirements"],
      "properties": {
        "status": {"const": "BLOCKED"},
        "blocking_requirements": {"type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}}
      }
    },
    "repositoryBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["canonical_https_url", "producer_commit_required", "clean_worktree_required", "pushed_commit_required"],
      "properties": {
        "canonical_https_url": {"const": "https://github.com/oglassdev/jet3-rs.git"},
        "producer_commit_required": {"const": true},
        "clean_worktree_required": {"const": true},
        "pushed_commit_required": {"const": true}
      }
    },
    "environmentBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["operating_system", "process_architecture", "powershell_major", "python_version", "dao_prog_id", "provider_identity_and_binary_hash_required"],
      "properties": {
        "operating_system": {"const": "Windows"},
        "process_architecture": {"const": "x86"},
        "powershell_major": {"const": 5},
        "python_version": {"const": "3.13.x"},
        "dao_prog_id": {"const": "DAO.DBEngine.36"},
        "provider_identity_and_binary_hash_required": {"const": true}
      }
    },
    "replicas": {
      "type": "object", "additionalProperties": false,
      "required": ["count", "derivation", "holdout", "holdout_rule"],
      "properties": {
        "count": {"const": 3},
        "derivation": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": {"type": "integer", "minimum": 1, "maximum": 2}},
        "holdout": {"const": 3},
        "holdout_rule": {"type": "string", "minLength": 1, "maxLength": 512}
      }
    },
    "bounds": {
      "type": "object", "additionalProperties": false,
      "required": ["page_size", "replicas", "max_checkpoints_per_replica", "planned_checkpoints_per_replica", "max_final_pages_per_replica", "max_logical_checkpoint_read_bytes_per_replica", "max_unique_page_blobs", "max_retained_page_store_bytes", "max_bundle_bytes", "max_inserted_rows_per_replica", "max_changed_hash_entries", "max_candidate_models", "max_analysis_work_units", "max_json_bytes", "worker_timeout_seconds", "campaign_timeout_seconds", "max_child_log_bytes", "max_companion_bytes_per_checkpoint"],
      "properties": {
        "page_size": {"const": 2048}, "replicas": {"const": 3},
        "max_checkpoints_per_replica": {"const": 72}, "planned_checkpoints_per_replica": {"const": 71},
        "max_final_pages_per_replica": {"const": 20480},
        "max_logical_checkpoint_read_bytes_per_replica": {"const": 8589934592},
        "max_unique_page_blobs": {"const": 262144}, "max_retained_page_store_bytes": {"const": 536870912},
        "max_bundle_bytes": {"const": 805306368}, "max_inserted_rows_per_replica": {"const": 200000},
        "max_changed_hash_entries": {"const": 1500000}, "max_candidate_models": {"const": 1000000},
        "max_analysis_work_units": {"const": 250000000}, "max_json_bytes": {"const": 67108864},
        "worker_timeout_seconds": {"const": 1800}, "campaign_timeout_seconds": {"const": 7200},
        "max_child_log_bytes": {"const": 1048576}, "max_companion_bytes_per_checkpoint": {"const": 65536}
      }
    },
    "claims": {
      "type": "object", "additionalProperties": false,
      "required": ["descriptive_provider_observation_only", "general_tdef_catalog_row_index_or_lval_layout", "unobserved_slot_or_base_behavior", "compaction_encryption_or_version_behavior", "rust_correctness", "dao_compatibility_or_support"],
      "properties": {
        "descriptive_provider_observation_only": {"const": true},
        "general_tdef_catalog_row_index_or_lval_layout": {"const": false},
        "unobserved_slot_or_base_behavior": {"const": false},
        "compaction_encryption_or_version_behavior": {"const": false},
        "rust_correctness": {"const": false},
        "dao_compatibility_or_support": {"const": false}
      }
    }
  }
}
