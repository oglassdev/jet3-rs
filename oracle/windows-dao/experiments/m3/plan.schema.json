{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jet3-rs:dao:m3:plan:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "document_type",
    "experiment_id",
    "replica_count",
    "page_size",
    "bounds",
    "repository_url",
    "remote_ref",
    "conditions",
    "samples",
    "comparisons"
  ],
  "properties": {
    "protocol_version": {"const": "1.0.0"},
    "document_type": {"const": "dao_m3_plan"},
    "experiment_id": {"const": "DAO-M3-REPLICATED-DELTAS-001"},
    "replica_count": {"const": 3},
    "page_size": {"const": 2048},
    "remote_ref": {"const": "refs/heads/codex/windows-dao-oracle"},
    "repository_url": {"const": "https://github.com/oglassdev/jet3-rs.git"},
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_database_bytes",
        "max_total_database_bytes",
        "max_analysis_bytes",
        "max_pages_per_sample",
        "worker_timeout_seconds"
      ],
      "properties": {
        "max_database_bytes": {"const": 1048576},
        "max_total_database_bytes": {"const": 9437184},
        "max_analysis_bytes": {"const": 16777216},
        "max_pages_per_sample": {"const": 512},
        "worker_timeout_seconds": {"const": 120}
      }
    },
    "conditions": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/condition"}
    },
    "samples": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/sample"}
    },
    "comparisons": {
      "type": "array",
      "minItems": 18,
      "maxItems": 18,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/comparison"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identifier": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9-]{0,63}$"},
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["condition_id", "scenario_id", "scenario_path", "scenario_sha256"],
      "properties": {
        "condition_id": {"enum": ["B", "E", "I"]},
        "scenario_id": {"$ref": "#/$defs/identifier"},
        "scenario_path": {
          "type": "string",
          "pattern": "^oracle/windows-dao/examples/[A-Za-z0-9.-]+[.]scenario[.]json$"
        },
        "scenario_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sample_id", "condition_id", "replica", "block", "launch_ordinal"],
      "properties": {
        "sample_id": {"$ref": "#/$defs/identifier"},
        "condition_id": {"enum": ["B", "E", "I"]},
        "replica": {"type": "integer", "minimum": 1, "maximum": 3},
        "block": {"type": "integer", "minimum": 1, "maximum": 3},
        "launch_ordinal": {"type": "integer", "minimum": 1, "maximum": 9}
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["comparison_id", "left_sample_id", "right_sample_id", "kind", "paired"],
      "properties": {
        "comparison_id": {"$ref": "#/$defs/identifier"},
        "left_sample_id": {"$ref": "#/$defs/identifier"},
        "right_sample_id": {"$ref": "#/$defs/identifier"},
        "kind": {"enum": ["within_condition", "baseline_index"]},
        "paired": {"type": "boolean"}
      }
    }
  }
}
