{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jet3-rs:dao:m4:plan:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "document_type",
    "experiment_id",
    "provenance_ids",
    "repository_url",
    "remote_ref",
    "requires_exact_clean_commit",
    "execution_gate",
    "design",
    "bounds",
    "analysis",
    "conditions",
    "samples"
  ],
  "properties": {
    "protocol_version": {"const": "1.0.0"},
    "document_type": {"const": "dao_m4_plan"},
    "experiment_id": {"const": "DAO-M4-HEADER-DISCRIMINATOR-001"},
    "provenance_ids": {
      "const": ["SRC-0013", "SRC-0014", "SRC-0015", "SRC-0016"]
    },
    "repository_url": {
      "const": "https://github.com/oglassdev/jet3-rs.git"
    },
    "remote_ref": {
      "const": "refs/heads/codex/jet3-v1-foundations"
    },
    "requires_exact_clean_commit": {"const": true},
    "execution_gate": {
      "const": {
        "status": "BLOCKED",
        "reason": "runner_and_analysis_not_implemented"
      }
    },
    "design": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "creation_method",
        "compact_database_used",
        "database_content",
        "locale",
        "worker_architecture",
        "version_factor",
        "encryption_factor",
        "replicas_per_condition",
        "block_count",
        "schedule",
        "workers_per_sample",
        "worker_ordinal_rule",
        "controller_clone",
        "phases"
      ],
      "properties": {
        "creation_method": {"const": "DBEngine.CreateDatabase"},
        "compact_database_used": {"const": false},
        "database_content": {"const": "empty_user_schema"},
        "locale": {"const": ";LANGID=0x0409;CP=1252;COUNTRY=0"},
        "worker_architecture": {"const": "x86"},
        "version_factor": {
          "const": ["dbVersion20", "dbVersion30", "dbVersion40"]
        },
        "encryption_factor": {
          "const": ["unencrypted", "dbEncrypt"]
        },
        "replicas_per_condition": {"const": 6},
        "block_count": {"const": 6},
        "schedule": {"const": "complete_cyclic_latin"},
        "workers_per_sample": {"const": 2},
        "worker_ordinal_rule": {
          "const": {
            "creator": "2*launch_ordinal-1",
            "reopen": "2*launch_ordinal"
          }
        },
        "controller_clone": {
          "const": {
            "owner": "controller",
            "source": "closed_creator_database",
            "destination": "separate_reopen_database",
            "exact_byte_clone": true,
            "rehash_source_after_clone": true,
            "require_three_way_hash_equality": true,
            "no_hardlinks": true,
            "reparse_free": true,
            "completed_before_reopen_com": true
          }
        },
        "phases": {
          "type": "object",
          "additionalProperties": false,
          "required": ["creator", "reopen"],
          "properties": {
            "creator": {
              "const": {
                "phase_id": "creator",
                "phase_ordinal": 1,
                "operation": "create_close_observe",
                "fresh_x86_worker": true
              }
            },
            "reopen": {
              "const": {
                "phase_id": "reopen",
                "phase_ordinal": 2,
                "operation": "reopen_clone_close_observe",
                "fresh_x86_worker": true
              }
            }
          }
        }
      }
    },
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_database_bytes",
        "max_database_artifacts",
        "max_total_database_bytes",
        "max_acquisition_database_reads",
        "max_acquisition_database_read_bytes",
        "max_validator_database_reads_per_run",
        "max_validator_database_read_bytes_per_run",
        "max_plan_bytes",
        "max_sample_record_bytes",
        "max_analysis_report_bytes",
        "prefix_bytes_per_phase",
        "max_prefix_artifacts",
        "max_total_prefix_bytes",
        "max_analyzed_offsets",
        "max_comparisons",
        "max_comparison_byte_visits",
        "max_candidate_sets",
        "max_worker_processes",
        "worker_timeout_seconds"
      ],
      "properties": {
        "max_database_bytes": {"const": 1048576},
        "max_database_artifacts": {"const": 72},
        "max_total_database_bytes": {"const": 75497472},
        "max_acquisition_database_reads": {"const": 180},
        "max_acquisition_database_read_bytes": {"const": 188743680},
        "max_validator_database_reads_per_run": {"const": 72},
        "max_validator_database_read_bytes_per_run": {"const": 75497472},
        "max_plan_bytes": {"const": 1048576},
        "max_sample_record_bytes": {"const": 65536},
        "max_analysis_report_bytes": {"const": 16777216},
        "prefix_bytes_per_phase": {"const": 2048},
        "max_prefix_artifacts": {"const": 72},
        "max_total_prefix_bytes": {"const": 147456},
        "max_analyzed_offsets": {"const": 1536},
        "max_comparisons": {"const": 324},
        "max_comparison_byte_visits": {"const": 995328},
        "max_candidate_sets": {"const": 24},
        "max_worker_processes": {"const": 72},
        "worker_timeout_seconds": {"const": 120}
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "retained_prefix_range",
        "analyzed_ranges",
        "excluded_ranges",
        "comparison_kinds",
        "physical_meaning_may_be_assigned",
        "compatibility_may_be_claimed"
      ],
      "properties": {
        "retained_prefix_range": {"const": {"start": 0, "end": 2048}},
        "analyzed_ranges": {"const": [{"start": 0, "end": 1536}]},
        "excluded_ranges": {
          "const": [
            {
              "start": 1536,
              "end": 2048,
              "provenance_id": "SRC-0013"
            }
          ]
        },
        "comparison_kinds": {
          "const": [
            "paired_phase",
            "within_condition",
            "matched_version",
            "matched_encryption"
          ]
        },
        "physical_meaning_may_be_assigned": {"const": false},
        "compatibility_may_be_claimed": {"const": false}
      }
    },
    "conditions": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "anyOf": [
          {"$ref": "#/$defs/v20u"},
          {"$ref": "#/$defs/v20e"},
          {"$ref": "#/$defs/v30u"},
          {"$ref": "#/$defs/v30e"},
          {"$ref": "#/$defs/v40u"},
          {"$ref": "#/$defs/v40e"}
        ]
      }
    },
    "samples": {
      "type": "array",
      "minItems": 36,
      "maxItems": 36,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/sample"}
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9-]{0,63}$"
    },
    "safe_relative_path": {
      "type": "string",
      "minLength": 3,
      "maxLength": 255,
      "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9._-]{0,63}/){1,5}[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "v20u": {
      "const": {"condition_id": "V20-U", "version_option": "dbVersion20", "version_api_value": 16, "encryption_option": "omitted", "encryption_api_value": 0, "create_option_value": 16, "expected_dao_version": "2.0"}
    },
    "v20e": {
      "const": {"condition_id": "V20-E", "version_option": "dbVersion20", "version_api_value": 16, "encryption_option": "dbEncrypt", "encryption_api_value": 2, "create_option_value": 18, "expected_dao_version": "2.0"}
    },
    "v30u": {
      "const": {"condition_id": "V30-U", "version_option": "dbVersion30", "version_api_value": 32, "encryption_option": "omitted", "encryption_api_value": 0, "create_option_value": 32, "expected_dao_version": "3.0"}
    },
    "v30e": {
      "const": {"condition_id": "V30-E", "version_option": "dbVersion30", "version_api_value": 32, "encryption_option": "dbEncrypt", "encryption_api_value": 2, "create_option_value": 34, "expected_dao_version": "3.0"}
    },
    "v40u": {
      "const": {"condition_id": "V40-U", "version_option": "dbVersion40", "version_api_value": 64, "encryption_option": "omitted", "encryption_api_value": 0, "create_option_value": 64, "expected_dao_version": "4.0"}
    },
    "v40e": {
      "const": {"condition_id": "V40-E", "version_option": "dbVersion40", "version_api_value": 64, "encryption_option": "dbEncrypt", "encryption_api_value": 2, "create_option_value": 66, "expected_dao_version": "4.0"}
    },
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sample_id",
        "condition_id",
        "replica",
        "block",
        "position_in_block",
        "launch_ordinal",
        "creator_database_path",
        "reopen_database_path",
        "record_path"
      ],
      "properties": {
        "sample_id": {"$ref": "#/$defs/identifier"},
        "condition_id": {"enum": ["V20-U", "V20-E", "V30-U", "V30-E", "V40-U", "V40-E"]},
        "replica": {"type": "integer", "minimum": 1, "maximum": 6},
        "block": {"type": "integer", "minimum": 1, "maximum": 6},
        "position_in_block": {"type": "integer", "minimum": 1, "maximum": 6},
        "launch_ordinal": {"type": "integer", "minimum": 1, "maximum": 36},
        "creator_database_path": {"$ref": "#/$defs/safe_relative_path"},
        "reopen_database_path": {"$ref": "#/$defs/safe_relative_path"},
        "record_path": {"$ref": "#/$defs/safe_relative_path"}
      }
    }
  }
}
