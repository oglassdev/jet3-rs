{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jet3-rs:dao:m4:analysis-report:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "document_type",
    "experiment_id",
    "plan_sha256",
    "sample_records",
    "bounds",
    "comparisons",
    "candidate_sets",
    "excluded_region_analyzed",
    "physical_meaning_assigned",
    "compatibility_claimed",
    "execution_status",
    "scientific_outcome"
  ],
  "properties": {
    "protocol_version": {"const": "1.0.0"},
    "document_type": {"const": "dao_m4_analysis_report"},
    "experiment_id": {"const": "DAO-M4-HEADER-DISCRIMINATOR-001"},
    "plan_sha256": {"$ref": "#/$defs/sha256"},
    "sample_records": {
      "type": "array",
      "minItems": 36,
      "maxItems": 36,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sample_id", "record_path", "record_sha256"],
        "properties": {
          "sample_id": {"$ref": "#/$defs/sample_id"},
          "record_path": {"$ref": "#/$defs/safe_relative_path"},
          "record_sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "bounds": {
      "const": {
        "retained_prefix_range": {"start": 0, "end": 2048},
        "analyzed_ranges": [{"start": 0, "end": 1536}],
        "excluded_ranges": [{"start": 1536, "end": 2048}],
        "max_analyzed_offsets": 1536,
        "max_comparisons": 324
      }
    },
    "comparisons": {
      "type": "array",
      "minItems": 324,
      "maxItems": 324,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/comparison"}
    },
    "candidate_sets": {
      "type": "array",
      "minItems": 0,
      "maxItems": 24,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/candidate_set"}
    },
    "excluded_region_analyzed": {"const": false},
    "physical_meaning_assigned": {"const": false},
    "compatibility_claimed": {"const": false},
    "execution_status": {"const": "pass"},
    "scientific_outcome": {
      "enum": [
        "candidate_offsets_observed",
        "no_candidates_observed",
        "inconclusive"
      ]
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9-]{0,63}$"
    },
    "sample_id": {
      "type": "string",
      "pattern": "^M4-V(?:20|30|40)-(?:U|E)-0[1-6]$"
    },
    "safe_relative_path": {
      "type": "string",
      "minLength": 3,
      "maxLength": 255,
      "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9._-]{0,63}/){1,5}[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "phase_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sample_id", "phase_id"],
      "properties": {
        "sample_id": {"$ref": "#/$defs/sample_id"},
        "phase_id": {"enum": ["creator", "reopen"]}
      }
    },
    "offsets": {
      "type": "array",
      "maxItems": 1536,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 1535
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "comparison_id",
        "kind",
        "left",
        "right",
        "differing_offsets"
      ],
      "properties": {
        "comparison_id": {"$ref": "#/$defs/identifier"},
        "kind": {
          "enum": [
            "paired_phase",
            "within_condition",
            "matched_version",
            "matched_encryption"
          ]
        },
        "left": {"$ref": "#/$defs/phase_ref"},
        "right": {"$ref": "#/$defs/phase_ref"},
        "differing_offsets": {"$ref": "#/$defs/offsets"}
      }
    },
    "candidate_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_set_id",
        "factor",
        "phase_id",
        "absolute_offsets",
        "comparison_occurrences"
      ],
      "properties": {
        "candidate_set_id": {"$ref": "#/$defs/identifier"},
        "factor": {"enum": ["version", "encryption", "paired_reopen"]},
        "phase_id": {"enum": ["creator", "reopen", "paired"]},
        "absolute_offsets": {"$ref": "#/$defs/offsets"},
        "comparison_occurrences": {
          "type": "array",
          "maxItems": 1536,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["offset", "occurrences"],
            "properties": {
              "offset": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1535
              },
              "occurrences": {
                "type": "integer",
                "minimum": 1,
                "maximum": 324
              }
            }
          }
        }
      }
    }
  }
}
