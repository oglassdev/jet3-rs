{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jet3-rs:dao:m4:bundle-manifest:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version", "document_type", "experiment_id", "run_id",
    "producer_commit", "created_at_utc", "sample_count", "worker_count",
    "file_count", "bundle_tree_complete", "unexpected_files_present",
    "symlinks_or_reparses_present", "execution_status", "files"
  ],
  "properties": {
    "protocol_version": {"const": "1.0.0"},
    "document_type": {"const": "dao_m4_bundle_manifest"},
    "experiment_id": {"const": "DAO-M4-HEADER-DISCRIMINATOR-001"},
    "run_id": {"type": "string", "pattern": "^[0-9]{8}T[0-9]{6}Z-m4-[a-z0-9-]{1,24}$"},
    "producer_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "created_at_utc": {"type": "string", "format": "date-time"},
    "sample_count": {"const": 36},
    "worker_count": {"const": 72},
    "file_count": {"const": 507},
    "bundle_tree_complete": {"const": true},
    "unexpected_files_present": {"const": false},
    "symlinks_or_reparses_present": {"const": false},
    "execution_status": {"const": "pass"},
    "files": {
      "type": "array", "minItems": 507, "maxItems": 507, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "role", "sha256", "size_bytes", "media_type"],
        "properties": {
          "path": {"$ref": "#/$defs/path"},
          "role": {"enum": [
            "plan", "environment", "analysis_report", "sample_record",
            "phase_invocation", "phase_worker_result", "operation_log",
            "semantic_snapshot", "clone_log", "database", "prefix"
          ]},
          "sha256": {"$ref": "#/$defs/sha"},
          "size_bytes": {"type": "integer", "minimum": 0, "maximum": 16777216},
          "media_type": {"enum": ["application/json", "application/octet-stream"]}
        }
      }
    }
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "path": {"type": "string", "minLength": 3, "maxLength": 255, "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9._-]{0,63}/){1,5}[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"}
  }
}
