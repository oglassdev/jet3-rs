{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jet3-rs:dao:m4:clone-log:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version", "document_type", "experiment_id", "sample_id",
    "started_at_utc", "completed_at_utc", "source_path", "destination_path",
    "source_bytes", "destination_bytes", "source_sha256_before_clone",
    "source_sha256_after_clone", "destination_sha256", "source_file_identity",
    "destination_file_identity", "all_hashes_equal", "same_volume",
    "distinct_file_identity", "no_hardlink", "reparse_free",
    "completed_before_reopen_com", "status"
  ],
  "properties": {
    "protocol_version": {"const": "1.0.0"},
    "document_type": {"const": "dao_m4_clone_log"},
    "experiment_id": {"const": "DAO-M4-HEADER-DISCRIMINATOR-001"},
    "sample_id": {"type": "string", "pattern": "^M4-V(?:20|30|40)-(?:U|E)-0[1-6]$"},
    "started_at_utc": {"type": "string", "format": "date-time"},
    "completed_at_utc": {"type": "string", "format": "date-time"},
    "source_path": {"$ref": "#/$defs/path"},
    "destination_path": {"$ref": "#/$defs/path"},
    "source_bytes": {"$ref": "#/$defs/bytes"},
    "destination_bytes": {"$ref": "#/$defs/bytes"},
    "source_sha256_before_clone": {"$ref": "#/$defs/sha"},
    "source_sha256_after_clone": {"$ref": "#/$defs/sha"},
    "destination_sha256": {"$ref": "#/$defs/sha"},
    "source_file_identity": {"$ref": "#/$defs/identity"},
    "destination_file_identity": {"$ref": "#/$defs/identity"},
    "all_hashes_equal": {"const": true},
    "same_volume": {"const": true},
    "distinct_file_identity": {"const": true},
    "no_hardlink": {"const": true},
    "reparse_free": {"const": true},
    "completed_before_reopen_com": {"const": true},
    "status": {"const": "pass"}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "bytes": {"type": "integer", "minimum": 2048, "maximum": 1048576},
    "path": {"type": "string", "minLength": 3, "maxLength": 255, "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9._-]{0,63}/){1,5}[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "identity": {
      "type": "object", "additionalProperties": false,
      "required": ["volume_serial_number", "file_index", "link_count"],
      "properties": {
        "volume_serial_number": {"type": "string", "pattern": "^[0-9a-f]{8}$"},
        "file_index": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
        "link_count": {"const": 1}
      }
    }
  }
}
