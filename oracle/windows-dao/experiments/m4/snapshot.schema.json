{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jet3-rs:dao:m4:snapshot:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version", "document_type", "experiment_id", "sample_id",
    "phase_id", "phase_ordinal", "captured_while_database_open",
    "captured_at_utc", "dao_version", "empty_user_schema", "user_table_count"
  ],
  "properties": {
    "protocol_version": {"const": "1.0.0"},
    "document_type": {"const": "dao_m4_empty_schema_version_snapshot"},
    "experiment_id": {"const": "DAO-M4-HEADER-DISCRIMINATOR-001"},
    "sample_id": {"type": "string", "pattern": "^M4-V(?:20|30|40)-(?:U|E)-0[1-6]$"},
    "phase_id": {"enum": ["creator", "reopen"]},
    "phase_ordinal": {"enum": [1, 2]},
    "captured_while_database_open": {"const": true},
    "captured_at_utc": {"type": "string", "format": "date-time"},
    "dao_version": {"enum": ["2.0", "3.0", "4.0"]},
    "empty_user_schema": {"const": true},
    "user_table_count": {"const": 0}
  }
}
