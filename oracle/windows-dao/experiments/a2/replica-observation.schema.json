{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/oglassdev/jet3-rs/oracle/windows-dao/experiments/a2/replica-observation.schema.json",
  "title": "DAO A2 independent replica checkpoint observation",
  "type": "object", "additionalProperties": false,
  "required": ["protocol_version", "document_type", "experiment_id", "plan_sha256", "producer_commit", "repository_url", "campaign_id", "matrix_job", "environment_sha256", "provider_sha256", "replica", "role_binding", "d_growth_observation", "logical_checkpoint_read_bytes", "inserted_rows_total", "changed_hash_entries", "checkpoints"],
  "properties": {
    "protocol_version": {"const": "1.0.0"}, "document_type": {"const": "dao_a2_replica_observation"},
    "experiment_id": {"const": "DAO-A2-ALLOCATION-MAPS-001"}, "plan_sha256": {"$ref": "#/$defs/sha256"},
    "producer_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "repository_url": {"const": "https://github.com/oglassdev/jet3-rs.git"}, "campaign_id": {"$ref": "#/$defs/id"},
    "matrix_job": {"type": "object", "additionalProperties": false, "required": ["job_id", "replica_only", "shared_mutable_state"], "properties": {"job_id": {"$ref": "#/$defs/id"}, "replica_only": {"const": true}, "shared_mutable_state": {"const": false}}},
    "environment_sha256": {"$ref": "#/$defs/sha256"}, "provider_sha256": {"$ref": "#/$defs/sha256"},
    "replica": {"type": "integer", "minimum": 1, "maximum": 3}, "role_binding": {"$ref": "#/$defs/roleBinding"},
    "d_growth_observation": {"$ref": "#/$defs/dGrowthObservation"},
    "logical_checkpoint_read_bytes": {"type": "integer", "minimum": 0, "maximum": 2147483648},
    "inserted_rows_total": {"type": "integer", "minimum": 0, "maximum": 524288},
    "changed_hash_entries": {"type": "integer", "minimum": 0, "maximum": 65536},
    "checkpoints": {"type": "array", "minItems": 25, "maxItems": 25, "items": {"$ref": "#/$defs/checkpoint"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "roleBinding": {"type": "object", "additionalProperties": false, "required": ["D", "L", "P", "H"], "properties": {"D": {"$ref": "#/$defs/tableName"}, "L": {"$ref": "#/$defs/tableName"}, "P": {"$ref": "#/$defs/tableName"}, "H": {"$ref": "#/$defs/tableName"}}},
    "tableName": {"type": "string", "enum": ["A2TAB_A", "A2TAB_B", "A2TAB_C", "A2TAB_D"]},
    "dGrowthObservation": {"type": "object", "additionalProperties": false, "required": ["first_baseline_pages", "first_target_pages", "first_achieved_pages", "first_rows", "regrowth_baseline_pages", "regrowth_target_pages", "regrowth_achieved_pages", "regrowth_rows"], "properties": {"first_baseline_pages": {"type": "integer", "minimum": 1, "maximum": 65536}, "first_target_pages": {"type": "integer", "minimum": 129, "maximum": 65536}, "first_achieved_pages": {"type": "integer", "minimum": 129, "maximum": 65536}, "first_rows": {"type": "integer", "minimum": 1, "maximum": 524288}, "regrowth_baseline_pages": {"type": "integer", "minimum": 1, "maximum": 65536}, "regrowth_target_pages": {"type": "integer", "minimum": 129, "maximum": 65536}, "regrowth_achieved_pages": {"type": "integer", "minimum": 129, "maximum": 65536}, "regrowth_rows": {"type": "integer", "minimum": 1, "maximum": 524288}}},
    "rowCounts": {"type": "object", "additionalProperties": false, "required": ["D", "L", "P", "H"], "properties": {"D": {"type": "integer", "minimum": 0, "maximum": 524288}, "L": {"type": "integer", "minimum": 0, "maximum": 524288}, "P": {"type": "integer", "minimum": 0, "maximum": 524288}, "H": {"type": "integer", "minimum": 0, "maximum": 524288}}},
    "reread": {"type": "object", "additionalProperties": false, "required": ["role", "row_count", "rolling_sha256"], "properties": {"role": {"type": "string", "enum": ["D", "L", "P", "H"]}, "row_count": {"type": "integer", "minimum": 0, "maximum": 524288}, "rolling_sha256": {"$ref": "#/$defs/sha256"}}},
    "companion": {"type": "object", "additionalProperties": false, "required": ["present_after_close", "observed_size_bytes", "retained_for_physical_analysis"], "properties": {"present_after_close": {"const": false}, "observed_size_bytes": {"type": "integer", "minimum": 0, "maximum": 65536}, "retained_for_physical_analysis": {"const": false}}},
    "artifactRef": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "size_bytes"], "properties": {"path": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^page-indexes/replica-[0-9]{2}/[0-9]{2}-[A-Z0-9_]+\\.json$"}, "sha256": {"$ref": "#/$defs/sha256"}, "size_bytes": {"type": "integer", "minimum": 1, "maximum": 67108864}}},
    "checkpoint": {
      "type": "object", "additionalProperties": false,
      "required": ["checkpoint_id", "ordinal", "actual_file_pages", "actual_size_bytes", "target_baseline_pages", "target_threshold_pages", "target_overshoot_pages", "inserted_rows_total", "table_row_counts", "dao_reread", "quiescent", "post_close_companion", "page_index"],
      "properties": {
        "checkpoint_id": {"type": "string", "minLength": 2, "maxLength": 32, "pattern": "^[A-Z0-9_]+$"}, "ordinal": {"type": "integer", "minimum": 0, "maximum": 24},
        "actual_file_pages": {"type": "integer", "minimum": 1, "maximum": 65536}, "actual_size_bytes": {"type": "integer", "minimum": 2048, "maximum": 134217728},
        "target_baseline_pages": {"anyOf": [{"type": "null"}, {"type": "integer", "minimum": 1, "maximum": 65536}]},
        "target_threshold_pages": {"anyOf": [{"type": "null"}, {"type": "integer", "minimum": 1, "maximum": 65536}]},
        "target_overshoot_pages": {"anyOf": [{"type": "null"}, {"type": "integer", "minimum": 0, "maximum": 65535}]},
        "inserted_rows_total": {"type": "integer", "minimum": 0, "maximum": 524288}, "table_row_counts": {"$ref": "#/$defs/rowCounts"},
        "dao_reread": {"type": "array", "minItems": 0, "maxItems": 4, "uniqueItems": true, "items": {"$ref": "#/$defs/reread"}},
        "quiescent": {"const": true}, "post_close_companion": {"$ref": "#/$defs/companion"}, "page_index": {"$ref": "#/$defs/artifactRef"}
      }
    }
  }
}
