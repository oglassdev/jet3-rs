{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/oglassdev/jet3-rs/oracle/windows-dao/experiments/a2/plan.schema.json",
  "title": "DAO A2 allocation-map preregistration",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "document_type", "experiment_id", "preregistration", "execution_gate", "repository_binding", "environment_binding", "question", "replicas", "tables", "checkpoint_design", "page_capture", "record_candidate_procedure", "inline_boundary_procedure", "hypotheses", "analyzer_dry_run_contract", "predicate_registry", "decision_rules", "decisive_report_handling", "runtime_design", "artifacts", "bounds", "claims"],
  "properties": {
    "protocol_version": {"const": "1.0.0"},
    "document_type": {"const": "dao_a2_allocation_maps_plan"},
    "experiment_id": {"const": "DAO-A2-ALLOCATION-MAPS-001"},
    "preregistration": {"$ref": "#/$defs/preregistration"},
    "execution_gate": {"$ref": "#/$defs/executionGate"},
    "repository_binding": {"$ref": "#/$defs/repositoryBinding"},
    "environment_binding": {"$ref": "#/$defs/environmentBinding"},
    "question": {"type": "string", "minLength": 1, "maxLength": 1024},
    "replicas": {"$ref": "#/$defs/replicas"},
    "tables": {"type": "object"},
    "checkpoint_design": {"$ref": "#/$defs/checkpointDesign"},
    "page_capture": {"type": "object"},
    "record_candidate_procedure": {"type": "object"},
    "inline_boundary_procedure": {"type": "object"},
    "hypotheses": {"type": "object"},
    "analyzer_dry_run_contract": {"type": "object"},
    "predicate_registry": {"type": "object"},
    "decision_rules": {"type": "object"},
    "decisive_report_handling": {"type": "object"},
    "runtime_design": {"$ref": "#/$defs/runtimeDesign"},
    "artifacts": {"type": "object"},
    "bounds": {"$ref": "#/$defs/bounds"},
    "claims": {"$ref": "#/$defs/claims"}
  },
  "$defs": {
    "preregistration": {
      "type": "object", "additionalProperties": false,
      "required": ["provenance_entry", "recorded_utc_date", "acquisition_started", "acquisition_start_criterion", "origin_disclosure", "amendment_rule"],
      "properties": {
        "provenance_entry": {"const": "EXP-0040"},
        "recorded_utc_date": {"const": "2026-08-21"},
        "acquisition_started": {"const": false},
        "acquisition_start_criterion": {"type": "string", "minLength": 1, "maxLength": 512},
        "origin_disclosure": {"type": "object"},
        "amendment_rule": {"type": "string", "minLength": 1, "maxLength": 512}
      }
    },
    "executionGate": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "blocking_requirements"],
      "properties": {
        "status": {"const": "BLOCKED"},
        "blocking_requirements": {"type": "array", "minItems": 6, "maxItems": 6, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}}
      }
    },
    "repositoryBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["canonical_https_url", "producer_commit_required", "clean_worktree_required", "pushed_commit_required"],
      "properties": {
        "canonical_https_url": {"const": "https://github.com/oglassdev/jet3-rs.git"},
        "producer_commit_required": {"const": true},
        "clean_worktree_required": {"const": true},
        "pushed_commit_required": {"const": true}
      }
    },
    "environmentBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["operating_system", "process_architecture", "powershell_major", "python_version", "dao_prog_id", "provider_identity_and_binary_hash_required"],
      "properties": {
        "operating_system": {"const": "Windows"},
        "process_architecture": {"const": "x86"},
        "powershell_major": {"const": 5},
        "python_version": {"const": "3.13.x"},
        "dao_prog_id": {"const": "DAO.DBEngine.36"},
        "provider_identity_and_binary_hash_required": {"const": true}
      }
    },
    "replicas": {
      "type": "object", "additionalProperties": false,
      "required": ["count", "derivation", "holdout", "acquisition_independence", "fan_in_rule"],
      "properties": {
        "count": {"const": 3},
        "derivation": {"const": [1, 2]},
        "holdout": {"const": 3},
        "acquisition_independence": {"type": "string", "minLength": 1, "maxLength": 1024},
        "fan_in_rule": {"type": "string", "minLength": 1, "maxLength": 1024}
      }
    },
    "checkpointDesign": {
      "type": "object",
      "required": ["count", "adaptive_checkpoints_allowed", "all_checkpoints_closed_and_quiescent", "d_growth_rule", "d_regrowth_rule", "relative_growth_rule", "absolute_growth_rule", "checkpoint_ids", "idle_pairs", "transition_coverage", "schedule_minimization_basis"],
      "properties": {
        "count": {"const": 25},
        "adaptive_checkpoints_allowed": {"const": false},
        "all_checkpoints_closed_and_quiescent": {"const": true},
        "d_growth_rule": {"type": "string", "minLength": 1},
        "d_regrowth_rule": {"type": "string", "minLength": 1},
        "relative_growth_rule": {"type": "string", "minLength": 1},
        "absolute_growth_rule": {"type": "string", "minLength": 1},
        "checkpoint_ids": {"const": ["E0", "E0R", "D_GROW_0128", "D_DROP", "D_RECREATE_EMPTY", "D_REGROW_0128", "L_REL_0064", "L_REL_0512", "L_REL_0768", "L_REL_0896", "L_REL_0904", "L_REL_1024", "L_REL_1088", "L_REL_1280", "L_DELETE_ALL", "L_REINSERT_SAME", "L_IDLE_REOPEN", "P_ABS_04096", "P_ABS_08192", "P_ABS_12288", "P_ABS_16480", "H_REL_0064", "H_REL_0896", "H_REL_0904", "H_IDLE_REOPEN"]},
        "idle_pairs": {"type": "array"},
        "transition_coverage": {"type": "object"},
        "schedule_minimization_basis": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "runtimeDesign": {
      "type": "object", "additionalProperties": false,
      "required": ["matrix_jobs", "fan_in_jobs", "hosted_wall_clock_target_seconds", "slow_runner_basis", "headroom", "estimated_complete_wall_clock_seconds"],
      "properties": {
        "matrix_jobs": {"const": 3}, "fan_in_jobs": {"const": 1},
        "hosted_wall_clock_target_seconds": {"const": 1800},
        "slow_runner_basis": {"type": "string", "minLength": 1},
        "headroom": {"type": "string", "minLength": 1},
        "estimated_complete_wall_clock_seconds": {"const": 1740}
      }
    },
    "bounds": {
      "type": "object", "additionalProperties": false,
      "required": ["page_size", "replicas", "max_checkpoints_per_replica", "planned_checkpoints_per_replica", "max_final_pages_per_replica", "max_logical_checkpoint_read_bytes_per_replica", "max_inserted_rows_per_replica", "max_changed_hash_entries_per_replica", "max_record_candidates", "max_candidate_models", "max_analysis_work_units", "max_unique_page_blobs", "max_retained_page_store_bytes", "max_bundle_bytes", "max_json_bytes", "worker_timeout_seconds_per_replica", "fan_in_timeout_seconds", "campaign_timeout_seconds", "max_child_log_bytes", "max_companion_bytes_per_checkpoint"],
      "properties": {
        "page_size": {"const": 2048}, "replicas": {"const": 3},
        "max_checkpoints_per_replica": {"const": 25}, "planned_checkpoints_per_replica": {"const": 25},
        "max_final_pages_per_replica": {"const": 65536},
        "max_logical_checkpoint_read_bytes_per_replica": {"const": 2147483648},
        "max_inserted_rows_per_replica": {"const": 524288},
        "max_changed_hash_entries_per_replica": {"const": 65536},
        "max_record_candidates": {"const": 16777216}, "max_candidate_models": {"const": 1000000},
        "max_analysis_work_units": {"const": 500000000}, "max_unique_page_blobs": {"const": 65536},
        "max_retained_page_store_bytes": {"const": 536870912}, "max_bundle_bytes": {"const": 805306368},
        "max_json_bytes": {"const": 67108864}, "worker_timeout_seconds_per_replica": {"const": 1800},
        "fan_in_timeout_seconds": {"const": 900}, "campaign_timeout_seconds": {"const": 2700},
        "max_child_log_bytes": {"const": 1048576}, "max_companion_bytes_per_checkpoint": {"const": 65536}
      }
    },
    "claims": {
      "type": "object", "additionalProperties": false,
      "required": ["descriptive_provider_observation_only", "a1_exploratory_input_is_a2_evidence", "synthetic_dry_run_is_a2_evidence", "general_tdef_catalog_row_index_or_lval_layout", "unobserved_slot_or_base_behavior", "compaction_encryption_or_version_behavior", "rust_correctness", "dao_compatibility_or_support"],
      "properties": {
        "descriptive_provider_observation_only": {"const": true},
        "a1_exploratory_input_is_a2_evidence": {"const": false},
        "synthetic_dry_run_is_a2_evidence": {"const": false},
        "general_tdef_catalog_row_index_or_lval_layout": {"const": false},
        "unobserved_slot_or_base_behavior": {"const": false},
        "compaction_encryption_or_version_behavior": {"const": false},
        "rust_correctness": {"const": false},
        "dao_compatibility_or_support": {"const": false}
      }
    }
  }
}
