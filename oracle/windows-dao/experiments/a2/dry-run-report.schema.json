{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/oglassdev/jet3-rs/oracle/windows-dao/experiments/a2/dry-run-report.schema.json",
  "title": "DAO A2 pre-acquisition analyzer dry-run report",
  "type": "object", "additionalProperties": false,
  "required": ["protocol_version", "document_type", "experiment_id", "plan_sha256", "analyzer_commit", "recorded_utc", "source_kind", "source_identity", "checkpoint_schedule_source", "input_page_blob_count", "holdout_opened", "parameter_coverage", "predicted_terminal_states", "terminal_predicate_ids", "result", "assertions", "scientific_evidence", "acquisition_authorized", "capability_advancement_authorized"],
  "properties": {
    "protocol_version": {"const": "1.0.0"}, "document_type": {"const": "dao_a2_analyzer_dry_run_report"},
    "experiment_id": {"const": "DAO-A2-ALLOCATION-MAPS-001"}, "plan_sha256": {"$ref": "#/$defs/sha256"},
    "analyzer_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "recorded_utc": {"type": "string", "format": "date-time", "maxLength": 64},
    "source_kind": {"type": "string", "enum": ["retained_a1_run12_exploratory", "a2_schedule_synthetic"]},
    "source_identity": {"type": "object", "additionalProperties": false, "required": ["manifest_or_fixture_sha256", "generator_sha256"], "properties": {"manifest_or_fixture_sha256": {"$ref": "#/$defs/sha256"}, "generator_sha256": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]}}},
    "checkpoint_schedule_source": {"type": "string", "enum": ["explicit_a1_legacy_projection", "hash_pinned_a2_plan_checkpoint_design"]},
    "input_page_blob_count": {"type": "integer", "minimum": 0, "maximum": 55},
    "holdout_opened": {"const": false},
    "parameter_coverage": {
      "type": "object", "additionalProperties": false,
      "required": ["conversion_ordinals", "conversion_never", "slot_activation_counts", "bit_polarities", "anchor_fill_states", "run12_calibration"],
      "properties": {
        "conversion_ordinals": {"type": "array", "maxItems": 70, "uniqueItems": true, "items": {"type": "integer", "minimum": 1, "maximum": 70}},
        "conversion_never": {"type": "boolean"},
        "slot_activation_counts": {"type": "array", "maxItems": 3, "uniqueItems": true, "items": {"type": "integer", "minimum": 0, "maximum": 2}},
        "bit_polarities": {"type": "array", "maxItems": 2, "uniqueItems": true, "items": {"type": "string", "enum": ["set_means_in_use", "set_means_not_in_use"]}},
        "anchor_fill_states": {"type": "array", "maxItems": 3, "uniqueItems": true, "items": {"type": "string", "enum": ["empty", "partial", "full"]}},
        "run12_calibration": {"anyOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["source_conversion_ordinal", "conversion_checkpoint_id", "a2_conversion_ordinal", "active_slot_count", "bit_polarity", "delete_page_delta", "scientific_evidence"], "properties": {"source_conversion_ordinal": {"const": 40}, "conversion_checkpoint_id": {"const": "P_ABS_16480"}, "a2_conversion_ordinal": {"const": 20}, "active_slot_count": {"const": 2}, "bit_polarity": {"const": "set_means_not_in_use"}, "delete_page_delta": {"const": 1}, "scientific_evidence": {"const": false}}}]}
      }
    },
    "predicted_terminal_states": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z0-9_]+$"}},
    "terminal_predicate_ids": {"type": "array", "maxItems": 29, "uniqueItems": true, "items": {"$ref": "#/$defs/predicateId"}},
    "result": {"type": "string", "enum": ["pass", "fail"]},
    "assertions": {"type": "array", "minItems": 1, "maxItems": 40, "uniqueItems": true, "items": {"type": "string", "enum": ["legacy_relative_d_is_abac", "legacy_churn_precondition_identifier_exercised", "retained_input_blob_bound_respected", "holdout_never_opened", "no_a2_scientific_outcome_emitted_for_a1_input", "bounded_record_enumeration_exercised", "candidate_page_union_exercised", "record_source_independent_of_change_envelope", "header_offsets_excluded_from_records_and_pointers", "schedule_and_worker_arithmetic_generated_from_plan", "no_a1_hand_typed_counts_imported", "all_analyzer_equalities_generator_producible", "d_record_set_relation_arithmetically_possible", "d_drop_does_not_assume_truncation", "growth_only_transition_arithmetically_possible", "churn_only_transition_arithmetically_possible", "conversion_ordinal_parameter_complete", "slot_activation_parameter_complete", "bit_polarity_parameter_complete", "polarity_selected_by_d_and_h_transitions", "conversion_derived_within_full_window", "pointer_validity_only_at_preregistered_checkpoints", "inline_boundaries_from_fixed_enumeration", "inline_boundary_anchor_fill_independent", "base_candidates_discriminated", "decisive_synthetic_model_recovered", "every_abort_has_predicate_id", "every_abort_reached_by_single_perturbation", "distinct_page_and_record_cardinality_identifiers_exercised", "all_required_terminal_cases_exercised", "run12_calibration_case_non_evidential"]}},
    "scientific_evidence": {"const": false}, "acquisition_authorized": {"const": false}, "capability_advancement_authorized": {"const": false}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "predicateId": {"type": "string", "enum": ["A2-IDLE-EQUALITY", "A2-D-SET-RELATION", "A2-PAGE-NONE", "A2-PAGE-MULTIPLE", "A2-GLOBAL-RECORD-NONE", "A2-GLOBAL-RECORD-MULTIPLE", "A2-TDEF-RECORD-NONE", "A2-TDEF-RECORD-MULTIPLE", "A2-HEADER-EXCLUSION", "A2-POLARITY-NONE", "A2-POLARITY-MULTIPLE", "A2-GROWTH-POINTER-NONE", "A2-CHURN-PRECONDITION", "A2-CHURN-POINTER-NONE", "A2-POINTER-MULTIPLE", "A2-POINTER-VALIDITY", "A2-CONVERSION-NONE", "A2-CONVERSION-MULTIPLE", "A2-SLOT-ACTIVATION", "A2-INLINE-BOUNDARY-NONE", "A2-INLINE-BOUNDARY-MULTIPLE", "A2-INLINE-SUFFIX", "A2-BASE-DISCRIMINATION", "A2-BASE-NONE", "A2-BASE-MULTIPLE", "A2-REPLICA-DISAGREEMENT", "A2-SNAPSHOT-RECONSTRUCTION", "A2-RESOURCE-BOUND", "A2-HOLDOUT-PREDICTION"]}
  }
}
