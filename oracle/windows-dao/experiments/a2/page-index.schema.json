{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/oglassdev/jet3-rs/oracle/windows-dao/experiments/a2/page-index.schema.json",
  "title": "DAO A2 ordered checkpoint page index",
  "type": "object", "additionalProperties": false,
  "required": ["protocol_version", "document_type", "experiment_id", "plan_sha256", "producer_commit", "campaign_id", "environment_sha256", "provider_sha256", "replica", "checkpoint_id", "ordinal", "predecessor_checkpoint_id", "page_count", "file_size_bytes", "database_sha256", "ordered_page_sha256", "changed_page_indices"],
  "properties": {
    "protocol_version": {"const": "1.0.0"}, "document_type": {"const": "dao_a2_page_index"},
    "experiment_id": {"const": "DAO-A2-ALLOCATION-MAPS-001"}, "plan_sha256": {"$ref": "#/$defs/sha256"},
    "producer_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "campaign_id": {"$ref": "#/$defs/id"},
    "environment_sha256": {"$ref": "#/$defs/sha256"}, "provider_sha256": {"$ref": "#/$defs/sha256"},
    "replica": {"type": "integer", "minimum": 1, "maximum": 3},
    "checkpoint_id": {"type": "string", "minLength": 2, "maxLength": 32, "pattern": "^[A-Z0-9_]+$"},
    "ordinal": {"type": "integer", "minimum": 0, "maximum": 23},
    "predecessor_checkpoint_id": {"anyOf": [{"type": "null"}, {"type": "string", "minLength": 2, "maxLength": 32, "pattern": "^[A-Z0-9_]+$"}]},
    "page_count": {"type": "integer", "minimum": 1, "maximum": 65536},
    "file_size_bytes": {"type": "integer", "minimum": 2048, "maximum": 134217728},
    "database_sha256": {"$ref": "#/$defs/sha256"},
    "ordered_page_sha256": {"type": "array", "minItems": 1, "maxItems": 65536, "items": {"$ref": "#/$defs/sha256"}},
    "changed_page_indices": {"type": "array", "maxItems": 65536, "uniqueItems": true, "items": {"type": "integer", "minimum": 0, "maximum": 65535}}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"}}
}
