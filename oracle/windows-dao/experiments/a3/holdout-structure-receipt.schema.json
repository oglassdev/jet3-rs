{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/oglassdev/jet3-rs/oracle/windows-dao/experiments/a3/holdout-structure-receipt.schema.json",
  "title": "DAO A3 post-freeze holdout structural-validation receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "document_type",
    "experiment_id",
    "plan_sha256",
    "revision_plan_sha256",
    "producer_commit",
    "campaign_id",
    "derivation_candidate_set_sha256",
    "replica",
    "replica_artifact_manifest_sha256",
    "validated_after_candidate_freeze",
    "page_bytes_exposed_to_analyzer",
    "result"
  ],
  "properties": {
    "protocol_version": {
      "const": "1.0.0"
    },
    "document_type": {
      "const": "dao_a3_holdout_structure_receipt"
    },
    "experiment_id": {
      "const": "DAO-A3-ALLOCATION-MAPS-001"
    },
    "plan_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "revision_plan_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "producer_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "campaign_id": {
      "$ref": "#/$defs/id"
    },
    "derivation_candidate_set_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "replica": {
      "const": 3
    },
    "replica_artifact_manifest_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "validated_after_candidate_freeze": {
      "const": true
    },
    "page_bytes_exposed_to_analyzer": {
      "const": false
    },
    "result": {
      "const": "pass"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    }
  }
}
