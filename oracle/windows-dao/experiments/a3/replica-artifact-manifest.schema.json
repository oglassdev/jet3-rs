{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/oglassdev/jet3-rs/oracle/windows-dao/experiments/a3/replica-artifact-manifest.schema.json",
  "title": "DAO A3 independent matrix replica artifact",
  "type": "object", "additionalProperties": false,
  "required": ["protocol_version", "document_type", "experiment_id", "plan_sha256", "revision_plan_sha256", "producer_commit", "campaign_id", "matrix_job_id", "replica", "environment_sha256", "provider_sha256", "checkpoint_count", "inventory_closed", "hashes_verified", "paths_closed", "files"],
  "properties": {
    "protocol_version": {"const": "1.0.0"}, "document_type": {"const": "dao_a3_replica_artifact_manifest"},
    "experiment_id": {"const": "DAO-A3-ALLOCATION-MAPS-001"}, "plan_sha256": {"$ref": "#/$defs/sha256"}, "revision_plan_sha256": {"$ref": "#/$defs/sha256"},
    "producer_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "campaign_id": {"$ref": "#/$defs/id"}, "matrix_job_id": {"$ref": "#/$defs/id"},
    "replica": {"type": "integer", "minimum": 1, "maximum": 3}, "environment_sha256": {"$ref": "#/$defs/sha256"}, "provider_sha256": {"$ref": "#/$defs/sha256"},
    "checkpoint_count": {"const": 25}, "inventory_closed": {"const": true}, "hashes_verified": {"const": true}, "paths_closed": {"const": true},
    "files": {"type": "array", "minItems": 27, "maxItems": 65600, "uniqueItems": true, "items": {"$ref": "#/$defs/file"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "file": {"type": "object", "additionalProperties": false, "required": ["path", "role", "sha256", "size_bytes", "media_type"], "properties": {"path": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"}, "role": {"type": "string", "enum": ["environment", "replica_observation", "page_index", "page_blob", "acquisition_log"]}, "sha256": {"$ref": "#/$defs/sha256"}, "size_bytes": {"type": "integer", "minimum": 1, "maximum": 67108864}, "media_type": {"type": "string", "enum": ["application/json", "application/octet-stream", "text/plain"]}}}
  }
}
