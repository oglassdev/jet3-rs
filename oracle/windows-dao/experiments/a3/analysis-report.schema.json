{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/oglassdev/jet3-rs/oracle/windows-dao/experiments/a3/analysis-report.schema.json",
  "title": "DAO A3 layered allocation-map analysis report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "document_type",
    "experiment_id",
    "plan_sha256",
    "revision_plan_sha256",
    "campaign_id",
    "producer_commit",
    "derivation_replicas",
    "holdout_replica",
    "input_checkpoint_count",
    "qualified_page_counts",
    "qualified_pages",
    "record_candidates_examined",
    "candidate_models_examined",
    "derivation_survivor_counts",
    "derivation_candidate_set_sha256",
    "polarity_cross_check",
    "analysis_work_units",
    "holdout_structurally_validated_after_freeze",
    "holdout_opened_after_freeze",
    "holdout_evaluated",
    "predicate_results",
    "terminal_predicate_ids",
    "scientific_outcome",
    "no_outcome_reasons",
    "submodels",
    "claims"
  ],
  "properties": {
    "protocol_version": {
      "const": "1.0.0"
    },
    "document_type": {
      "const": "dao_a3_analysis_report"
    },
    "experiment_id": {
      "const": "DAO-A3-ALLOCATION-MAPS-001"
    },
    "plan_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "revision_plan_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "campaign_id": {
      "$ref": "#/$defs/id"
    },
    "producer_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "derivation_replicas": {
      "const": [
        1,
        2
      ]
    },
    "holdout_replica": {
      "const": 3
    },
    "input_checkpoint_count": {
      "const": 75
    },
    "qualified_page_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "global_map",
        "tdef"
      ],
      "properties": {
        "global_map": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16
        },
        "tdef": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16
        }
      }
    },
    "qualified_pages": {
      "type": "object",
      "additionalProperties": false,
      "required": ["global_map", "tdef"],
      "properties": {
        "global_map": {"$ref": "#/$defs/pages"},
        "tdef": {"$ref": "#/$defs/pages"}
      }
    },
    "record_candidates_examined": {
      "type": "integer",
      "minimum": 0,
      "maximum": 67141632
    },
    "candidate_models_examined": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "derivation_survivor_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "global_map_record",
        "global_map_conversion_inline",
        "global_map_extended_base",
        "tdef_pointer_pair"
      ],
      "properties": {
        "global_map_record": {
          "$ref": "#/$defs/count"
        },
        "global_map_conversion_inline": {
          "$ref": "#/$defs/count"
        },
        "global_map_extended_base": {
          "$ref": "#/$defs/count"
        },
        "tdef_pointer_pair": {
          "$ref": "#/$defs/count"
        }
      }
    },
    "derivation_candidate_set_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "polarity_cross_check": {
      "$ref": "#/$defs/crossCheck"
    },
    "analysis_work_units": {
      "type": "integer",
      "minimum": 0,
      "maximum": 600000000
    },
    "holdout_structurally_validated_after_freeze": {
      "const": true
    },
    "holdout_opened_after_freeze": {
      "type": "boolean"
    },
    "holdout_evaluated": {
      "type": "boolean"
    },
    "predicate_results": {
      "type": "array",
      "minItems": 34,
      "maxItems": 34,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "predicate_id",
          "status",
          "layer"
        ],
        "properties": {
          "predicate_id": {
            "$ref": "#/$defs/predicateId"
          },
          "status": {
            "type": "string",
            "enum": [
              "pass",
              "fail",
              "not_applicable"
            ]
          },
          "layer": {
            "$ref": "#/$defs/layer"
          }
        }
      }
    },
    "terminal_predicate_ids": {
      "type": "array",
      "maxItems": 34,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/predicateId"
      }
    },
    "scientific_outcome": {
      "type": "string",
      "enum": [
        "one_or_more_submodels_predict_holdout",
        "no_submodel_predicts_holdout"
      ]
    },
    "no_outcome_reasons": {
      "type": "array",
      "maxItems": 34,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/reason"
      }
    },
    "submodels": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "global_map",
        "tdef"
      ],
      "properties": {
        "global_map": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "record",
            "conversion_inline",
            "extended_base"
          ],
          "properties": {
            "record": {
              "$ref": "#/$defs/globalRecordLayer"
            },
            "conversion_inline": {
              "$ref": "#/$defs/conversionLayer"
            },
            "extended_base": {
              "$ref": "#/$defs/baseLayer"
            }
          }
        },
        "tdef": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pointer_pair"
          ],
          "properties": {
            "pointer_pair": {
              "$ref": "#/$defs/tdefLayer"
            }
          }
        }
      }
    },
    "claims": {
      "$ref": "#/$defs/claims"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "pages": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 0, "maximum": 65535}
    },
    "leg": {
      "type": "object",
      "additionalProperties": false,
      "required": ["left_checkpoint_id", "right_checkpoint_id"],
      "properties": {
        "left_checkpoint_id": {"type": "string", "pattern": "^[A-Z0-9_]+$"},
        "right_checkpoint_id": {"type": "string", "pattern": "^[A-Z0-9_]+$"}
      }
    },
    "nullableLeg": {
      "anyOf": [{"type": "null"}, {"$ref": "#/$defs/leg"}]
    },
    "crossCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evaluated_legs", "representation_change_stop", "first_violating_leg", "first_violating_page"],
      "properties": {
        "evaluated_legs": {"type": "array", "maxItems": 15, "items": {"$ref": "#/$defs/leg"}},
        "representation_change_stop": {"$ref": "#/$defs/nullableLeg"},
        "first_violating_leg": {"$ref": "#/$defs/nullableLeg"},
        "first_violating_page": {"anyOf": [{"type": "null"}, {"type": "integer", "minimum": 0, "maximum": 65535}]}
      }
    },
    "layer": {
      "type": "string",
      "enum": [
        "campaign",
        "global_map.record",
        "global_map.conversion_inline",
        "global_map.extended_base",
        "tdef.pointer_pair",
        "applicable_layer"
      ]
    },
    "reason": {
      "type": "string",
      "enum": [
        "idle_volatility",
        "global_set_relation_not_satisfied",
        "no_physical_page_satisfies_global_transition_predicates",
        "multiple_physical_pages_satisfy_global_transition_predicates",
        "no_global_record_candidate",
        "multiple_global_record_boundaries_survive",
        "global_record_end_not_resolved",
        "no_physical_page_satisfies_tdef_transition_predicates",
        "multiple_physical_pages_satisfy_tdef_transition_predicates",
        "no_tdef_record_candidate",
        "multiple_tdef_record_boundaries_survive",
        "structural_field_exclusion_failure",
        "no_unique_bit_polarity",
        "multiple_bit_polarities_survive",
        "growth_polarity_disagreement",
        "no_growth_only_pointer_candidate",
        "legacy_churn_precondition_not_met",
        "no_delete_reinsert_only_pointer_candidate",
        "multiple_pointer_models_survive",
        "pointer_validity_failure",
        "missing_inline_to_indirect_conversion",
        "multiple_inline_to_indirect_conversions",
        "no_active_slot_at_conversion",
        "final_slot_activation_not_two",
        "no_inline_boundary_candidate",
        "multiple_inline_boundary_candidates",
        "unexplained_nonzero_inline_suffix",
        "insufficient_base_discrimination",
        "no_extended_base_candidate",
        "multiple_extended_base_candidates",
        "replica_disagreement",
        "unreconstructable_snapshot",
        "resource_bound_breach",
        "holdout_prediction_failure"
      ]
    },
    "predicateId": {
      "type": "string",
      "enum": [
        "A3-IDLE-EQUALITY",
        "A3-D-SET-RELATION",
        "A3-GLOBAL-PAGE-NONE",
        "A3-GLOBAL-PAGE-MULTIPLE",
        "A3-GLOBAL-RECORD-NONE",
        "A3-GLOBAL-RECORD-MULTIPLE",
        "A3-GLOBAL-RECORD-END",
        "A3-TDEF-PAGE-NONE",
        "A3-TDEF-PAGE-MULTIPLE",
        "A3-TDEF-RECORD-NONE",
        "A3-TDEF-RECORD-MULTIPLE",
        "A3-STRUCTURAL-EXCLUSION",
        "A3-POLARITY-NONE",
        "A3-POLARITY-MULTIPLE",
        "A3-POLARITY-CROSSCHECK",
        "A3-GROWTH-POINTER-NONE",
        "A3-CHURN-PRECONDITION",
        "A3-CHURN-POINTER-NONE",
        "A3-POINTER-MULTIPLE",
        "A3-POINTER-VALIDITY",
        "A3-CONVERSION-NONE",
        "A3-CONVERSION-MULTIPLE",
        "A3-SLOT-ACTIVATION",
        "A3-SLOT-FINAL",
        "A3-INLINE-BOUNDARY-NONE",
        "A3-INLINE-BOUNDARY-MULTIPLE",
        "A3-INLINE-SUFFIX",
        "A3-BASE-DISCRIMINATION",
        "A3-BASE-NONE",
        "A3-BASE-MULTIPLE",
        "A3-REPLICA-DISAGREEMENT",
        "A3-SNAPSHOT-RECONSTRUCTION",
        "A3-RESOURCE-BOUND",
        "A3-HOLDOUT-PREDICTION"
      ]
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "page",
        "start",
        "end"
      ],
      "properties": {
        "page": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "start": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2047
        },
        "end": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2048
        }
      }
    },
    "layerStatus": {
      "type": "string",
      "enum": [
        "decisive_predicts_holdout",
        "no_outcome",
        "not_applicable"
      ]
    },
    "globalRecordModel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record",
        "bit_polarity",
        "zero_suffix_slack_bytes"
      ],
      "properties": {
        "record": {
          "$ref": "#/$defs/record"
        },
        "bit_polarity": {
          "type": "string",
          "enum": [
            "set_means_in_use",
            "set_means_not_in_use"
          ]
        },
        "zero_suffix_slack_bytes": {
          "type": "integer",
          "minimum": 16,
          "maximum": 2048
        }
      }
    },
    "conversionModel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conversion_checkpoint_id",
        "conversion_ordinal",
        "indirect_tag",
        "active_slot_count_at_conversion",
        "active_slot_count_at_h_rel_0904",
        "inline_boundary",
        "slot_reference_pages"
      ],
      "properties": {
        "conversion_checkpoint_id": {
          "type": "string",
          "minLength": 2,
          "maxLength": 32,
          "pattern": "^[A-Z0-9_]+$"
        },
        "conversion_ordinal": {
          "type": "integer",
          "minimum": 1,
          "maximum": 24
        },
        "indirect_tag": {
          "const": 1
        },
        "active_slot_count_at_conversion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        "active_slot_count_at_h_rel_0904": {
          "const": 2
        },
        "inline_boundary": {
          "type": "integer",
          "minimum": 5,
          "maximum": 2048
        },
        "slot_reference_pages": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535
          }
        }
      }
    },
    "baseModel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "extended_base_formula"
      ],
      "properties": {
        "extended_base_formula": {
          "type": "string",
          "enum": [
            "slot_relative_expected_0_16352",
            "referenced_page_relative",
            "slot_relative_off_by_minus_one",
            "slot_relative_off_by_plus_one",
            "referenced_page_relative_off_by_minus_one",
            "referenced_page_relative_off_by_plus_one"
          ]
        }
      }
    },
    "tdefModel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record",
        "pointer_layout",
        "growth_pointer_offset",
        "delete_reinsert_pointer_offset"
      ],
      "properties": {
        "record": {
          "$ref": "#/$defs/record"
        },
        "pointer_layout": {
          "type": "string",
          "enum": [
            "u24le_page_then_u8_slot",
            "u8_slot_then_u24le_page"
          ]
        },
        "growth_pointer_offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2044
        },
        "delete_reinsert_pointer_offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2044
        }
      }
    },
    "globalRecordLayer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "derivation_survivor_count",
        "holdout_evaluated",
        "no_outcome_reasons",
        "terminal_predicate_id",
        "model"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/layerStatus"
        },
        "derivation_survivor_count": {
          "$ref": "#/$defs/count"
        },
        "holdout_evaluated": {
          "type": "boolean"
        },
        "no_outcome_reasons": {
          "type": "array",
          "maxItems": 34,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/reason"
          }
        },
        "terminal_predicate_id": {
          "anyOf": [
            {"type": "null"},
            {"$ref": "#/$defs/predicateId"}
          ]
        },
        "model": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/globalRecordModel"
            }
          ]
        }
      }
    },
    "conversionLayer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "derivation_survivor_count",
        "holdout_evaluated",
        "no_outcome_reasons",
        "terminal_predicate_id",
        "model"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/layerStatus"
        },
        "derivation_survivor_count": {
          "$ref": "#/$defs/count"
        },
        "holdout_evaluated": {
          "type": "boolean"
        },
        "no_outcome_reasons": {
          "type": "array",
          "maxItems": 34,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/reason"
          }
        },
        "terminal_predicate_id": {
          "anyOf": [
            {"type": "null"},
            {"$ref": "#/$defs/predicateId"}
          ]
        },
        "model": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/conversionModel"
            }
          ]
        }
      }
    },
    "baseLayer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "derivation_survivor_count",
        "holdout_evaluated",
        "no_outcome_reasons",
        "terminal_predicate_id",
        "model"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/layerStatus"
        },
        "derivation_survivor_count": {
          "$ref": "#/$defs/count"
        },
        "holdout_evaluated": {
          "type": "boolean"
        },
        "no_outcome_reasons": {
          "type": "array",
          "maxItems": 34,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/reason"
          }
        },
        "terminal_predicate_id": {
          "anyOf": [
            {"type": "null"},
            {"$ref": "#/$defs/predicateId"}
          ]
        },
        "model": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/baseModel"
            }
          ]
        }
      }
    },
    "tdefLayer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "derivation_survivor_count",
        "holdout_evaluated",
        "no_outcome_reasons",
        "terminal_predicate_id",
        "model"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/layerStatus"
        },
        "derivation_survivor_count": {
          "$ref": "#/$defs/count"
        },
        "holdout_evaluated": {
          "type": "boolean"
        },
        "no_outcome_reasons": {
          "type": "array",
          "maxItems": 34,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/reason"
          }
        },
        "terminal_predicate_id": {
          "anyOf": [
            {"type": "null"},
            {"$ref": "#/$defs/predicateId"}
          ]
        },
        "model": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/tdefModel"
            }
          ]
        }
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "descriptive_provider_observation_only",
        "general_tdef_catalog_row_index_or_lval_layout",
        "unobserved_slot_or_base_behavior",
        "compaction_encryption_or_version_behavior",
        "rust_correctness",
        "dao_compatibility_or_support"
      ],
      "properties": {
        "descriptive_provider_observation_only": {
          "const": true
        },
        "general_tdef_catalog_row_index_or_lval_layout": {
          "const": false
        },
        "unobserved_slot_or_base_behavior": {
          "const": false
        },
        "compaction_encryption_or_version_behavior": {
          "const": false
        },
        "rust_correctness": {
          "const": false
        },
        "dao_compatibility_or_support": {
          "const": false
        }
      }
    }
  }
}
