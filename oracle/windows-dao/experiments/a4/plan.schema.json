    "decisiveReportHandling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "analysis_report_artifact",
        "bundle_status",
        "campaign_behavior",
        "independent_validation_rule"
      ],
      "properties": {
        "analysis_report_artifact": {
