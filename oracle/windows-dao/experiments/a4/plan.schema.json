        "max_inserted_rows_per_replica": {
          "const": 200000
        },
        "max_changed_hash_entries_per_replica": {
          "const": 65536
        },
        "max_locator_pairs_per_tdef_page": {
          "const": 4167722
        },
        "max_locator_pairs": {
          "const": 66683552
        },
        "max_candidate_models": {
          "const": 4096
        },
        "max_canonical_candidate_bytes": {
          "const": 4096
        },
        "max_canonical_candidates_array_bytes": {
          "const": 16781313
        },
        "max_h4_occurrence_identities": {
          "const": 3700
        },
        "max_h4_occurrence_evidence_bytes": {
          "const": 1048576
        },
        "max_analysis_work_units": {
          "const": 800000000
        },
        "max_unique_page_blobs": {
          "const": 65536
        },
        "max_retained_page_store_bytes": {
          "const": 134217728
        },
        "max_bundle_bytes": {
          "const": 805306368
        },
        "max_json_bytes": {
          "const": 67108864
        },
        "worker_timeout_seconds_per_replica": {
          "const": 1700
        },
        "fan_in_timeout_seconds": {
          "const": 900
        },
        "campaign_timeout_seconds": {
          "const": 2700
        },
        "max_child_log_bytes": {
          "const": 1048576
        },
        "max_companion_bytes_per_checkpoint": {
          "const": 65536
        },
        "max_qualified_pages_per_submodel": {
          "const": 16
        },
        "max_h4_value_equivalent_tuples": {
          "const": 165888
        }
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "descriptive_provider_observation_only",
        "a3_calibration_input_is_a4_evidence",
        "exp_0051_bundle_is_a4_evidence",
        "synthetic_dry_run_is_a4_evidence",
        "general_tdef_catalog_row_index_or_lval_layout",
        "unobserved_slot_or_base_behavior",
        "compaction_encryption_or_version_behavior",
        "rust_correctness",
        "dao_compatibility_or_support",
        "support_matrix_advancement",
