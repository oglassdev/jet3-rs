            "not_applicable"
          ]
        },
        "derivation_survivor_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        },
        "terminal_predicate_id": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^A4-[A-Z0-9-]+$",
              "minLength": 4,
              "maxLength": 64
            }
          ]
        },
        "candidates": {
          "type": "array",
          "minItems": 0,
          "maxItems": 4096,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/h3Candidate"
          }
        },
        "canonical_candidates_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "h4RootResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "derivation_survivor_count",
        "terminal_predicate_id",
        "candidates",
        "canonical_candidates_sha256"
      ],
      "properties": {
        "status": {
          "enum": [
            "model",
            "no_outcome",
            "not_applicable"
          ]
        },
        "derivation_survivor_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        },
        "terminal_predicate_id": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^A4-[A-Z0-9-]+$",
              "minLength": 4,
              "maxLength": 64
            }
          ]
        },
        "candidates": {
          "type": "array",
          "minItems": 0,
          "maxItems": 4096,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/h4RootCandidate"
          }
        },
        "canonical_candidates_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "h4FieldResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "derivation_survivor_count",
        "terminal_predicate_id",
        "candidates",
        "canonical_candidates_sha256"
      ],
      "properties": {
        "status": {
          "enum": [
            "model",
            "no_outcome",
            "not_applicable"
          ]
        },
        "derivation_survivor_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        },
        "terminal_predicate_id": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^A4-[A-Z0-9-]+$",
              "minLength": 4,
              "maxLength": 64
            }
          ]
        },
        "candidates": {
          "type": "array",
          "minItems": 0,
          "maxItems": 4096,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/h4FieldCandidate"
          }
        },
        "canonical_candidates_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "h4Result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root_result",
        "field_result"
      ],
      "properties": {
        "root_result": {
          "$ref": "#/$defs/h4RootResult"
        },
        "field_result": {
          "$ref": "#/$defs/h4FieldResult"
        }
      }
    },
    "layers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "h1_tdef_to_map_row",
        "h2_row_identity_map_role",
        "h3_indirect_traversal",
        "h4_catalog_bootstrap"
      ],
      "properties": {
        "h1_tdef_to_map_row": {
          "$ref": "#/$defs/h1Result"
        },
        "h2_row_identity_map_role": {
          "$ref": "#/$defs/h2Result"
        },
        "h3_indirect_traversal": {
          "$ref": "#/$defs/h3Result"
        },
        "h4_catalog_bootstrap": {
          "$ref": "#/$defs/h4Result"
        }
      }
    },
    "workCharges": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tdef_lifecycle_signatures",
        "raw_locator_windows",
        "raw_locator_pairs",
        "h1_target_validity_checks",
        "valid_path_row_directory_entries",
        "type_1_slots",
        "type_0_and_tag_05_bitmap_bits",
        "role_transition_evaluations",
        "base_formula_evaluations",
        "catalog_root_signatures",
