{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/oglassdev/jet3-rs/oracle/windows-dao/experiments/a4/analysis-report.schema.json",
  "title": "DAO A4 row-anchored allocation analysis report",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "document_type", "experiment_id", "plan_sha256", "revision_plan_sha256", "campaign_id", "producer_commit", "derivation_replicas", "holdout_replica", "holdout_opened_after_freeze", "predicate_results", "layers", "transcripts", "scientific_outcome", "claims"],
  "properties": {
    "protocol_version": {"const": "1.0.0"},
    "document_type": {"const": "dao_a4_analysis_report"},
    "experiment_id": {"const": "DAO-A4-ROW-ANCHORED-MAPS-001"},
    "plan_sha256": {"$ref": "#/$defs/sha256"},
    "revision_plan_sha256": {"$ref": "#/$defs/sha256"},
    "campaign_id": {"$ref": "#/$defs/id"},
    "producer_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "derivation_replicas": {"const": [1, 2]},
    "holdout_replica": {"const": 3},
    "holdout_opened_after_freeze": {"const": true},
    "predicate_results": {"type": "array", "minItems": 40, "maxItems": 40, "items": {"$ref": "#/$defs/predicateResult"}},
    "layers": {"$ref": "#/$defs/layers"},
    "transcripts": {"$ref": "#/$defs/transcripts"},
    "scientific_outcome": {"enum": ["one_or_more_layers_predict_holdout", "no_layer_predicts_holdout"]},
    "claims": {"$ref": "#/$defs/claims"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$", "minLength": 1, "maxLength": 128},
    "predicateId": {"type": "string", "pattern": "^A4-[A-Z0-9-]+$", "minLength": 4, "maxLength": 64},
    "nullablePredicateId": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/predicateId"}]},
    "candidate": {
      "type": "object", "additionalProperties": false, "required": ["model_type", "canonical_id", "model"],
      "properties": {
        "model_type": {"enum": ["h1_locator", "h2_map_role", "h3_traversal", "h4_catalog_root", "h4_catalog_field"]},
        "canonical_id": {"$ref": "#/$defs/sha256"},
        "model": {"type": "object"}
      }
    },
    "result": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "derivation_survivor_count", "terminal_predicate_id", "candidates", "canonical_candidates_sha256", "holdout_evaluated"],
      "properties": {
        "status": {"enum": ["model", "no_outcome", "not_applicable"]},
        "derivation_survivor_count": {"type": "integer", "minimum": 0, "maximum": 4096},
        "terminal_predicate_id": {"$ref": "#/$defs/nullablePredicateId"},
        "candidates": {"type": "array", "minItems": 0, "maxItems": 4096, "uniqueItems": true, "items": {"$ref": "#/$defs/candidate"}},
        "canonical_candidates_sha256": {"$ref": "#/$defs/sha256"},
        "holdout_evaluated": {"type": "boolean"}
      }
    },
    "h4Result": {
      "type": "object", "additionalProperties": false, "required": ["root_result", "field_result"],
      "properties": {"root_result": {"$ref": "#/$defs/result"}, "field_result": {"$ref": "#/$defs/result"}}
    },
    "layers": {
      "type": "object", "additionalProperties": false,
      "required": ["h1_tdef_to_map_row", "h2_row_identity_map_role", "h3_indirect_traversal", "h4_catalog_bootstrap"],
      "properties": {
        "h1_tdef_to_map_row": {"$ref": "#/$defs/result"},
        "h2_row_identity_map_role": {"$ref": "#/$defs/result"},
        "h3_indirect_traversal": {"$ref": "#/$defs/result"},
        "h4_catalog_bootstrap": {"$ref": "#/$defs/h4Result"}
      }
    },
    "predicateResult": {
      "type": "object", "additionalProperties": false,
      "required": ["predicate_id", "order", "scope", "status", "terminal_predicate_id", "derivation_survivor_count", "reachability_fixture_id"],
      "properties": {
        "predicate_id": {"$ref": "#/$defs/predicateId"},
        "order": {"type": "integer", "minimum": 1, "maximum": 40},
        "scope": {"enum": ["campaign", "h1_tdef_to_map_row", "h2_row_identity_map_role", "h3_indirect_traversal", "h4_catalog_bootstrap"]},
        "status": {"enum": ["pass", "fail", "not_applicable"]},
        "terminal_predicate_id": {"$ref": "#/$defs/nullablePredicateId"},
        "derivation_survivor_count": {"type": "integer", "minimum": 0, "maximum": 4096},
        "reachability_fixture_id": {"type": "string", "pattern": "^A4-R[0-9]{2}-[A-Z0-9-]+$", "maxLength": 64}
      }
    },
    "transcripts": {
      "type": "object", "additionalProperties": false,
      "required": ["row_directories", "locators", "map_transitions", "reference_bitmaps", "catalog_roots", "catalog_fields"],
      "properties": {
        "row_directories": {"type": "array", "maxItems": 1024, "items": {"type": "object"}},
        "locators": {"type": "array", "maxItems": 1024, "items": {"type": "object"}},
        "map_transitions": {"type": "array", "maxItems": 1024, "items": {"type": "object"}},
        "reference_bitmaps": {"type": "array", "maxItems": 1024, "items": {"type": "object"}},
        "catalog_roots": {"type": "array", "maxItems": 1024, "items": {"type": "object"}},
        "catalog_fields": {"type": "array", "maxItems": 4096, "items": {"type": "object"}}
      }
    },
    "claims": {
      "type": "object", "additionalProperties": false,
      "required": ["descriptive_provider_observation_only", "a3_calibration_input_is_a4_evidence", "exp_0051_bundle_is_a4_evidence", "synthetic_dry_run_is_a4_evidence", "general_tdef_catalog_row_index_or_lval_layout", "unobserved_slot_or_base_behavior", "compaction_encryption_or_version_behavior", "rust_correctness", "dao_compatibility_or_support", "support_matrix_advancement", "dao_differential_verification", "dao_exposed_physical_oracle", "exact_allocation_set_equality", "general_jet3_or_jet4_behavior", "general_provider_or_locale_behavior", "physical_column_definition_layout", "physical_index_definition_or_node_layout", "row_value_layout", "relationship_layout", "memo_ole_or_long_value_layout", "writer_or_update_behavior", "free_space_preference", "preservation_behavior"],
      "properties": {
        "descriptive_provider_observation_only": {"const": true},
        "a3_calibration_input_is_a4_evidence": {"const": false},
        "exp_0051_bundle_is_a4_evidence": {"const": false},
        "synthetic_dry_run_is_a4_evidence": {"const": false},
        "general_tdef_catalog_row_index_or_lval_layout": {"const": false},
        "unobserved_slot_or_base_behavior": {"const": false},
        "compaction_encryption_or_version_behavior": {"const": false},
        "rust_correctness": {"const": false},
        "dao_compatibility_or_support": {"const": false},
        "support_matrix_advancement": {"const": false},
        "dao_differential_verification": {"const": false},
        "dao_exposed_physical_oracle": {"const": false},
        "exact_allocation_set_equality": {"const": false},
        "general_jet3_or_jet4_behavior": {"const": false},
        "general_provider_or_locale_behavior": {"const": false},
        "physical_column_definition_layout": {"const": false},
        "physical_index_definition_or_node_layout": {"const": false},
        "row_value_layout": {"const": false},
        "relationship_layout": {"const": false},
        "memo_ole_or_long_value_layout": {"const": false},
        "writer_or_update_behavior": {"const": false},
        "free_space_preference": {"const": false},
        "preservation_behavior": {"const": false}
      }
    }
  }
}
