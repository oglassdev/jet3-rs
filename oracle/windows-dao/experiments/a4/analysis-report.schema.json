      ],
      "properties": {
        "tdef_lifecycle_signatures": {
          "type": "integer",
          "minimum": 0,
          "maximum": 800
        },
        "raw_locator_windows": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65440
        },
        "raw_locator_pairs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 66683552
        },
        "valid_path_row_directory_entries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 271600
        },
        "type_1_slots": {
          "type": "integer",
          "minimum": 0,
          "maximum": 406400
        },
        "type_0_and_tag_05_bitmap_bits": {
          "type": "integer",
          "minimum": 0,
          "maximum": 13040000
        },
        "role_transition_evaluations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4000
        },
        "base_formula_evaluations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1600
        },
        "catalog_root_signatures": {
          "type": "integer",
          "minimum": 0,
          "maximum": 800
        },
        "catalog_raw_rows": {
          "type": "integer",
          "minimum": 0,
          "maximum": 76048
        },
        "encoding_length_equivalence_candidates": {
          "type": "integer",
          "minimum": 0,
          "maximum": 21
        },
        "candidate_serializations": {
          "type": "integer",
          "minimum": 0,
