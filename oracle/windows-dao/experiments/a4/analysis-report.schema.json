{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/oglassdev/jet3-rs/oracle/windows-dao/experiments/a4/analysis-report.schema.json",
  "title": "DAO A4 row-anchored allocation analysis report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "document_type",
    "experiment_id",
    "plan_sha256",
    "revision_plan_sha256",
    "campaign_id",
    "producer_commit",
    "derivation_replicas",
    "derivation_candidate_set_sha256",
    "holdout_replica",
    "holdout_opened_after_freeze",
    "predicate_results",
    "layers",
    "holdout_results",
    "transcripts",
    "scientific_outcome",
    "claims",
    "analyzer_logical_read_bytes_by_replica"
  ],
  "properties": {
    "protocol_version": {
      "const": "1.0.0"
    },
    "document_type": {
      "const": "dao_a4_analysis_report"
    },
    "experiment_id": {
      "const": "DAO-A4-ROW-ANCHORED-MAPS-001"
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "revision_plan_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "campaign_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "minLength": 1,
      "maxLength": 128
    },
    "producer_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "derivation_replicas": {
      "const": [
        1,
        2
      ]
    },
    "derivation_candidate_set_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "holdout_replica": {
      "const": 3
    },
    "holdout_opened_after_freeze": {
      "const": true
    },
    "predicate_results": {
      "type": "array",
      "minItems": 40,
      "maxItems": 40,
      "items": {
        "$ref": "#/$defs/predicateResult"
      }
    },
    "layers": {
      "$ref": "#/$defs/layers"
    },
    "holdout_results": {
      "$ref": "#/$defs/holdoutResults"
    },
    "transcripts": {
      "$ref": "#/$defs/transcripts"
    },
    "scientific_outcome": {
      "enum": [
        "one_or_more_layers_predict_holdout",
        "no_layer_predicts_holdout"
      ]
    },
    "claims": {
      "$ref": "#/$defs/claims"
    },
    "analyzer_logical_read_bytes_by_replica": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 134217728
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "minLength": 1,
      "maxLength": 128
    },
    "predicateId": {
      "type": "string",
      "pattern": "^A4-[A-Z0-9-]+$",
      "minLength": 4,
      "maxLength": 64
    },
    "nullablePredicateId": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^A4-[A-Z0-9-]+$",
          "minLength": 4,
          "maxLength": 64
        }
      ]
    },
    "h1Candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_type",
        "canonical_id",
        "model",
        "instance_bindings"
      ],
      "properties": {
        "model_type": {
          "const": "h1_locator"
        },
        "canonical_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "layout",
            "table_signature_id",
            "locator_offsets"
          ],
          "properties": {
            "layout": {
              "enum": [
                "u24le_page_then_u8_row",
                "u8_row_then_u24le_page"
              ]
            },
            "table_signature_id": {
              "const": "a3_page23_masked_record_0_92"
            },
            "locator_offsets": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "uniqueItems": true,
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2044
              }
            }
          }
        },
        "instance_bindings": {
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/h1InstanceBinding"
          }
        }
      }
    },
    "h2Candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_type",
        "canonical_id",
        "model"
      ],
      "properties": {
        "model_type": {
          "const": "h2_map_role"
        },
        "canonical_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "row_mask",
            "polarity",
            "owned_in_use_locator_ordinal",
            "available_locator_ordinal"
          ],
          "properties": {
            "row_mask": {
              "enum": [
                8191,
                4095
              ]
            },
            "polarity": {
              "enum": [
                "set_bit_owned_in_use",
                "clear_bit_owned_in_use"
              ]
            },
            "owned_in_use_locator_ordinal": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1
            },
            "available_locator_ordinal": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      }
    },
    "h3Candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_type",
        "canonical_id",
        "model"
      ],
      "properties": {
        "model_type": {
          "const": "h3_traversal"
        },
        "canonical_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "conversion",
            "base_formula"
          ],
          "properties": {
            "conversion": {
              "const": "structural_type_0_to_type_1_with_nonzero_u32_slots"
            },
            "base_formula": {
              "enum": [
                "slot_ordinal_times_16352_plus_bit_index",
                "referenced_page_times_16352_plus_bit_index",
                "slot_ordinal_times_16352_plus_bit_index_minus_one",
                "slot_ordinal_times_16352_plus_bit_index_plus_one"
              ]
            }
          }
        }
      }
    },
    "h4RootCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_type",
        "canonical_id",
        "model"
      ],
      "properties": {
        "model_type": {
          "const": "h4_catalog_root"
        },
        "canonical_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tdef_page",
            "locator_offsets"
          ],
          "properties": {
            "tdef_page": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20479
            },
            "locator_offsets": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "uniqueItems": true,
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2044
              }
            }
          }
        }
      }
    },
    "h4FieldCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_type",
        "canonical_id",
        "model"
      ],
      "properties": {
        "model_type": {
          "const": "h4_catalog_field"
        },
        "canonical_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name_start",
            "kind_start_delta",
            "kind_width",
            "identifier_width",
            "endianness",
            "name_length_start_delta",
            "name_length_width",
            "name_length_endianness",
            "kind_mapping",
            "identifier_lifecycle",
            "encoding_length_equivalence_class"
          ],
          "properties": {
            "kind_start_delta": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16
            },
            "kind_width": {
              "enum": [
                1,
                2,
                4
              ]
            },
            "identifier_width": {
              "enum": [
                1,
                2,
                4
              ]
            },
            "endianness": {
              "enum": [
                "little",
                "big"
              ]
            },
            "kind_mapping": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "table",
                "field",
                "index"
              ],
              "properties": {
                "table": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 4294967295
                },
                "field": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 4294967295
                },
                "index": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 4294967295
                }
              }
            },
            "identifier_lifecycle": {
              "enum": [
                "stable_for_same_operation_instance_and_distinct_for_t2_v1_v2",
                "stable_for_same_physical_name_including_t2_v1_v2"
              ]
            },
            "encoding_length_equivalence_class": {
              "enum": [
                "cp1252_single_byte_per_scalar",
                "utf8_encoded_byte_count",
                "utf8_unicode_scalar_or_code_unit_count"
              ]
            },
            "name_start": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2037
            },
            "name_length_start_delta": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16
            },
            "name_length_width": {
              "enum": [
                1,
                2,
                4
              ]
            },
            "name_length_endianness": {
              "enum": [
                "little",
                "big"
              ]
            }
          }
        }
      }
    },
    "h1Result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "derivation_survivor_count",
        "terminal_predicate_id",
        "candidates",
        "canonical_candidates_sha256"
      ],
      "properties": {
        "status": {
          "enum": [
            "model",
            "no_outcome",
            "not_applicable"
          ]
        },
        "derivation_survivor_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        },
        "terminal_predicate_id": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^A4-[A-Z0-9-]+$",
              "minLength": 4,
              "maxLength": 64
            }
          ]
        },
        "candidates": {
          "type": "array",
          "minItems": 0,
          "maxItems": 4096,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/h1Candidate"
          }
        },
        "canonical_candidates_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "h2Result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "derivation_survivor_count",
        "terminal_predicate_id",
        "candidates",
        "canonical_candidates_sha256"
      ],
      "properties": {
        "status": {
          "enum": [
            "model",
            "no_outcome",
            "not_applicable"
          ]
        },
        "derivation_survivor_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        },
        "terminal_predicate_id": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^A4-[A-Z0-9-]+$",
              "minLength": 4,
              "maxLength": 64
            }
          ]
        },
        "candidates": {
          "type": "array",
          "minItems": 0,
          "maxItems": 4096,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/h2Candidate"
          }
        },
        "canonical_candidates_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "h3Result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "derivation_survivor_count",
        "terminal_predicate_id",
        "candidates",
        "canonical_candidates_sha256"
      ],
      "properties": {
        "status": {
          "enum": [
            "model",
