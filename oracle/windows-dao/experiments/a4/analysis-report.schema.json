    },
    "transcripts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_directories",
        "locators",
        "map_transitions",
        "reference_bitmaps",
        "catalog_roots",
        "catalog_fields"
      ],
      "properties": {
        "row_directories": {
          "type": "array",
          "minItems": 0,
          "maxItems": 1024,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "checkpoint_id",
              "page",
              "detail_hex"
            ],
            "properties": {
              "kind": {
                "const": "row_directory"
              },
              "checkpoint_id": {
                "type": "string",
                "pattern": "^[A-Z0-9_]+$",
                "minLength": 2,
                "maxLength": 32
              },
              "page": {
                "type": "integer",
                "minimum": 0,
                "maximum": 20479
              },
              "detail_hex": {
