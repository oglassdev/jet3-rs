{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/oglassdev/jet3-rs/oracle/windows-dao/experiments/a4/analysis-report.schema.json",
  "title": "DAO A4 layered row-anchored allocation and catalog analysis report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "document_type",
    "experiment_id",
    "plan_sha256",
    "revision_plan_sha256",
    "campaign_id",
    "producer_commit",
    "derivation_replicas",
    "holdout_replica",
    "input_checkpoint_count",
    "qualified_page_counts",
    "qualified_pages",
    "record_candidates_examined",
    "candidate_models_examined",
    "derivation_survivor_counts",
    "derivation_candidate_set_sha256",
    "polarity_cross_check",
    "analysis_work_units",
    "holdout_structurally_validated_after_freeze",
    "holdout_opened_after_freeze",
    "holdout_evaluated",
    "predicate_results",
    "terminal_predicate_ids",
    "scientific_outcome",
    "no_outcome_reasons",
    "submodels",
    "claims"
  ],
  "properties": {
    "protocol_version": {
      "const": "1.0.0"
    },
    "document_type": {
      "const": "dao_a4_analysis_report"
    },
    "experiment_id": {
      "const": "DAO-A4-ROW-ANCHORED-MAPS-001"
    },
    "plan_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "revision_plan_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "campaign_id": {
      "$ref": "#/$defs/id"
    },
    "producer_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "derivation_replicas": {
      "const": [
        1,
        2
      ]
    },
    "holdout_replica": {
      "const": 3
    },
    "input_checkpoint_count": {
      "const": 75
    },
    "qualified_page_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "h1_tdef",
        "h1_map_rows",
        "h3_extended",
        "h4_catalog"
      ],
      "properties": {
        "h1_tdef": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16
        },
        "h1_map_rows": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16
        },
        "h3_extended": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16
        },
        "h4_catalog": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16
        }
      }
    },
    "qualified_pages": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "h1_tdef",
        "h1_map_rows",
        "h3_extended",
        "h4_catalog"
      ],
      "properties": {
        "h1_tdef": {
          "$ref": "#/$defs/pages"
        },
        "h1_map_rows": {
          "$ref": "#/$defs/pages"
        },
        "h3_extended": {
          "$ref": "#/$defs/pages"
        },
        "h4_catalog": {
          "$ref": "#/$defs/pages"
        }
      }
    },
    "record_candidates_examined": {
      "type": "integer",
      "minimum": 0,
      "maximum": 67141632
    },
    "candidate_models_examined": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "derivation_survivor_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "h1_tdef_to_map_row",
        "h2_row_identity_map_role",
        "h3_indirect_traversal",
        "h4_catalog_bootstrap"
      ],
      "properties": {
        "h1_tdef_to_map_row": {
          "$ref": "#/$defs/count"
        },
        "h2_row_identity_map_role": {
          "$ref": "#/$defs/count"
        },
        "h3_indirect_traversal": {
          "$ref": "#/$defs/count"
        },
        "h4_catalog_bootstrap": {
          "$ref": "#/$defs/count"
        }
      }
    },
    "derivation_candidate_set_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "polarity_cross_check": {
      "$ref": "#/$defs/crossCheck"
    },
    "analysis_work_units": {
      "type": "integer",
      "minimum": 0,
      "maximum": 600000000
    },
    "holdout_structurally_validated_after_freeze": {
      "const": true
    },
    "holdout_opened_after_freeze": {
      "type": "boolean"
    },
    "holdout_evaluated": {
      "type": "boolean"
    },
    "predicate_results": {
      "type": "array",
      "minItems": 40,
      "maxItems": 40,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "predicate_id",
          "status",
          "layer"
        ],
        "properties": {
          "predicate_id": {
            "$ref": "#/$defs/predicateId"
          },
          "status": {
            "type": "string",
            "enum": [
              "pass",
              "fail",
              "not_applicable"
            ]
          },
          "layer": {
            "$ref": "#/$defs/layer"
          }
        }
      }
    },
    "terminal_predicate_ids": {
      "type": "array",
      "maxItems": 40,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/predicateId"
      }
    },
    "scientific_outcome": {
      "type": "string",
      "enum": [
        "one_or_more_submodels_predict_holdout",
        "no_submodel_predicts_holdout"
      ]
    },
    "no_outcome_reasons": {
      "type": "array",
      "maxItems": 40,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/reason"
      }
    },
    "submodels": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "h1_tdef_to_map_row",
        "h2_row_identity_map_role",
        "h3_indirect_traversal",
        "h4_catalog_bootstrap"
      ],
      "properties": {
        "h1_tdef_to_map_row": {
          "$ref": "#/$defs/h1Layer"
        },
        "h2_row_identity_map_role": {
          "$ref": "#/$defs/h2Layer"
        },
        "h3_indirect_traversal": {
          "$ref": "#/$defs/h3Layer"
        },
        "h4_catalog_bootstrap": {
          "$ref": "#/$defs/h4Layer"
        }
      }
    },
    "claims": {
      "$ref": "#/$defs/claims"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "pages": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 65535
      }
    },
    "leg": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "left_checkpoint_id",
        "right_checkpoint_id"
      ],
      "properties": {
        "left_checkpoint_id": {
          "type": "string",
          "pattern": "^[A-Z0-9_]+$"
        },
        "right_checkpoint_id": {
          "type": "string",
          "pattern": "^[A-Z0-9_]+$"
        }
      }
    },
    "nullableLeg": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/leg"
        }
      ]
    },
    "crossCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evaluated_legs",
        "representation_change_stop",
        "first_violating_leg",
        "first_violating_page"
      ],
      "properties": {
        "evaluated_legs": {
          "type": "array",
          "maxItems": 15,
          "items": {
            "$ref": "#/$defs/leg"
          }
        },
        "representation_change_stop": {
          "$ref": "#/$defs/nullableLeg"
        },
        "first_violating_leg": {
          "$ref": "#/$defs/nullableLeg"
        },
        "first_violating_page": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            }
          ]
        }
      }
    },
    "layer": {
      "type": "string",
      "enum": [
        "campaign",
        "h1_tdef_to_map_row",
        "h2_row_identity_map_role",
        "h3_indirect_traversal",
        "h4_catalog_bootstrap"
      ]
    },
    "reason": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "minLength": 1,
      "maxLength": 128
    },
    "predicateId": {
      "type": "string",
      "enum": [
        "A4-IDLE-EQUALITY",
        "A4-SCHEMA-SNAPSHOT",
        "A4-SNAPSHOT-RECONSTRUCTION",
        "A4-RESOURCE-BOUND",
        "A4-H1-TDEF-NONE",
        "A4-H1-TDEF-MULTIPLE",
        "A4-H1-LOCATOR-LAYOUT-NONE",
        "A4-H1-LOCATOR-LAYOUT-MULTIPLE",
        "A4-H1-LOCATOR-PAIR-NONE",
        "A4-H1-LOCATOR-PAIR-MULTIPLE",
        "A4-H1-TARGET-ROW-INVALID",
        "A4-H1-REPLICA-DISAGREEMENT",
        "A4-H1-HOLDOUT-PREDICTION",
        "A4-H2-ROW-DIRECTORY-INVALID",
        "A4-H2-ROW-FLAGS-INVALID",
        "A4-H2-MAP-TAG-UNSUPPORTED",
        "A4-H2-ROLE-NONE",
        "A4-H2-ROLE-MULTIPLE",
        "A4-H2-TRANSITION-UNEXPLAINED",
        "A4-H2-REPLICA-DISAGREEMENT",
        "A4-H2-HOLDOUT-PREDICTION",
        "A4-H3-CONVERSION-NONE",
        "A4-H3-INACTIVE-SLOT-NONE",
        "A4-H3-REFERENCE-INVALID",
        "A4-H3-BASE-DISCRIMINATION",
        "A4-H3-BASE-NONE",
        "A4-H3-BASE-MULTIPLE",
        "A4-H3-REPLICA-DISAGREEMENT",
        "A4-H3-HOLDOUT-PREDICTION",
        "A4-H4-CATALOG-ROOT-NONE",
        "A4-H4-CATALOG-ROOT-MULTIPLE",
        "A4-H4-CATALOG-RECORD-NONE",
        "A4-H4-CATALOG-RECORD-MULTIPLE",
        "A4-H4-SCHEMA-DELTA-OUTSIDE-OWNED",
        "A4-H4-FIELD-MODEL-NONE",
        "A4-H4-FIELD-MODEL-MULTIPLE",
        "A4-H4-ENCODING-AMBIGUOUS",
        "A4-H4-REPLICA-DISAGREEMENT",
        "A4-H4-HOLDOUT-ROOT",
        "A4-H4-HOLDOUT-FIELDS"
      ]
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "page",
        "start",
        "end"
      ],
      "properties": {
        "page": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "start": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2047
        },
        "end": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2048
        }
      }
    },
    "layerStatus": {
      "type": "string",
      "enum": [
        "decisive_predicts_holdout",
        "no_outcome",
        "not_applicable"
      ]
    },
    "globalRecordModel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record",
        "bit_polarity",
        "zero_suffix_slack_bytes"
      ],
      "properties": {
        "record": {
          "$ref": "#/$defs/record"
        },
        "bit_polarity": {
          "type": "string",
          "enum": [
            "set_means_in_use",
            "set_means_not_in_use"
          ]
        },
        "zero_suffix_slack_bytes": {
          "type": "integer",
          "minimum": 16,
          "maximum": 2048
        }
      }
    },
    "conversionModel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conversion_checkpoint_id",
        "conversion_ordinal",
        "indirect_tag",
        "active_slot_count_at_conversion",
        "active_slot_count_at_h_rel_0904",
        "inline_boundary",
        "slot_reference_pages"
      ],
      "properties": {
        "conversion_checkpoint_id": {
          "type": "string",
          "minLength": 2,
          "maxLength": 32,
          "pattern": "^[A-Z0-9_]+$"
        },
        "conversion_ordinal": {
          "type": "integer",
          "minimum": 1,
          "maximum": 24
        },
        "indirect_tag": {
          "const": 1
        },
        "active_slot_count_at_conversion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        "active_slot_count_at_h_rel_0904": {
          "const": 2
        },
        "inline_boundary": {
          "type": "integer",
          "minimum": 5,
          "maximum": 2048
        },
        "slot_reference_pages": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535
          }
        }
      }
    },
    "baseModel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "extended_base_formula"
      ],
      "properties": {
        "extended_base_formula": {
          "type": "string",
          "enum": [
            "slot_relative_expected_0_16352",
            "referenced_page_relative",
            "slot_relative_off_by_minus_one",
            "slot_relative_off_by_plus_one",
            "referenced_page_relative_off_by_minus_one",
            "referenced_page_relative_off_by_plus_one"
          ]
        }
      }
    },
    "tdefModel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record",
        "pointer_layout",
        "growth_pointer_offset",
        "delete_reinsert_pointer_offset"
      ],
      "properties": {
        "record": {
          "$ref": "#/$defs/record"
        },
        "pointer_layout": {
          "type": "string",
          "enum": [
            "u24le_page_then_u8_slot",
            "u8_slot_then_u24le_page"
          ]
        },
        "growth_pointer_offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2044
        },
        "delete_reinsert_pointer_offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2044
        }
      }
    },
    "globalRecordLayer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "derivation_survivor_count",
        "holdout_evaluated",
        "no_outcome_reasons",
        "terminal_predicate_id",
        "model"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/layerStatus"
        },
        "derivation_survivor_count": {
          "$ref": "#/$defs/count"
        },
        "holdout_evaluated": {
          "type": "boolean"
        },
        "no_outcome_reasons": {
          "type": "array",
          "maxItems": 34,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/reason"
          }
        },
        "terminal_predicate_id": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/predicateId"
            }
          ]
        },
        "model": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/globalRecordModel"
            }
          ]
        }
      }
    },
    "conversionLayer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "derivation_survivor_count",
        "holdout_evaluated",
        "no_outcome_reasons",
        "terminal_predicate_id",
        "model"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/layerStatus"
        },
        "derivation_survivor_count": {
          "$ref": "#/$defs/count"
        },
        "holdout_evaluated": {
          "type": "boolean"
        },
        "no_outcome_reasons": {
          "type": "array",
          "maxItems": 34,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/reason"
          }
        },
        "terminal_predicate_id": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/predicateId"
            }
          ]
        },
        "model": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/conversionModel"
            }
          ]
        }
      }
    },
    "baseLayer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "derivation_survivor_count",
        "holdout_evaluated",
        "no_outcome_reasons",
        "terminal_predicate_id",
        "model"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/layerStatus"
        },
        "derivation_survivor_count": {
          "$ref": "#/$defs/count"
        },
        "holdout_evaluated": {
          "type": "boolean"
        },
        "no_outcome_reasons": {
          "type": "array",
          "maxItems": 34,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/reason"
          }
        },
        "terminal_predicate_id": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/predicateId"
            }
          ]
        },
        "model": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/baseModel"
            }
          ]
        }
      }
    },
    "tdefLayer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "derivation_survivor_count",
        "holdout_evaluated",
        "no_outcome_reasons",
        "terminal_predicate_id",
        "model"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/layerStatus"
        },
        "derivation_survivor_count": {
          "$ref": "#/$defs/count"
        },
        "holdout_evaluated": {
          "type": "boolean"
        },
        "no_outcome_reasons": {
          "type": "array",
          "maxItems": 34,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/reason"
          }
        },
        "terminal_predicate_id": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/predicateId"
            }
          ]
        },
        "model": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/tdefModel"
            }
          ]
        }
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "descriptive_provider_observation_only",
        "a3_calibration_input_is_a4_evidence",
        "exp_0051_bundle_is_a4_evidence",
        "synthetic_dry_run_is_a4_evidence",
        "general_tdef_catalog_row_index_or_lval_layout",
        "unobserved_slot_or_base_behavior",
        "compaction_encryption_or_version_behavior",
        "rust_correctness",
        "dao_compatibility_or_support"
      ],
      "properties": {
        "descriptive_provider_observation_only": {
          "const": true
        },
        "a3_calibration_input_is_a4_evidence": {
          "const": false
        },
        "exp_0051_bundle_is_a4_evidence": {
          "const": false
        },
        "synthetic_dry_run_is_a4_evidence": {
          "const": false
        },
        "general_tdef_catalog_row_index_or_lval_layout": {
          "const": false
        },
        "unobserved_slot_or_base_behavior": {
          "const": false
        },
        "compaction_encryption_or_version_behavior": {
          "const": false
        },
        "rust_correctness": {
          "const": false
        },
        "dao_compatibility_or_support": {
          "const": false
        }
      }
    },
    "h1Model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "locator_layout",
        "row_offset_mask",
        "tables"
      ],
      "properties": {
        "locator_layout": {
          "type": "string",
          "enum": [
            "u24le_page_then_u8_row",
            "u8_row_then_u24le_page"
          ]
        },
        "row_offset_mask": {
          "type": "integer",
          "enum": [
            4095,
            8191
          ]
        },
        "tables": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "logical_role",
              "tdef_page",
              "locator_offsets"
            ],
            "properties": {
              "logical_role": {
                "type": "string",
                "enum": [
                  "T1",
                  "T2",
                  "T3",
                  "T4"
                ]
              },
              "tdef_page": {
                "type": "integer",
                "minimum": 1,
                "maximum": 20479
              },
              "locator_offsets": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "uniqueItems": true,
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 2044
                }
              }
            }
          }
        }
      }
    },
    "h2Model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owned_in_use_locator_ordinal",
        "available_locator_ordinal",
        "observed_tags",
        "row_motion_observed"
      ],
      "properties": {
        "owned_in_use_locator_ordinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "available_locator_ordinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "observed_tags": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "enum": [
              0,
              1
            ]
