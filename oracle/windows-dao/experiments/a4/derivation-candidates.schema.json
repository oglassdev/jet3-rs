          "maximum": 65440
        },
        "raw_locator_pairs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 66683552
        },
        "locator_transition_signatures": {
          "type": "integer",
          "minimum": 0,
          "maximum": 224
        },
        "valid_path_row_directory_entries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 800
        },
        "type_1_slots": {
          "type": "integer",
          "minimum": 0,
          "maximum": 406400
        },
        "type_0_and_tag_05_bitmap_bits": {
          "type": "integer",
          "minimum": 0,
          "maximum": 13040000
        },
        "role_transition_evaluations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4000
        },
        "base_formula_evaluations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1600
        },
        "catalog_root_signatures": {
          "type": "integer",
          "minimum": 0,
          "maximum": 800
        },
        "catalog_raw_rows": {
          "type": "integer",
          "minimum": 0,
          "maximum": 76048
        },
        "h4_raw_structural_tuples": {
          "type": "integer",
          "minimum": 0,
          "maximum": 262821888
        },
        "encoding_length_equivalence_candidates": {
          "type": "integer",
          "minimum": 0,
          "maximum": 21
        },
        "candidate_serializations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        },
        "total_work_units": {
          "type": "integer",
          "minimum": 0,
          "maximum": 350000000
        }
      }
    },
    "transcripts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_directories",
        "locators",
        "map_transitions",
        "reference_bitmaps",
        "catalog_roots",
