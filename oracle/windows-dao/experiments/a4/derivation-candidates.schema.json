{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/oglassdev/jet3-rs/oracle/windows-dao/experiments/a4/derivation-candidates.schema.json",
  "title": "DAO A4 frozen derivation candidate sets",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "document_type",
    "experiment_id",
    "plan_sha256",
    "revision_plan_sha256",
    "campaign_id",
    "derivation_replicas",
    "qualified_pages",
    "work_charges",
    "layers",
    "transcripts"
  ],
  "properties": {
    "protocol_version": {
      "const": "1.0.0"
    },
    "document_type": {
      "const": "dao_a4_frozen_derivation_candidates"
    },
    "experiment_id": {
      "const": "DAO-A4-ROW-ANCHORED-MAPS-001"
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "revision_plan_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "campaign_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "minLength": 1,
      "maxLength": 128
    },
    "derivation_replicas": {
      "const": [
        1,
        2
      ]
    },
    "qualified_pages": {
      "type": "array",
      "minItems": 0,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 20479
      }
    },
    "work_charges": {
      "$ref": "#/$defs/workCharges"
    },
    "layers": {
      "$ref": "#/$defs/layers"
    },
    "transcripts": {
      "$ref": "#/$defs/transcripts"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "minLength": 1,
      "maxLength": 128
    },
    "predicateId": {
      "type": "string",
      "pattern": "^A4-[A-Z0-9-]+$",
      "minLength": 4,
      "maxLength": 64
    },
    "nullablePredicateId": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^A4-[A-Z0-9-]+$",
          "minLength": 4,
          "maxLength": 64
        }
      ]
    },
    "h1TdefCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_type", "canonical_model_id", "canonical_candidate_id", "model", "instance_bindings"],
      "properties": {
        "model_type": {"const": "h1_tdef"},
        "canonical_model_id": {"$ref": "#/$defs/sha256"},
        "canonical_candidate_id": {"$ref": "#/$defs/sha256"},
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tdef_lifecycle_signature"],
          "properties": {
            "tdef_lifecycle_signature": {"enum": ["new_tag_02_at_role_create", "preexisting_tag_02_hash_transition"]}
          }
        },
        "instance_bindings": {
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/h1TdefInstanceBinding"}
        }
      }
    },
    "h1TargetValidLayoutCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_type", "canonical_model_id", "canonical_candidate_id", "model", "instance_bindings"],
      "properties": {
        "model_type": {"const": "h1_target_valid_layout"},
        "canonical_model_id": {"$ref": "#/$defs/sha256"},
        "canonical_candidate_id": {"$ref": "#/$defs/sha256"},
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": ["layout", "table_signature_id"],
          "properties": {
            "layout": {"enum": ["u24le_page_then_u8_row", "u8_row_then_u24le_page"]},
            "table_signature_id": {"const": "a3_page23_masked_record_0_92"}
          }
        },
        "instance_bindings": {
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/h1InstanceBinding"}
        }
      }
    },
    "h1LocatorPairCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_type", "canonical_model_id", "canonical_candidate_id", "model", "instance_bindings"],
      "properties": {
        "model_type": {"const": "h1_locator_pair"},
        "canonical_model_id": {"$ref": "#/$defs/sha256"},
        "canonical_candidate_id": {"$ref": "#/$defs/sha256"},
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": ["layout", "table_signature_id", "locator_offsets"],
          "properties": {
            "layout": {"enum": ["u24le_page_then_u8_row", "u8_row_then_u24le_page"]},
            "table_signature_id": {"const": "a3_page23_masked_record_0_92"},
            "locator_offsets": {
              "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true,
              "items": {"type": "integer", "minimum": 0, "maximum": 2044}
            }
          }
        },
        "instance_bindings": {
          "type": "array", "minItems": 10, "maxItems": 10, "uniqueItems": true,
          "items": {"$ref": "#/$defs/h1InstanceBinding"}
        }
      }
    },
    "h2StructuralDecoderCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_type", "canonical_candidate_id", "model"],
      "properties": {
        "model_type": {"const": "h2_structural_decoder"},
        "canonical_candidate_id": {"$ref": "#/$defs/sha256"},
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": ["row_mask"],
          "properties": {
            "row_mask": {"enum": [8191, 4095]}
          }
        }
      }
    },
    "h2FinalRoleCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_type", "canonical_candidate_id", "model"],
      "properties": {
        "model_type": {"const": "h2_final_role"},
        "canonical_candidate_id": {"$ref": "#/$defs/sha256"},
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": ["row_mask", "polarity", "owned_in_use_locator_ordinal", "available_locator_ordinal"],
          "properties": {
            "row_mask": {"enum": [8191, 4095]},
            "polarity": {"enum": ["set_bit_owned_in_use", "clear_bit_owned_in_use"]},
            "owned_in_use_locator_ordinal": {"type": "integer", "minimum": 0, "maximum": 1},
            "available_locator_ordinal": {"type": "integer", "minimum": 0, "maximum": 1}
          }
        }
      }
    },
    "h3ConversionCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_type", "canonical_candidate_id", "model"],
      "properties": {
        "model_type": {"const": "h3_conversion"},
        "canonical_candidate_id": {"$ref": "#/$defs/sha256"},
        "model": {"type": "object", "additionalProperties": false, "required": ["conversion"], "properties": {"conversion": {"const": "structural_type_0_to_type_1_with_nonzero_u32_slots"}}}
      }
    },
    "h3FinalBaseFormulaCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_type", "canonical_candidate_id", "model"],
      "properties": {
        "model_type": {"const": "h3_final_base_formula"},
        "canonical_candidate_id": {"$ref": "#/$defs/sha256"},
        "model": {
          "type": "object", "additionalProperties": false, "required": ["conversion", "base_formula"],
          "properties": {
            "conversion": {"const": "structural_type_0_to_type_1_with_nonzero_u32_slots"},
            "base_formula": {"enum": ["slot_ordinal_times_16352_plus_bit_index", "referenced_page_times_16352_plus_bit_index", "slot_ordinal_times_16352_plus_bit_index_minus_one", "slot_ordinal_times_16352_plus_bit_index_plus_one"]}
          }
        }
      }
    },
    "h4RootCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_type", "canonical_candidate_id", "model"],
      "properties": {
        "model_type": {"const": "h4_catalog_root"},
        "canonical_candidate_id": {"$ref": "#/$defs/sha256"},
        "model": {
          "type": "object", "additionalProperties": false, "required": ["tdef_page", "locator_offsets"],
          "properties": {
            "tdef_page": {"type": "integer", "minimum": 0, "maximum": 20479},
            "locator_offsets": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": {"type": "integer", "minimum": 0, "maximum": 2044}}
          }
        }
      }
    },
    "catalogRecordLocator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["page", "row", "row_start", "row_end"],
      "properties": {
        "page": {"type": "integer", "minimum": 0, "maximum": 20479},
        "row": {"type": "integer", "minimum": 0, "maximum": 255},
        "row_start": {"type": "integer", "minimum": 10, "maximum": 2047},
        "row_end": {"type": "integer", "minimum": 11, "maximum": 2048}
      }
    },
    "operationId": {"enum": ["T1_CREATE_ID", "T1_ADD_TEXT", "T1_ADD_INDEX", "T2_CREATE", "T2_RECREATE", "T3_CREATE", "T4_CREATE"]},
    "compatibleNameOccurrence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name_start", "matched_registered_pattern_id", "matched_bytes_hex", "stored_length_field"],
      "properties": {
        "name_start": {"type": "integer", "minimum": 0, "maximum": 2035},
        "matched_registered_pattern_id": {"type": "string", "pattern": "^[A-Z0-9_]+_(CP1252|UTF8)$", "maxLength": 64},
        "matched_bytes_hex": {"type": "string", "pattern": "^[0-9a-f]{14,18}$"},
        "stored_length_field": {
          "type": "object", "additionalProperties": false, "required": ["row_relative_start", "width", "value"],
          "properties": {
            "row_relative_start": {"type": "integer", "minimum": 0, "maximum": 2035},
            "width": {"enum": [1, 2, 4]},
            "value": {"type": "integer", "minimum": 0, "maximum": 4294967295}
          }
        }
      }
    },
    "h4OperationBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["operation_id", "canonical_record_locator", "compatible_name_occurrences"],
      "properties": {
        "operation_id": {"$ref": "#/$defs/operationId"},
        "canonical_record_locator": {"$ref": "#/$defs/catalogRecordLocator"},
        "compatible_name_occurrences": {"type": "array", "minItems": 1, "maxItems": 290, "uniqueItems": true, "items": {"$ref": "#/$defs/compatibleNameOccurrence"}}
      }
    },
    "h4OperationRecordCandidate": {
      "type": "object", "additionalProperties": false,
      "required": ["model_type", "canonical_candidate_id", "model"],
      "properties": {
        "model_type": {"const": "h4_operation_record"},
        "canonical_candidate_id": {"$ref": "#/$defs/sha256"},
        "model": {"type": "object", "additionalProperties": false, "required": ["root_candidate_id", "operation_id", "canonical_record_locator"], "properties": {"root_candidate_id": {"$ref": "#/$defs/sha256"}, "operation_id": {"$ref": "#/$defs/operationId"}, "canonical_record_locator": {"$ref": "#/$defs/catalogRecordLocator"}}}
      }
    },
    "h4StructuralFieldCandidate": {
      "type": "object", "additionalProperties": false,
      "required": ["model_type", "canonical_candidate_id", "model"],
      "properties": {
        "model_type": {"const": "h4_structural_field"},
        "canonical_candidate_id": {"$ref": "#/$defs/sha256"},
        "model": {
          "type": "object", "additionalProperties": false,
          "required": ["kind_start_delta", "kind_width", "identifier_width", "endianness", "name_length_start_delta", "name_length_width", "name_length_endianness", "kind_mapping", "identifier_lifecycle", "operation_bindings"],
          "properties": {
            "kind_start_delta": {"type": "integer", "minimum": 1, "maximum": 16},
            "kind_width": {"enum": [1, 2, 4]},
            "identifier_width": {"enum": [1, 2, 4]},
            "endianness": {"enum": ["little", "big"]},
            "name_length_start_delta": {"type": "integer", "minimum": 1, "maximum": 16},
            "name_length_width": {"enum": [1, 2, 4]},
            "name_length_endianness": {"enum": ["little", "big"]},
            "kind_mapping": {"type": "object", "additionalProperties": false, "required": ["table", "field", "index"], "properties": {"table": {"type": "integer", "minimum": 0, "maximum": 4294967295}, "field": {"type": "integer", "minimum": 0, "maximum": 4294967295}, "index": {"type": "integer", "minimum": 0, "maximum": 4294967295}}},
            "identifier_lifecycle": {"enum": ["stable_for_same_operation_instance_and_distinct_for_t2_v1_v2", "stable_for_same_physical_name_including_t2_v1_v2"]},
            "operation_bindings": {"type": "array", "minItems": 7, "maxItems": 7, "uniqueItems": true, "items": {"$ref": "#/$defs/h4OperationBinding"}}
          }
        }
      }
    },
    "selectedOperationOccurrence": {
      "type": "object", "additionalProperties": false, "required": ["operation_id", "selected_occurrence"],
      "properties": {"operation_id": {"$ref": "#/$defs/operationId"}, "selected_occurrence": {"$ref": "#/$defs/compatibleNameOccurrence"}}
    },
    "h4FinalFieldCandidate": {
      "type": "object", "additionalProperties": false,
      "required": ["model_type", "canonical_candidate_id", "model"],
      "properties": {
        "model_type": {"const": "h4_final_encoded_field"},
        "canonical_candidate_id": {"$ref": "#/$defs/sha256"},
        "model": {
          "type": "object", "additionalProperties": false,
          "required": ["structural_candidate_id", "encoding_length_equivalence_class", "selected_operation_occurrences"],
          "properties": {
            "structural_candidate_id": {"$ref": "#/$defs/sha256"},
            "encoding_length_equivalence_class": {"enum": ["cp1252_single_byte_per_scalar", "utf8_encoded_byte_count", "utf8_unicode_scalar_or_code_unit_count"]},
            "selected_operation_occurrences": {"type": "array", "minItems": 7, "maxItems": 7, "uniqueItems": true, "items": {"$ref": "#/$defs/selectedOperationOccurrence"}}
          }
        }
      }
    },
    "h1Result": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "predicate_measured_survivor_count", "derivation_survivor_count", "terminal_predicate_id", "terminal_candidate_stage", "candidates", "canonical_candidates_sha256"],
      "properties": {
        "status": {"enum": ["model", "no_outcome", "not_applicable"]},
        "predicate_measured_survivor_count": {"type": "integer", "minimum": 0, "maximum": 4096},
        "derivation_survivor_count": {"type": "integer", "minimum": 0, "maximum": 1},
        "terminal_predicate_id": {"$ref": "#/$defs/nullablePredicateId"},
        "terminal_candidate_stage": {"anyOf": [{"type": "null"}, {"enum": ["h1_tdef", "h1_target_valid_layout", "h1_locator_pair"]}]},
        "candidates": {"type": "array", "minItems": 0, "maxItems": 4096, "uniqueItems": true, "items": {"anyOf": [{"$ref": "#/$defs/h1TdefCandidate"}, {"$ref": "#/$defs/h1TargetValidLayoutCandidate"}, {"$ref": "#/$defs/h1LocatorPairCandidate"}]}},
        "canonical_candidates_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "h2Result": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "predicate_measured_survivor_count", "derivation_survivor_count", "terminal_predicate_id", "terminal_candidate_stage", "candidates", "canonical_candidates_sha256"],
      "properties": {
        "status": {"enum": ["model", "no_outcome", "not_applicable"]},
        "predicate_measured_survivor_count": {"type": "integer", "minimum": 0, "maximum": 4096},
        "derivation_survivor_count": {"type": "integer", "minimum": 0, "maximum": 1},
        "terminal_predicate_id": {"$ref": "#/$defs/nullablePredicateId"},
        "terminal_candidate_stage": {"anyOf": [{"type": "null"}, {"enum": ["h2_structural_decoder", "h2_final_role"]}]},
        "candidates": {"type": "array", "minItems": 0, "maxItems": 4096, "uniqueItems": true, "items": {"anyOf": [{"$ref": "#/$defs/h2StructuralDecoderCandidate"}, {"$ref": "#/$defs/h2FinalRoleCandidate"}]}},
        "canonical_candidates_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "h3Result": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "predicate_measured_survivor_count", "derivation_survivor_count", "terminal_predicate_id", "terminal_candidate_stage", "candidates", "canonical_candidates_sha256"],
      "properties": {
        "status": {"enum": ["model", "no_outcome", "not_applicable"]},
        "predicate_measured_survivor_count": {"type": "integer", "minimum": 0, "maximum": 4096},
        "derivation_survivor_count": {"type": "integer", "minimum": 0, "maximum": 1},
        "terminal_predicate_id": {"$ref": "#/$defs/nullablePredicateId"},
        "terminal_candidate_stage": {"anyOf": [{"type": "null"}, {"enum": ["h3_conversion", "h3_final_base_formula"]}]},
        "candidates": {"type": "array", "minItems": 0, "maxItems": 4096, "uniqueItems": true, "items": {"anyOf": [{"$ref": "#/$defs/h3ConversionCandidate"}, {"$ref": "#/$defs/h3FinalBaseFormulaCandidate"}]}},
        "canonical_candidates_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "h4RootResult": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "predicate_measured_survivor_count", "derivation_survivor_count", "terminal_predicate_id", "terminal_candidate_stage", "candidates", "canonical_candidates_sha256"],
      "properties": {
        "status": {"enum": ["model", "no_outcome", "not_applicable"]},
        "predicate_measured_survivor_count": {"type": "integer", "minimum": 0, "maximum": 4096},
        "derivation_survivor_count": {"type": "integer", "minimum": 0, "maximum": 1},
        "terminal_predicate_id": {"$ref": "#/$defs/nullablePredicateId"},
        "terminal_candidate_stage": {"anyOf": [{"type": "null"}, {"const": "h4_catalog_root"}]},
        "candidates": {"type": "array", "minItems": 0, "maxItems": 4096, "uniqueItems": true, "items": {"$ref": "#/$defs/h4RootCandidate"}},
        "canonical_candidates_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "h4FieldResult": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "predicate_measured_survivor_count", "derivation_survivor_count", "terminal_predicate_id", "terminal_candidate_stage", "candidates", "canonical_candidates_sha256"],
      "properties": {
        "status": {"enum": ["model", "no_outcome", "not_applicable"]},
        "predicate_measured_survivor_count": {"type": "integer", "minimum": 0, "maximum": 4096},
        "derivation_survivor_count": {"type": "integer", "minimum": 0, "maximum": 1},
        "terminal_predicate_id": {"$ref": "#/$defs/nullablePredicateId"},
        "terminal_candidate_stage": {"anyOf": [{"type": "null"}, {"enum": ["h4_operation_record", "h4_structural_field", "h4_final_encoded_field"]}]},
        "candidates": {"type": "array", "minItems": 0, "maxItems": 4096, "uniqueItems": true, "items": {"anyOf": [{"$ref": "#/$defs/h4OperationRecordCandidate"}, {"$ref": "#/$defs/h4StructuralFieldCandidate"}, {"$ref": "#/$defs/h4FinalFieldCandidate"}]}},
        "canonical_candidates_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "h4Result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root_result",
        "field_result"
      ],
      "properties": {
        "root_result": {
          "$ref": "#/$defs/h4RootResult"
        },
        "field_result": {
          "$ref": "#/$defs/h4FieldResult"
        }
      }
    },
    "layers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "h1_tdef_to_map_row",
        "h2_row_identity_map_role",
        "h3_indirect_traversal",
        "h4_catalog_bootstrap"
      ],
      "properties": {
        "h1_tdef_to_map_row": {
          "$ref": "#/$defs/h1Result"
        },
        "h2_row_identity_map_role": {
          "$ref": "#/$defs/h2Result"
        },
        "h3_indirect_traversal": {
          "$ref": "#/$defs/h3Result"
        },
        "h4_catalog_bootstrap": {
          "$ref": "#/$defs/h4Result"
        }
      }
    },
    "workCharges": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tdef_lifecycle_signatures",
        "raw_locator_windows",
        "raw_locator_pairs",
        "h1_target_validity_checks",
        "valid_path_row_directory_entries",
        "type_1_slots",
        "type_0_and_tag_05_bitmap_bits",
        "role_transition_evaluations",
        "base_formula_evaluations",
        "catalog_root_signatures",
        "catalog_raw_rows",
        "encoding_union_anchor_bytes",
        "h4_name_length_structural_tuples",
        "encoding_length_equivalence_candidates",
        "candidate_serializations",
        "total_work_units"
      ],
      "properties": {
        "tdef_lifecycle_signatures": {
          "type": "integer",
          "minimum": 0,
          "maximum": 800
        },
        "raw_locator_windows": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65440
        },
        "raw_locator_pairs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 66683552
        },
        "valid_path_row_directory_entries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 271600
        },
        "type_1_slots": {
          "type": "integer",
          "minimum": 0,
          "maximum": 406400
        },
        "type_0_and_tag_05_bitmap_bits": {
          "type": "integer",
          "minimum": 0,
          "maximum": 13040000
        },
        "role_transition_evaluations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4000
        },
        "base_formula_evaluations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1600
        },
        "catalog_root_signatures": {
          "type": "integer",
          "minimum": 0,
          "maximum": 800
        },
        "catalog_raw_rows": {
          "type": "integer",
          "minimum": 0,
          "maximum": 76048
        },
        "encoding_length_equivalence_candidates": {
          "type": "integer",
          "minimum": 0,
          "maximum": 21
        },
        "candidate_serializations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        },
        "total_work_units": {
          "type": "integer",
          "minimum": 0,
          "maximum": 600000000
        },
        "h1_target_validity_checks": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1600
        },
        "encoding_union_anchor_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18324
        },
        "h4_name_length_structural_tuples": {
          "type": "integer",
          "minimum": 0,
          "maximum": 306892800
        }
      }
    },
    "transcripts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
