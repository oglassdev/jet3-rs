{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/oglassdev/jet3-rs/oracle/windows-dao/experiments/a4/derivation-candidates.schema.json",
  "title": "DAO A4 frozen derivation candidate sets",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "document_type", "experiment_id", "plan_sha256", "revision_plan_sha256", "campaign_id", "derivation_replicas", "qualified_pages", "work_charges", "layers", "transcripts"],
  "properties": {
    "protocol_version": {"const": "1.0.0"},
    "document_type": {"const": "dao_a4_frozen_derivation_candidates"},
    "experiment_id": {"const": "DAO-A4-ROW-ANCHORED-MAPS-001"},
    "plan_sha256": {"$ref": "#/$defs/sha256"},
    "revision_plan_sha256": {"$ref": "#/$defs/sha256"},
    "campaign_id": {"$ref": "#/$defs/id"},
    "derivation_replicas": {"const": [1, 2]},
    "qualified_pages": {"type": "array", "minItems": 0, "maxItems": 64, "uniqueItems": true, "items": {"type": "integer", "minimum": 0, "maximum": 20479}},
    "work_charges": {"$ref": "#/$defs/workCharges"},
    "layers": {"$ref": "#/$defs/layers"},
    "transcripts": {"$ref": "#/$defs/transcripts"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$", "minLength": 1, "maxLength": 128},
    "predicateId": {"type": "string", "pattern": "^A4-[A-Z0-9-]+$", "minLength": 4, "maxLength": 64},
    "nullablePredicateId": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/predicateId"}]},
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_type", "canonical_id", "model"],
      "properties": {
        "model_type": {"enum": ["h1_locator", "h2_map_role", "h3_traversal", "h4_catalog_root", "h4_catalog_field"]},
        "canonical_id": {"$ref": "#/$defs/sha256"},
        "model": {"type": "object"}
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "derivation_survivor_count", "terminal_predicate_id", "candidates", "canonical_candidates_sha256", "holdout_evaluated"],
      "properties": {
        "status": {"enum": ["model", "no_outcome", "not_applicable"]},
        "derivation_survivor_count": {"type": "integer", "minimum": 0, "maximum": 4096},
        "terminal_predicate_id": {"$ref": "#/$defs/nullablePredicateId"},
        "candidates": {"type": "array", "minItems": 0, "maxItems": 4096, "uniqueItems": true, "items": {"$ref": "#/$defs/candidate"}},
        "canonical_candidates_sha256": {"$ref": "#/$defs/sha256"},
        "holdout_evaluated": {"type": "boolean"}
      }
    },
    "h4Result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root_result", "field_result"],
      "properties": {"root_result": {"$ref": "#/$defs/result"}, "field_result": {"$ref": "#/$defs/result"}}
    },
    "layers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["h1_tdef_to_map_row", "h2_row_identity_map_role", "h3_indirect_traversal", "h4_catalog_bootstrap"],
      "properties": {
        "h1_tdef_to_map_row": {"$ref": "#/$defs/result"},
        "h2_row_identity_map_role": {"$ref": "#/$defs/result"},
        "h3_indirect_traversal": {"$ref": "#/$defs/result"},
        "h4_catalog_bootstrap": {"$ref": "#/$defs/h4Result"}
      }
    },
    "workCharges": {
      "type": "object",
      "additionalProperties": false,
      "required": ["row_directory_entries", "tdef_lifecycle_signatures", "locator_pairs", "type_1_slots", "bitmap_bits", "transition_models", "base_formula_evaluations", "catalog_root_signatures", "catalog_rows", "catalog_field_candidates", "candidate_serializations", "total"],
      "properties": {
        "row_directory_entries": {"type": "integer", "minimum": 0, "maximum": 407600},
        "tdef_lifecycle_signatures": {"type": "integer", "minimum": 0, "maximum": 800},
        "locator_pairs": {"type": "integer", "minimum": 0, "maximum": 66683552},
        "type_1_slots": {"type": "integer", "minimum": 0, "maximum": 408800},
        "bitmap_bits": {"type": "integer", "minimum": 0, "maximum": 13078400},
        "transition_models": {"type": "integer", "minimum": 0, "maximum": 4000},
        "base_formula_evaluations": {"type": "integer", "minimum": 0, "maximum": 1600},
        "catalog_root_signatures": {"type": "integer", "minimum": 0, "maximum": 800},
        "catalog_rows": {"type": "integer", "minimum": 0, "maximum": 407600},
        "catalog_field_candidates": {"type": "integer", "minimum": 0, "maximum": 102400},
        "candidate_serializations": {"type": "integer", "minimum": 0, "maximum": 4096},
        "total": {"type": "integer", "minimum": 0, "maximum": 81099648}
      }
    },
    "transcripts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["row_directories", "locators", "map_transitions", "reference_bitmaps", "catalog_roots", "catalog_fields"],
      "properties": {
        "row_directories": {"type": "array", "maxItems": 1024, "items": {"type": "object"}},
        "locators": {"type": "array", "maxItems": 1024, "items": {"type": "object"}},
        "map_transitions": {"type": "array", "maxItems": 1024, "items": {"type": "object"}},
        "reference_bitmaps": {"type": "array", "maxItems": 1024, "items": {"type": "object"}},
        "catalog_roots": {"type": "array", "maxItems": 1024, "items": {"type": "object"}},
        "catalog_fields": {"type": "array", "maxItems": 4096, "items": {"type": "object"}}
      }
    }
  }
}
