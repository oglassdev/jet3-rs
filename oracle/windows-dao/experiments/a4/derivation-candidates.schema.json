        }
      }
    },
    "workCharges": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tdef_lifecycle_signatures",
        "raw_locator_windows",
        "raw_locator_pairs",
        "locator_transition_signatures",
        "valid_path_row_directory_entries",
        "type_1_slots",
        "type_0_and_tag_05_bitmap_bits",
        "role_transition_evaluations",
        "base_formula_evaluations",
