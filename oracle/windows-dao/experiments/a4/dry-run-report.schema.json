{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/oglassdev/jet3-rs/oracle/windows-dao/experiments/a4/dry-run-report.schema.json",
  "title": "DAO A4 pre-acquisition analyzer dry-run report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "document_type",
    "experiment_id",
    "plan_sha256",
    "analyzer_commit",
    "recorded_utc",
    "source_kind",
    "source_identity",
    "checkpoint_schedule_source",
    "input_page_blob_count",
    "holdout_opened",
    "parameter_coverage",
    "predicted_terminal_states",
    "terminal_predicate_ids",
    "result",
    "assertions",
    "scientific_evidence",
    "acquisition_authorized",
    "capability_advancement_authorized"
  ],
  "properties": {
    "protocol_version": {
      "const": "1.0.0"
    },
    "document_type": {
      "const": "dao_a4_analyzer_dry_run_report"
    },
    "experiment_id": {
      "const": "DAO-A4-ROW-ANCHORED-MAPS-001"
    },
    "plan_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "analyzer_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "recorded_utc": {
      "type": "string",
      "format": "date-time",
      "maxLength": 64
    },
    "source_kind": {
      "type": "string",
      "enum": [
        "retained_a3_exp_0051_calibration_derivation_only",
        "a4_schedule_synthetic"
      ]
    },
    "source_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_or_fixture_sha256",
        "generator_sha256"
      ],
      "properties": {
        "manifest_or_fixture_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "generator_sha256": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/sha256"
            }
          ]
        }
      }
    },
    "checkpoint_schedule_source": {
      "type": "string",
      "enum": [
        "explicit_exp_0051_checkpoint_projection",
        "hash_pinned_a4_plan_checkpoint_design"
      ]
    },
    "input_page_blob_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1800
    },
    "holdout_opened": {
      "type": "boolean"
    },
    "parameter_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "moving_row",
        "deleted_row",
        "overflow_row",
        "wrong_locator_target",
        "zero_slot",
        "nonzero_slot",
        "no_inactive_slot",
        "base_ambiguity",
        "catalog_multiplicity",
        "encoding_ambiguity",
        "replica_disagreement",
        "holdout_failure",
        "resource_exact_ceiling",
        "resource_one_over",
        "campaign_2700_seconds",
        "campaign_2701_seconds"
      ],
      "properties": {
        "moving_row": {
          "const": true
        },
        "deleted_row": {
          "const": true
        },
        "overflow_row": {
          "const": true
        },
        "wrong_locator_target": {
          "const": true
        },
        "zero_slot": {
          "const": true
        },
        "nonzero_slot": {
          "const": true
        },
        "no_inactive_slot": {
          "const": true
        },
        "base_ambiguity": {
          "const": true
        },
        "catalog_multiplicity": {
          "const": true
        },
        "encoding_ambiguity": {
          "const": true
        },
        "replica_disagreement": {
          "const": true
        },
        "holdout_failure": {
          "const": true
        },
        "resource_exact_ceiling": {
          "const": true
        },
        "resource_one_over": {
          "const": true
        },
        "campaign_2700_seconds": {
          "const": true
        },
        "campaign_2701_seconds": {
          "const": true
        }
      }
    },
    "predicted_terminal_states": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/predicateId"
      }
    },
    "terminal_predicate_ids": {
      "type": "array",
      "maxItems": 40,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/predicateId"
      }
    },
    "result": {
      "type": "string",
      "enum": [
        "pass",
        "fail"
      ]
    },
    "assertions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "scientific_evidence": {
      "const": false
    },
    "acquisition_authorized": {
      "const": false
    },
    "capability_advancement_authorized": {
      "const": false
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "predicateId": {
      "type": "string",
      "enum": [
        "A4-IDLE-EQUALITY",
        "A4-SCHEMA-SNAPSHOT",
        "A4-SNAPSHOT-RECONSTRUCTION",
        "A4-RESOURCE-BOUND",
        "A4-H1-TDEF-NONE",
        "A4-H1-TDEF-MULTIPLE",
        "A4-H1-LOCATOR-LAYOUT-NONE",
        "A4-H1-LOCATOR-LAYOUT-MULTIPLE",
        "A4-H1-LOCATOR-PAIR-NONE",
        "A4-H1-LOCATOR-PAIR-MULTIPLE",
        "A4-H1-TARGET-ROW-INVALID",
        "A4-H1-REPLICA-DISAGREEMENT",
        "A4-H1-HOLDOUT-PREDICTION",
        "A4-H2-ROW-DIRECTORY-INVALID",
        "A4-H2-ROW-FLAGS-INVALID",
        "A4-H2-MAP-TAG-UNSUPPORTED",
        "A4-H2-ROLE-NONE",
        "A4-H2-ROLE-MULTIPLE",
        "A4-H2-TRANSITION-UNEXPLAINED",
        "A4-H2-REPLICA-DISAGREEMENT",
        "A4-H2-HOLDOUT-PREDICTION",
        "A4-H3-CONVERSION-NONE",
        "A4-H3-INACTIVE-SLOT-NONE",
        "A4-H3-REFERENCE-INVALID",
        "A4-H3-BASE-DISCRIMINATION",
        "A4-H3-BASE-NONE",
        "A4-H3-BASE-MULTIPLE",
        "A4-H3-REPLICA-DISAGREEMENT",
        "A4-H3-HOLDOUT-PREDICTION",
        "A4-H4-CATALOG-ROOT-NONE",
        "A4-H4-CATALOG-ROOT-MULTIPLE",
        "A4-H4-CATALOG-RECORD-NONE",
        "A4-H4-CATALOG-RECORD-MULTIPLE",
        "A4-H4-SCHEMA-DELTA-OUTSIDE-OWNED",
        "A4-H4-FIELD-MODEL-NONE",
        "A4-H4-FIELD-MODEL-MULTIPLE",
        "A4-H4-ENCODING-AMBIGUOUS",
        "A4-H4-REPLICA-DISAGREEMENT",
        "A4-H4-HOLDOUT-ROOT",
        "A4-H4-HOLDOUT-FIELDS"
      ]
    }
  }
}
