{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/oglassdev/jet3-rs/oracle/windows-dao/experiments/a4/replica-observation.schema.json",
  "title": "DAO A4 independent replica checkpoint observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "document_type",
    "experiment_id",
    "plan_sha256",
    "revision_plan_sha256",
    "producer_commit",
    "repository_url",
    "campaign_id",
    "matrix_job",
    "environment_sha256",
    "provider_sha256",
    "replica",
    "role_binding",
    "growth_observations",
    "logical_checkpoint_read_bytes",
    "inserted_rows_total",
    "changed_hash_entries",
    "checkpoints"
  ],
  "properties": {
    "protocol_version": {
      "const": "1.0.0"
    },
    "document_type": {
      "const": "dao_a4_replica_observation"
    },
    "experiment_id": {
      "const": "DAO-A4-ROW-ANCHORED-MAPS-001"
    },
    "plan_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "revision_plan_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "producer_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "repository_url": {
      "const": "https://github.com/oglassdev/jet3-rs.git"
    },
    "campaign_id": {
      "$ref": "#/$defs/id"
    },
    "matrix_job": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "job_id",
        "replica_only",
        "shared_mutable_state"
      ],
      "properties": {
        "job_id": {
          "$ref": "#/$defs/id"
        },
        "replica_only": {
          "const": true
        },
        "shared_mutable_state": {
          "const": false
        }
      }
    },
    "environment_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "provider_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "replica": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "role_binding": {
      "$ref": "#/$defs/roleBinding"
    },
    "logical_checkpoint_read_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483648
    },
    "inserted_rows_total": {
      "type": "integer",
      "minimum": 0,
      "maximum": 200000
    },
    "changed_hash_entries": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65536
    },
    "checkpoints": {
      "type": "array",
      "minItems": 25,
      "maxItems": 25,
      "items": {
        "$ref": "#/$defs/checkpoint"
      }
    },
    "growth_observations": {
      "type": "array",
      "minItems": 0,
      "maxItems": 11,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/growthObservation"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "roleBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "T1",
        "T2",
        "T3",
        "T4"
      ],
      "properties": {
        "T1": {
          "$ref": "#/$defs/tableName"
        },
        "T2": {
          "$ref": "#/$defs/tableName"
        },
        "T3": {
          "$ref": "#/$defs/tableName"
        },
        "T4": {
          "$ref": "#/$defs/tableName"
        }
      }
    },
    "tableName": {
      "type": "string",
      "enum": [
        "A4TAB_A1",
        "A4TAB_B2",
        "A4TAB_C3",
        "A4TAB_É4"
      ]
    },
    "rowCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "T1",
        "T2",
        "T3",
        "T4"
      ],
      "properties": {
        "T1": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200000
        },
        "T2": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200000
        },
        "T3": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200000
        },
        "T4": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200000
        }
      }
    },
    "reread": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "row_count",
        "rolling_sha256"
      ],
      "properties": {
        "role": {
          "type": "string",
          "enum": [
            "T1",
            "T2",
            "T3",
            "T4"
          ]
        },
        "row_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200000
        },
        "rolling_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "companion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "present_after_close",
        "observed_size_bytes",
        "retained_for_physical_analysis"
      ],
      "properties": {
        "present_after_close": {
          "const": false
        },
        "observed_size_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65536
        },
        "retained_for_physical_analysis": {
          "const": false
        }
      }
    },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^page-indexes/replica-[0-9]{2}/[0-9]{2}-[A-Z0-9_]+\\.json$"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864
        }
      }
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checkpoint_id",
        "ordinal",
        "actual_file_pages",
        "actual_size_bytes",
        "target_baseline_pages",
        "target_threshold_pages",
        "target_overshoot_pages",
        "inserted_rows_total",
        "table_row_counts",
        "dao_reread",
        "quiescent",
        "post_close_companion",
        "page_index",
        "dao_schema_snapshot"
      ],
      "properties": {
        "checkpoint_id": {
          "type": "string",
          "minLength": 2,
          "maxLength": 32,
          "pattern": "^[A-Z0-9_]+$"
        },
        "ordinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 24
        },
        "actual_file_pages": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20480
        },
        "actual_size_bytes": {
          "type": "integer",
          "minimum": 2048,
          "maximum": 41943040
        },
        "target_baseline_pages": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 20480
            }
          ]
        },
        "target_threshold_pages": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 20480
            }
          ]
        },
        "target_overshoot_pages": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 20479
            }
          ]
        },
        "inserted_rows_total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200000
        },
        "table_row_counts": {
          "$ref": "#/$defs/rowCounts"
        },
        "dao_reread": {
          "type": "array",
          "minItems": 0,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/reread"
          }
        },
        "quiescent": {
          "const": true
        },
        "post_close_companion": {
          "$ref": "#/$defs/companion"
        },
        "page_index": {
          "$ref": "#/$defs/artifactRef"
        },
        "dao_schema_snapshot": {
          "$ref": "#/$defs/schemaArtifactRef"
        }
      }
    },
    "growthObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checkpoint_id",
        "baseline_pages",
        "target_pages",
        "achieved_pages",
        "overshoot_pages",
        "rows"
      ],
      "properties": {
        "checkpoint_id": {
          "type": "string",
          "pattern": "^(T1_REL_(0064|0512|0768|1280)|T3_ABS_(04096|08192|12288|16480)|T4_REL_(0064|0896|0904))$"
        },
        "baseline_pages": {
          "anyOf": [
            {"type": "null"},
            {"type": "integer", "minimum": 1, "maximum": 20480}
          ]
        },
        "target_pages": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20480
        },
        "achieved_pages": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20480
        },
        "overshoot_pages": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20479
        },
        "rows": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200000
        }
      }
    },
    "schemaArtifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^schema-snapshots/replica-[0-9]{2}/[0-9]{2}-[A-Z0-9_]+\\.json$",
          "minLength": 1,
          "maxLength": 256
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864
        }
      }
    }
  }
}
