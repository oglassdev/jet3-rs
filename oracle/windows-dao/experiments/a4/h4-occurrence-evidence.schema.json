  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "catalogRecordLocator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "page",
        "row",
        "row_start",
        "row_end"
      ],
      "properties": {
        "page": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20479
        },
        "row": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "row_start": {
          "type": "integer",
          "minimum": 10,
          "maximum": 2047
        },
        "row_end": {
          "type": "integer",
          "minimum": 11,
          "maximum": 2048
        }
      }
    },
    "occurrence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "occurrence_index",
        "name_start",
        "matched_registered_pattern_id",
        "matched_bytes_hex"
      ],
      "properties": {
        "occurrence_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 289
        },
        "name_start": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2035
        },
        "matched_registered_pattern_id": {
          "type": "string",
          "pattern": "^[A-Z0-9_]+_(CP1252|UTF8)$",
          "maxLength": 64
        },
        "matched_bytes_hex": {
          "type": "string",
          "pattern": "^[0-9a-f]{14,18}$"
        }
      }
    }
  }
