{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/oglassdev/jet3-rs/oracle/windows-dao/experiments/a4/dao-schema-snapshot.schema.json",
  "title": "DAO A4 canonical schema snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "document_type",
    "experiment_id",
    "plan_sha256",
    "revision_plan_sha256",
    "producer_commit",
    "campaign_id",
    "environment_sha256",
    "provider_sha256",
    "replica",
    "checkpoint_id",
    "ordinal",
    "windows_ansi_code_page",
    "database_sha256_before_read",
    "database_sha256_after_read",
    "database_unchanged_by_read",
    "dao_identifier_observable",
    "identity_oracle",
    "canonicalization",
    "tables"
  ],
  "properties": {
    "protocol_version": {"const": "1.0.0"},
    "document_type": {"const": "dao_a4_schema_snapshot"},
    "experiment_id": {"const": "DAO-A4-ROW-ANCHORED-MAPS-001"},
    "plan_sha256": {"$ref": "#/$defs/sha256"},
    "revision_plan_sha256": {"$ref": "#/$defs/sha256"},
    "producer_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "campaign_id": {"$ref": "#/$defs/id"},
    "environment_sha256": {"$ref": "#/$defs/sha256"},
    "provider_sha256": {"$ref": "#/$defs/sha256"},
    "replica": {"type": "integer", "minimum": 1, "maximum": 3},
    "checkpoint_id": {"type": "string", "pattern": "^[A-Z0-9_]+$", "minLength": 2, "maxLength": 32},
    "ordinal": {"type": "integer", "minimum": 0, "maximum": 24},
    "windows_ansi_code_page": {"const": 1252},
    "database_sha256_before_read": {"$ref": "#/$defs/sha256"},
    "database_sha256_after_read": {"$ref": "#/$defs/sha256"},
    "database_unchanged_by_read": {"const": true},
    "dao_identifier_observable": {"const": false},
    "identity_oracle": {"const": "listed_operation_instance_equality_only"},
    "canonicalization": {
      "const": "include only non-system DAO TableDefs (Name not prefixed MSys and Attributes & dbSystemObject == 0); preserve each collection's zero-based DAO enumeration ordinal after Refresh; sort tables by ordinal then strict Windows-1252 name bytes and sort fields, indexes, and index fields by their own ordinal then name bytes; retain exact BSTR UTF-16 code units and strict Windows-1252 bytes; emit integers as JSON integers and lowercase SHA-256"
    },
    "tables": {
      "type": "array",
      "minItems": 0,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/table"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$", "minLength": 1, "maxLength": 128},
    "name": {"type": "string", "minLength": 1, "maxLength": 64},
    "nameBytes": {"type": "string", "pattern": "^[0-9a-f]+$", "minLength": 2, "maxLength": 256},
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ordinal", "ordinal_source", "name", "name_utf16_code_units", "name_windows_1252_hex", "type", "size", "attributes", "required", "allow_zero_length"],
      "properties": {
        "ordinal": {"type": "integer", "minimum": 0, "maximum": 255},
        "ordinal_source": {"const": "Fields zero-based DAO enumeration after Refresh"},
        "name": {"$ref": "#/$defs/name"},
        "name_utf16_code_units": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "integer", "minimum": 0, "maximum": 65535}},
        "name_windows_1252_hex": {"$ref": "#/$defs/nameBytes"},
        "type": {"type": "integer", "minimum": 0, "maximum": 255},
        "size": {"type": "integer", "minimum": 0, "maximum": 65535},
        "attributes": {"type": "integer", "minimum": -2147483648, "maximum": 2147483647},
        "required": {"type": "boolean"},
        "allow_zero_length": {"type": "boolean"}
      }
    },
    "indexField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ordinal", "ordinal_source", "name", "name_utf16_code_units", "name_windows_1252_hex", "descending"],
      "properties": {
        "ordinal": {"type": "integer", "minimum": 0, "maximum": 255},
        "ordinal_source": {"const": "Index.Fields zero-based DAO enumeration after Refresh"},
        "name": {"$ref": "#/$defs/name"},
        "name_utf16_code_units": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "integer", "minimum": 0, "maximum": 65535}},
        "name_windows_1252_hex": {"$ref": "#/$defs/nameBytes"},
        "descending": {"type": "boolean"}
      }
    },
    "index": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ordinal", "ordinal_source", "name", "name_utf16_code_units", "name_windows_1252_hex", "attributes", "primary", "unique", "ignore_nulls", "fields"],
      "properties": {
        "ordinal": {"type": "integer", "minimum": 0, "maximum": 255},
        "ordinal_source": {"const": "Indexes zero-based DAO enumeration after Refresh"},
        "name": {"$ref": "#/$defs/name"},
        "name_utf16_code_units": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "integer", "minimum": 0, "maximum": 65535}},
        "name_windows_1252_hex": {"$ref": "#/$defs/nameBytes"},
        "attributes": {"type": "integer", "minimum": -2147483648, "maximum": 2147483647},
        "primary": {"type": "boolean"},
        "unique": {"type": "boolean"},
        "ignore_nulls": {"type": "boolean"},
        "fields": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/indexField"}}
      }
    },
    "table": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ordinal", "ordinal_source", "logical_role", "lifecycle_instance", "name", "name_utf16_code_units", "name_windows_1252_hex", "attributes", "row_count", "rolling_row_sha256", "fields", "indexes"],
      "properties": {
        "ordinal": {"type": "integer", "minimum": 0, "maximum": 3},
        "ordinal_source": {"const": "TableDefs zero-based user-table enumeration after Refresh"},
        "logical_role": {"type": "string", "enum": ["T1", "T2", "T3", "T4"]},
        "lifecycle_instance": {"enum": ["T1-v1", "T2-v1", "T2-v2", "T3-v1", "T4-v1"]},
        "name": {"type": "string", "enum": ["A4TAB_A1", "A4TAB_B2", "A4TAB_C3", "A4TAB_É4"]},
        "name_utf16_code_units": {"type": "array", "minItems": 8, "maxItems": 8, "items": {"type": "integer", "minimum": 0, "maximum": 65535}},
        "name_windows_1252_hex": {"$ref": "#/$defs/nameBytes"},
        "attributes": {"type": "integer", "minimum": -2147483648, "maximum": 2147483647},
        "row_count": {"type": "integer", "minimum": 0, "maximum": 200000},
        "rolling_row_sha256": {"$ref": "#/$defs/sha256"},
        "fields": {"type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/field"}},
        "indexes": {"type": "array", "minItems": 0, "maxItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/index"}}
      }
    }
  }
}
