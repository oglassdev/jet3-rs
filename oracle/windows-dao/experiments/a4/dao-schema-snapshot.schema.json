{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/oglassdev/jet3-rs/oracle/windows-dao/experiments/a4/dao-schema-snapshot.schema.json",
  "title": "DAO A4 canonical schema snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "document_type",
    "experiment_id",
    "plan_sha256",
    "revision_plan_sha256",
    "producer_commit",
    "campaign_id",
    "environment_sha256",
    "provider_sha256",
    "replica",
    "checkpoint_id",
    "ordinal",
    "windows_ansi_code_page",
    "database_sha256_before_read",
    "database_sha256_after_read",
    "database_unchanged_by_read",
    "dao_identifier_observable",
    "identity_oracle",
    "canonicalization",
    "tables"
  ],
  "properties": {
    "protocol_version": {
      "const": "1.0.0"
    },
    "document_type": {
      "const": "dao_a4_schema_snapshot"
    },
    "experiment_id": {
      "const": "DAO-A4-ROW-ANCHORED-MAPS-001"
    },
    "plan_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "revision_plan_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "producer_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "campaign_id": {
      "$ref": "#/$defs/id"
    },
    "environment_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "provider_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "replica": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "checkpoint_id": {
      "type": "string",
      "pattern": "^[A-Z0-9_]+$",
      "minLength": 2,
      "maxLength": 32
    },
    "ordinal": {
      "type": "integer",
      "minimum": 0,
      "maximum": 24
    },
    "windows_ansi_code_page": {
      "const": 1252
    },
    "database_sha256_before_read": {
      "$ref": "#/$defs/sha256"
    },
    "database_sha256_after_read": {
      "$ref": "#/$defs/sha256"
    },
    "database_unchanged_by_read": {
      "const": true
    },
    "dao_identifier_observable": {
      "const": false
    },
    "identity_oracle": {
      "const": "listed_operation_instance_equality_only"
    },
    "canonicalization": {
      "const": "after each Refresh require exactly the extant scheduled physical table names from expected_schema_by_checkpoint and exactly the extant scheduled index name A4IX_ID; include every field and index field; use no implementation-defined hidden/system index test; assign zero-based ordinals after those exact filters; sort each filtered collection by ordinal then strict Windows-1252 name bytes; reject duplicate ordinals or names; retain exact BSTR UTF-16 code units plus strict Windows-1252 and UTF-8 expected bytes without comparing either to physical bytes; emit integers as JSON integers and lowercase SHA-256"
    },
    "tables": {
      "type": "array",
      "minItems": 0,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/table"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "minLength": 1,
      "maxLength": 128
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "nameBytes": {
      "type": "string",
      "pattern": "^[0-9a-f]+$",
      "minLength": 2,
      "maxLength": 256
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ordinal",
        "ordinal_source",
        "name",
        "name_utf16_code_units",
        "name_windows_1252_hex",
        "type",
        "size",
        "attributes",
        "required",
        "allow_zero_length",
        "name_utf8_hex"
      ],
      "properties": {
        "ordinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "ordinal_source": {
          "const": "Fields zero-based position after Refresh and the all-fields filter"
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "name_utf16_code_units": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535
          }
        },
        "name_windows_1252_hex": {
          "$ref": "#/$defs/nameBytes"
        },
        "type": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "attributes": {
          "enum": [
            0,
            1
          ]
        },
        "required": {
          "type": "boolean"
        },
        "allow_zero_length": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "boolean"
            }
          ]
        },
        "name_utf8_hex": {
          "$ref": "#/$defs/nameBytes"
        }
      }
    },
    "indexField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ordinal",
        "ordinal_source",
        "name",
        "name_utf16_code_units",
        "name_windows_1252_hex",
        "descending",
        "name_utf8_hex"
      ],
      "properties": {
        "ordinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "ordinal_source": {
          "const": "Index.Fields zero-based position after Refresh and the all-fields filter"
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "name_utf16_code_units": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535
          }
        },
        "name_windows_1252_hex": {
          "$ref": "#/$defs/nameBytes"
        },
        "descending": {
          "const": false
        },
        "name_utf8_hex": {
          "$ref": "#/$defs/nameBytes"
        }
      }
    },
    "index": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ordinal",
        "ordinal_source",
        "name",
        "name_utf16_code_units",
        "name_windows_1252_hex",
        "attributes",
        "primary",
        "unique",
        "required",
        "ignore_nulls",
        "fields",
        "name_utf8_hex"
      ],
      "properties": {
        "ordinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "ordinal_source": {
          "const": "Indexes zero-based position after Refresh and exact A4IX_ID scheduled-name filtering"
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "name_utf16_code_units": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535
          }
        },
        "name_windows_1252_hex": {
          "$ref": "#/$defs/nameBytes"
        },
        "attributes": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        },
        "primary": {
          "type": "boolean"
        },
        "unique": {
          "type": "boolean"
        },
        "required": {
          "type": "boolean"
        },
        "ignore_nulls": {
          "type": "boolean"
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/indexField"
          }
        },
        "name_utf8_hex": {
          "$ref": "#/$defs/nameBytes"
        }
      }
    },
    "table": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ordinal",
        "ordinal_source",
        "logical_role",
        "lifecycle_instance",
        "name",
        "name_utf16_code_units",
        "name_windows_1252_hex",
        "attributes",
        "row_count",
        "rolling_row_sha256",
        "fields",
        "indexes",
        "name_utf8_hex"
      ],
      "properties": {
        "ordinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "ordinal_source": {
          "const": "TableDefs zero-based position after Refresh and exact extant scheduled-name filtering"
        },
        "logical_role": {
          "type": "string",
          "enum": [
            "T1",
            "T2",
            "T3",
            "T4"
          ]
        },
        "lifecycle_instance": {
          "enum": [
            "T1-v1",
            "T2-v1",
            "T2-v2",
            "T3-v1",
            "T4-v1"
          ]
        },
        "name": {
          "type": "string",
          "enum": [
            "A4TAB_A1",
            "A4TAB_B2",
            "A4TAB_C3",
            "A4TAB_É4"
          ]
        },
        "name_utf16_code_units": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535
          }
        },
        "name_windows_1252_hex": {
          "$ref": "#/$defs/nameBytes"
        },
        "attributes": {
          "const": 0
        },
        "row_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200000
        },
        "rolling_row_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/field"
          }
        },
        "indexes": {
          "type": "array",
          "minItems": 0,
          "maxItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/index"
          }
        },
        "name_utf8_hex": {
          "$ref": "#/$defs/nameBytes"
        }
      }
    }
  }
}
