  "properties":{"protocol_version":{"const":"1.0.0"},"document_type":{"const":"dao_m5_worker_result"},"experiment_id":{"const":"DAO-M5-COMPACT-CONFIRM-004"},"sample_id":{"$ref":"#/$defs/id"},"condition_id":{"$ref":"#/$defs/id"},"phase_id":{"enum":["source","compact","verify"]},"phase_ordinal":{"type":"integer","minimum":1,"maximum":3},"worker_run_id":{"$ref":"#/$defs/id"},"worker_ordinal":{"type":"integer","minimum":1,"maximum":324},"nonce":{"type":"string","pattern":"^[0-9a-f]{32}$"},"process_id":{"type":"integer","minimum":1,"maximum":4294967295},"architecture":{"const":"x86"},"provider":{"$ref":"#/$defs/provider"},"started_at_utc":{"type":"string","format":"date-time"},"finished_at_utc":{"type":"string","format":"date-time"},"bindings_verified_before_com":{"const":true},"invocation_sha256":{"$ref":"#/$defs/sha"},"operation_log":{"$ref":"#/$defs/artifact"},"snapshot":{"anyOf":[{"type":"null"},{"$ref":"#/$defs/artifact"}]},"database_observations":{"type":"array","minItems":1,"maxItems":2,"uniqueItems":true,"items":{"$ref":"#/$defs/observation"}},"execution_status":{"const":"pass"}},
