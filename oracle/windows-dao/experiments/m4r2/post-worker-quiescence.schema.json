{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jet3-rs:dao:m4r2:post-worker-quiescence:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version", "document_type", "experiment_id", "sample_id",
    "phase_id", "phase_ordinal", "worker_run_id", "worker_finished_at_utc",
    "observation_started_at_utc", "observation_completed_at_utc",
    "worker_exit_wait_completed", "database", "companion", "status"
  ],
  "properties": {
    "protocol_version": {"const": "1.0.0"},
    "document_type": {"const": "dao_m4_post_worker_quiescence"},
    "experiment_id": {"const": "DAO-M4-HEADER-DISCRIMINATOR-003"},
    "sample_id": {"$ref": "#/$defs/sample"},
    "phase_id": {"enum": ["creator", "reopen"]},
    "phase_ordinal": {"enum": [1, 2]},
    "worker_run_id": {"$ref": "#/$defs/worker"},
    "worker_finished_at_utc": {"type": "string", "format": "date-time"},
    "observation_started_at_utc": {"type": "string", "format": "date-time"},
    "observation_completed_at_utc": {"type": "string", "format": "date-time"},
    "worker_exit_wait_completed": {"const": true},
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path", "bytes", "sha256", "prefix_sha256", "file_identity",
        "exclusive_open_verified", "matches_worker_post_close_observation"
      ],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "bytes": {"type": "integer", "minimum": 2048, "maximum": 1048576},
        "sha256": {"$ref": "#/$defs/sha"},
        "prefix_sha256": {"$ref": "#/$defs/sha"},
        "file_identity": {"$ref": "#/$defs/file_identity"},
        "exclusive_open_verified": {"const": true},
        "matches_worker_post_close_observation": {"const": true}
      }
    },
    "companion": {
      "anyOf": [
        {"$ref": "#/$defs/absent_companion"},
        {"$ref": "#/$defs/present_companion"}
      ]
    },
    "status": {"const": "pass"}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sample": {"type": "string", "pattern": "^M4-V(?:20|30|40)-(?:U|E)-0[1-6]$"},
    "worker": {"type": "string", "pattern": "^M4-V(?:20|30|40)-(?:U|E)-0[1-6]-(?:CREATOR|REOPEN)$"},
    "path": {"type": "string", "minLength": 3, "maxLength": 255, "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9._-]{0,63}/){1,5}[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "file_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["volume_serial_number", "file_index", "link_count"],
      "properties": {
        "volume_serial_number": {"type": "string", "pattern": "^[0-9a-f]{8}$"},
        "file_index": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
        "link_count": {"const": 1}
      }
    },
    "absent_companion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "path", "checked_after_worker_exit"],
      "properties": {
        "state": {"const": "absent"},
        "path": {"$ref": "#/$defs/path"},
        "checked_after_worker_exit": {"const": true}
      }
    },
    "present_companion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state", "path", "bytes", "sha256", "file_identity",
        "exclusive_open_verified", "checked_after_worker_exit"
      ],
      "properties": {
        "state": {"const": "present"},
        "path": {"$ref": "#/$defs/path"},
        "bytes": {"type": "integer", "minimum": 0, "maximum": 65536},
        "sha256": {"$ref": "#/$defs/sha"},
        "file_identity": {"$ref": "#/$defs/file_identity"},
        "exclusive_open_verified": {"const": true},
        "checked_after_worker_exit": {"const": true}
      }
    }
  }
}
