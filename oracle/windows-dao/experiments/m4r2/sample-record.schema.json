{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jet3-rs:dao:m4r2:sample-record:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "document_type",
    "experiment_id",
    "plan_sha256",
    "producer_commit",
    "environment_sha256",
    "provider_sha256",
    "sample_id",
    "condition_id",
    "replica",
    "block",
    "position_in_block",
    "launch_ordinal",
    "creation",
    "phases",
    "controller_clone",
    "execution_status"
  ],
  "properties": {
    "protocol_version": {"const": "1.0.0"},
    "document_type": {"const": "dao_m4_sample_record"},
    "experiment_id": {"const": "DAO-M4-HEADER-DISCRIMINATOR-003"},
    "plan_sha256": {"$ref": "#/$defs/sha256"},
    "producer_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "environment_sha256": {"$ref": "#/$defs/sha256"},
    "provider_sha256": {"$ref": "#/$defs/sha256"},
    "sample_id": {"$ref": "#/$defs/sample_id"},
    "condition_id": {
      "enum": ["V20-U", "V20-E", "V30-U", "V30-E", "V40-U", "V40-E"]
    },
    "replica": {"type": "integer", "minimum": 1, "maximum": 6},
    "block": {"type": "integer", "minimum": 1, "maximum": 6},
    "position_in_block": {"type": "integer", "minimum": 1, "maximum": 6},
    "launch_ordinal": {"type": "integer", "minimum": 1, "maximum": 36},
    "creation": {
      "anyOf": [
        {"const": {"method":"DBEngine.CreateDatabase","version_option":"dbVersion20","version_api_value":16,"encryption_option":"omitted","encryption_api_value":0,"create_option_value":16,"compact_database_used":false}},
        {"const": {"method":"DBEngine.CreateDatabase","version_option":"dbVersion20","version_api_value":16,"encryption_option":"dbEncrypt","encryption_api_value":2,"create_option_value":18,"compact_database_used":false}},
        {"const": {"method":"DBEngine.CreateDatabase","version_option":"dbVersion30","version_api_value":32,"encryption_option":"omitted","encryption_api_value":0,"create_option_value":32,"compact_database_used":false}},
        {"const": {"method":"DBEngine.CreateDatabase","version_option":"dbVersion30","version_api_value":32,"encryption_option":"dbEncrypt","encryption_api_value":2,"create_option_value":34,"compact_database_used":false}},
        {"const": {"method":"DBEngine.CreateDatabase","version_option":"dbVersion40","version_api_value":64,"encryption_option":"omitted","encryption_api_value":0,"create_option_value":64,"compact_database_used":false}},
        {"const": {"method":"DBEngine.CreateDatabase","version_option":"dbVersion40","version_api_value":64,"encryption_option":"dbEncrypt","encryption_api_value":2,"create_option_value":66,"compact_database_used":false}}
      ]
    },
    "phases": {
      "type": "object",
      "additionalProperties": false,
      "required": ["creator", "reopen"],
      "properties": {
        "creator": {"$ref": "#/$defs/creator_phase"},
        "reopen": {"$ref": "#/$defs/reopen_phase"}
      }
    },
    "controller_clone": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "clone_log",
        "started_at_utc",
        "completed_at_utc",
        "source_path",
        "destination_path",
        "source_bytes",
        "destination_bytes",
        "source_sha256_before_clone",
        "source_sha256_after_clone",
        "destination_sha256",
        "source_file_identity",
        "destination_file_identity",
        "creator_closed_before_clone",
        "source_immutable_during_clone",
        "source_unchanged_after_clone",
        "all_hashes_equal",
        "exact_byte_clone",
        "source_reparse_free",
        "destination_reparse_free",
        "no_hardlink",
        "same_volume",
        "distinct_file_identity",
        "identities_preserved_by_same_volume_publish_rename",
        "completed_before_reopen_com",
        "reopen_bindings_verified_before_com",
        "status"
      ],
      "properties": {
        "owner": {"const": "controller"},
        "clone_log": {"$ref": "#/$defs/artifact_set_member"},
        "started_at_utc": {"type": "string", "format": "date-time"},
        "completed_at_utc": {"type": "string", "format": "date-time"},
        "source_path": {"$ref": "#/$defs/safe_relative_path"},
        "destination_path": {"$ref": "#/$defs/safe_relative_path"},
        "source_bytes": {"$ref": "#/$defs/database_bytes"},
        "destination_bytes": {"$ref": "#/$defs/database_bytes"},
        "source_sha256_before_clone": {"$ref": "#/$defs/sha256"},
        "source_sha256_after_clone": {"$ref": "#/$defs/sha256"},
        "destination_sha256": {"$ref": "#/$defs/sha256"},
        "source_file_identity": {"$ref": "#/$defs/file_identity"},
        "destination_file_identity": {"$ref": "#/$defs/file_identity"},
        "creator_closed_before_clone": {"const": true},
        "source_immutable_during_clone": {"const": true},
        "source_unchanged_after_clone": {"const": true},
        "all_hashes_equal": {"const": true},
        "exact_byte_clone": {"const": true},
        "source_reparse_free": {"const": true},
        "destination_reparse_free": {"const": true},
        "no_hardlink": {"const": true},
        "same_volume": {"const": true},
        "distinct_file_identity": {"const": true},
        "identities_preserved_by_same_volume_publish_rename": {"const": true},
        "completed_before_reopen_com": {"const": true},
        "reopen_bindings_verified_before_com": {"const": true},
        "status": {"const": "pass"}
      }
    },
    "execution_status": {"const": "pass"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sample_id": {
      "type": "string",
      "pattern": "^M4-V(?:20|30|40)-(?:U|E)-0[1-6]$"
    },
    "safe_relative_path": {
      "type": "string",
      "minLength": 3,
      "maxLength": 255,
      "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9._-]{0,63}/){1,5}[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "database_bytes": {
      "type": "integer",
      "minimum": 2048,
      "maximum": 1048576
    },
    "artifact_set_member": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/safe_relative_path"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "phase_artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["invocation", "operation_log", "snapshot", "worker_result", "post_worker_quiescence"],
      "properties": {
        "invocation": {"$ref": "#/$defs/artifact_set_member"},
        "operation_log": {"$ref": "#/$defs/artifact_set_member"},
        "snapshot": {"$ref": "#/$defs/artifact_set_member"},
        "worker_result": {"$ref": "#/$defs/artifact_set_member"},
        "post_worker_quiescence": {"$ref": "#/$defs/artifact_set_member"}
      }
    },
    "dao_observations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "captured_while_database_open",
        "dao_version",
        "empty_user_schema",
        "user_table_count"
      ],
      "properties": {
        "captured_while_database_open": {"const": true},
        "dao_version": {"enum": ["2.0", "3.0", "4.0"]},
        "empty_user_schema": {"const": true},
        "user_table_count": {"const": 0}
      }
    },
    "post_close_observations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "database_path", "database_bytes", "database_sha256", "prefix_path",
        "prefix_bytes", "prefix_sha256", "database_closed"
      ],
      "properties": {
        "database_path": {"$ref": "#/$defs/safe_relative_path"},
        "database_bytes": {"$ref": "#/$defs/database_bytes"},
        "database_sha256": {"$ref": "#/$defs/sha256"},
        "prefix_path": {"$ref": "#/$defs/safe_relative_path"},
        "prefix_bytes": {"const": 2048},
        "prefix_sha256": {"$ref": "#/$defs/sha256"},
        "database_closed": {"const": true}
      }
    },
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "process_id",
        "started_at_utc",
        "worker_run_id",
        "worker_ordinal",
        "nonce",
        "architecture",
        "provider",
        "fresh_process",
        "bindings_verified_before_com"
      ],
      "properties": {
        "process_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "started_at_utc": {
          "type": "string",
          "format": "date-time"
        },
        "worker_run_id": {
          "type": "string",
          "pattern": "^M4-V(?:20|30|40)-(?:U|E)-0[1-6]-(?:CREATOR|REOPEN)$"
        },
        "worker_ordinal": {
          "type": "integer",
          "minimum": 1,
          "maximum": 72
        },
        "nonce": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
        "architecture": {"const": "x86"},
        "provider": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "powershell_version",
            "prog_id",
            "clsid",
            "server_sha256"
          ],
          "properties": {
            "powershell_version": {
              "type": "string",
              "minLength": 3,
              "maxLength": 32,
              "pattern": "^[0-9]+(?:[.][0-9]+){1,3}$"
            },
            "prog_id": {"const": "DAO.DBEngine.36"},
            "clsid": {
              "type": "string",
              "pattern": "^[{][0-9A-F]{8}-(?:[0-9A-F]{4}-){3}[0-9A-F]{12}[}]$"
            },
            "server_sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "fresh_process": {"const": true},
        "bindings_verified_before_com": {"const": true}
      }
    },
    "file_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["volume_serial_number", "file_index", "link_count"],
      "properties": {
        "volume_serial_number": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}$"
        },
        "file_index": {
          "type": "string",
          "pattern": "^[0-9a-f]{16}$"
        },
        "link_count": {"const": 1}
      }
    },
    "quiescence_database": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path", "bytes", "sha256", "prefix_sha256", "file_identity",
        "exclusive_open_verified", "matches_worker_post_close_observation"
      ],
      "properties": {
        "path": {"$ref": "#/$defs/safe_relative_path"},
        "bytes": {"$ref": "#/$defs/database_bytes"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "prefix_sha256": {"$ref": "#/$defs/sha256"},
        "file_identity": {"$ref": "#/$defs/file_identity"},
        "exclusive_open_verified": {"const": true},
        "matches_worker_post_close_observation": {"const": true}
      }
    },
    "quiescence_companion": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "path", "checked_after_worker_exit"],
          "properties": {
            "state": {"const": "absent"},
            "path": {"$ref": "#/$defs/safe_relative_path"},
            "checked_after_worker_exit": {"const": true}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state", "path", "bytes", "sha256", "file_identity",
            "exclusive_open_verified", "checked_after_worker_exit"
          ],
          "properties": {
            "state": {"const": "present"},
            "path": {"$ref": "#/$defs/safe_relative_path"},
            "bytes": {"type": "integer", "minimum": 0, "maximum": 65536},
            "sha256": {"$ref": "#/$defs/sha256"},
            "file_identity": {"$ref": "#/$defs/file_identity"},
            "exclusive_open_verified": {"const": true},
            "checked_after_worker_exit": {"const": true}
          }
        }
      ]
    },
    "post_worker_quiescence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "worker_finished_at_utc", "observation_started_at_utc",
        "observation_completed_at_utc", "worker_exit_wait_completed",
        "database", "companion", "status"
      ],
      "properties": {
        "worker_finished_at_utc": {"type": "string", "format": "date-time"},
        "observation_started_at_utc": {"type": "string", "format": "date-time"},
        "observation_completed_at_utc": {"type": "string", "format": "date-time"},
        "worker_exit_wait_completed": {"const": true},
        "database": {"$ref": "#/$defs/quiescence_database"},
        "companion": {"$ref": "#/$defs/quiescence_companion"},
        "status": {"const": "pass"}
      }
    },
    "creator_phase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase_id",
        "phase_ordinal",
        "worker",
        "artifacts",
        "dao_observations_while_open",
        "post_close_file_observations",
        "post_worker_quiescence",
        "status"
      ],
      "properties": {
        "phase_id": {"const": "creator"},
        "phase_ordinal": {"const": 1},
        "worker": {"$ref": "#/$defs/worker"},
        "artifacts": {"$ref": "#/$defs/phase_artifacts"},
        "dao_observations_while_open": {"$ref": "#/$defs/dao_observations"},
        "post_close_file_observations": {"$ref": "#/$defs/post_close_observations"},
        "post_worker_quiescence": {"$ref": "#/$defs/post_worker_quiescence"},
        "status": {"const": "pass"}
      }
    },
    "reopen_phase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase_id",
        "phase_ordinal",
        "worker",
        "artifacts",
        "pre_com_file_binding",
        "dao_observations_while_open",
        "post_close_file_observations",
        "post_worker_quiescence",
        "status"
      ],
      "properties": {
        "phase_id": {"const": "reopen"},
        "phase_ordinal": {"const": 2},
        "worker": {"$ref": "#/$defs/worker"},
        "artifacts": {"$ref": "#/$defs/phase_artifacts"},
        "pre_com_file_binding": {
          "type": "object",
          "additionalProperties": false,
          "required": ["database_path", "database_bytes", "database_sha256", "verified_before_com"],
          "properties": {
            "database_path": {"$ref": "#/$defs/safe_relative_path"},
            "database_bytes": {"$ref": "#/$defs/database_bytes"},
            "database_sha256": {"$ref": "#/$defs/sha256"},
            "verified_before_com": {"const": true}
          }
        },
        "dao_observations_while_open": {"$ref": "#/$defs/dao_observations"},
        "post_close_file_observations": {"$ref": "#/$defs/post_close_observations"},
        "post_worker_quiescence": {"$ref": "#/$defs/post_worker_quiescence"},
        "status": {"const": "pass"}
      }
    }
  }
}
