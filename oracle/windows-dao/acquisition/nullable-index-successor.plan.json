  "replicas": 3,
  "source_commit": "6a0e4537e7986a4b04db7616f5537cb306f17e2c",
  "hypothesis": "DAO accepts the exact later-table nullable Long/Auto initial-index writer policy with variable-width null components, unique null-bearing duplicates, Required and IgnoreAllNull options, and existing uncompressed multi-level packing. Finite independent writable-copy probes enforce fully-present uniqueness or required keys with the same native errors as matched controls.",
  "source_facts": [
    "EXP-0148 nullable components, flags, null-bearing uniqueness and omission semantics",
    "EXP-0146 observed branch markers 1/2 and finite multi-level acceptance",
    "EXP-0062 branch/leaf grammar",
    "EXP-0073 distinct counts",
    "EXP-0057 and EXP-0065 allocation roles"
  ],
  "controls": "Three fresh matched DAO databases per arm, same schema and insertion order, one transaction per table. Auto field is generated by DAO; expected B is position+1. Originals opened read-only. Four arms also use independent writable copies for one rejected AddNew/Update each; no post-failure retry.",
  "endpoints": [
    "Full table/field/index/relation inventory and typed complete row multiset, retaining null versus integer and AutoIncrement metadata",
    "Complete encoded-key ordered index traversal including every duplicate payload; IgnoreNulls excludes only all-null keys",
    "Finite non-null matching/missing Seek inventory below, matching any complete existing duplicate row. Null Seek itself is outside this experiment",
    "Raw full variable-length key/row locator binding, distinct counts, branch child-max separators, sibling chains, uniform depth and actual index/data/available maps",
    "Independent writable-copy Update rejection endpoints with actual native codes and HRESULT matched to controls; exact baseline logical snapshot including traversal/Seek after rejection. Originals remain unchanged"
  ],
  "classification": "All 18 baseline controls and 12 control rejection probes must pass, complete inventory and no unexpected job error, all read-only identities unchanged. Three agreeing candidate semantic/structural/error-identity observations per arm yield observed_accepted or not_observed_accepted. Failed controls, disagreement, incomplete job or unexpected failure yield no_outcome. Pin/retained identity mismatch rejects analysis. Retain all 60 MDBs and result JSON. No automatic retry after first mutation. The first invalid baseline/probe halts further mutations and is a job failure/no_outcome, not a retry; partial/missing-file failures produce a failure-only report.",
  "limits": {
    "ssh_timeout_seconds": 3600,
    "image_pages": 8192,
    "rows_per_page": 1019,
    "tree_depth": 32
  },
  "structural_comparison": "Every descendant belongs to its index map; candidate maps contain exactly the graph. Index maps are disjoint from data pages and available maps are subsets of owned data pages. Candidate minimum depths are specified per table. Control compression, placement and depth are observations, not equality requirements. Existing observed marker 1/2 grammar is used without requiring marker=height.",
  "unknowns": "Finite writer acceptance, not general nullable relationships, null Seek behavior, other scalar codecs, indirect writer allocation, updates/splits, hosted support or broad compatibility.",
  "row_formulas": {
    "all": "Empty has no rows. Rows Payload=position. Positions are 0..row_count-1.",
    "unique/ignore": "A=null when position%3=0 else position-6; B=-position.",
    "required": "A=position%3; B=-position.",
    "composite/composite-ignore": "position%4: 0=(null,null), 1=(null,1), 2=(1,null), 3=(position,-position).",
    "auto": "Same A as composite; B generated position+1, overriding composite B."
  },
