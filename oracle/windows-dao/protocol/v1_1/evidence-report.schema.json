{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jet3-rs.invalid/oracle/windows-dao/protocol/v1_1/evidence-report.schema.json",
  "title": "DAO M1 multi-scenario and pair report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "document_type",
    "run_id",
    "git",
    "oracle_revision",
    "command_line",
    "started_at_utc",
    "ended_at_utc",
    "status",
    "status_reason",
    "environment",
    "inventory",
    "scenario_counts",
    "pair_counts",
    "scenarios",
    "pairs"
  ],
  "properties": {
    "protocol_version": { "const": "1.1.0" },
    "document_type": { "const": "dao_evidence_report" },
    "run_id": { "$ref": "#/$defs/runId" },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "dirty"],
      "properties": {
        "commit": { "$ref": "#/$defs/gitCommit" },
        "dirty": { "type": "boolean" }
      }
    },
    "oracle_revision": { "$ref": "#/$defs/gitCommit" },
    "command_line": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "type": "string", "maxLength": 1000 }
    },
    "started_at_utc": { "$ref": "#/$defs/timestamp" },
    "ended_at_utc": { "$ref": "#/$defs/timestamp" },
    "status": { "enum": ["pass", "fail", "blocked", "error"] },
    "status_reason": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "environment": { "$ref": "#/$defs/fileReference" },
    "inventory": { "$ref": "#/$defs/fileReference" },
    "scenario_counts": { "$ref": "#/$defs/counts" },
    "pair_counts": { "$ref": "#/$defs/counts" },
    "scenarios": {
      "type": "array",
      "maxItems": 7,
      "items": { "$ref": "#/$defs/scenarioResult" }
    },
    "pairs": {
      "type": "array",
      "maxItems": 2,
      "items": { "$ref": "#/$defs/pairResult" }
    }
  },
  "$defs": {
    "timestamp": { "type": "string", "format": "date-time" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "gitCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "runId": {
      "type": "string",
      "pattern": "^[0-9]{8}T[0-9]{6}Z-[a-z0-9][a-z0-9-]{0,31}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "scenarioId": {
      "type": "string",
      "pattern": "^DAO-GEN-[A-Z0-9][A-Z0-9_-]{2,63}$"
    },
    "pairId": {
      "type": "string",
      "pattern": "^DAO-PAIR-[A-Z0-9][A-Z0-9_-]{2,63}$"
    },
    "fileReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "nullableReference": {
      "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/fileReference" }]
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selected", "pass", "fail", "blocked", "error", "skipped"],
      "properties": {
        "selected": { "type": "integer", "minimum": 0 },
        "pass": { "type": "integer", "minimum": 0 },
        "fail": { "type": "integer", "minimum": 0 },
        "blocked": { "type": "integer", "minimum": 0 },
        "error": { "type": "integer", "minimum": 0 },
        "skipped": { "type": "integer", "minimum": 0 }
      }
    },
    "scenarioResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_id",
        "recipe",
        "status",
        "reason",
        "input",
        "output_database",
        "dao_snapshot",
        "operation_log"
      ],
      "properties": {
        "scenario_id": { "$ref": "#/$defs/scenarioId" },
        "recipe": {
          "enum": [
            "repeat_empty",
            "binary_marker",
            "text_index_baseline",
            "text_index_nonunique",
            "memo_ladder",
            "long_binary_ladder"
          ]
        },
        "status": { "enum": ["pass", "fail", "blocked", "error", "skipped"] },
        "reason": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "input": { "$ref": "#/$defs/fileReference" },
        "output_database": { "$ref": "#/$defs/nullableReference" },
        "dao_snapshot": { "$ref": "#/$defs/nullableReference" },
        "operation_log": { "$ref": "#/$defs/nullableReference" }
      }
    },
    "pairResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pair_id",
        "status",
        "reason",
        "input",
        "left_scenario_id",
        "right_scenario_id",
        "left_snapshot",
        "right_snapshot",
        "observed_difference_paths"
      ],
      "properties": {
        "pair_id": { "$ref": "#/$defs/pairId" },
        "status": { "enum": ["pass", "fail", "blocked", "error", "skipped"] },
        "reason": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "input": { "$ref": "#/$defs/fileReference" },
        "left_scenario_id": { "$ref": "#/$defs/scenarioId" },
        "right_scenario_id": { "$ref": "#/$defs/scenarioId" },
        "left_snapshot": { "$ref": "#/$defs/nullableReference" },
        "right_snapshot": { "$ref": "#/$defs/nullableReference" },
        "observed_difference_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^/(?:[^/~]|~0|~1)+(?:/(?:[^/~]|~0|~1)+)*$"
          }
        }
      }
    }
  }
}
