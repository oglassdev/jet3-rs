{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jet3-rs.invalid/oracle/windows-dao/protocol/v1_1/example-inventory.schema.json",
  "title": "Checked DAO M1 example inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "document_type", "generator", "files"],
  "properties": {
    "protocol_version": { "const": "1.1.0" },
    "document_type": { "const": "dao_example_inventory" },
    "generator": { "const": "oracle/windows-dao/scripts/build_m1_examples.py" },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "document_type", "sha256"],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_.-]+\\.json$"
          },
          "document_type": { "enum": ["dao_scenario", "dao_pair"] },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  }
}
