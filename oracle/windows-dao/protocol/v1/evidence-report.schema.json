{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jet3-rs.invalid/oracle/windows-dao/protocol/v1/evidence-report.schema.json",
  "title": "DAO oracle evidence report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "document_type",
    "run_id",
    "git",
    "oracle_revision",
    "command_line",
    "started_at_utc",
    "ended_at_utc",
    "status",
    "status_reason",
    "environment",
    "counts",
    "scenarios"
  ],
  "properties": {
    "protocol_version": { "const": "1.0.0" },
    "document_type": { "const": "dao_evidence_report" },
    "run_id": { "$ref": "#/$defs/runId" },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "dirty"],
      "properties": {
        "commit": { "$ref": "#/$defs/gitCommit" },
        "dirty": { "type": "boolean" }
      }
    },
    "oracle_revision": { "$ref": "#/$defs/gitCommit" },
    "command_line": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "started_at_utc": { "$ref": "#/$defs/timestamp" },
    "ended_at_utc": { "$ref": "#/$defs/timestamp" },
    "status": { "enum": ["pass", "fail", "blocked", "error"] },
    "status_reason": { "type": "string", "minLength": 1 },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selected", "pass", "fail", "blocked", "error", "skipped"],
      "properties": {
        "selected": { "type": "integer", "minimum": 0 },
        "pass": { "type": "integer", "minimum": 0 },
        "fail": { "type": "integer", "minimum": 0 },
        "blocked": { "type": "integer", "minimum": 0 },
        "error": { "type": "integer", "minimum": 0 },
        "skipped": { "type": "integer", "minimum": 0 }
      }
    },
    "scenarios": {
      "type": "array",
      "items": { "$ref": "#/$defs/scenarioResult" }
    }
  },
  "$defs": {
    "timestamp": { "type": "string", "format": "date-time" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "gitCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "runId": {
      "type": "string",
      "pattern": "^[0-9]{8}T[0-9]{6}Z-[a-z0-9][a-z0-9-]{0,31}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "scenarioId": {
      "type": "string",
      "pattern": "^DAO-(GEN|READ|WRITE|UPDATE)-[A-Z0-9][A-Z0-9_-]{2,63}$"
    },
    "fileReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "scenarioResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_id",
        "status",
        "reason",
        "input",
        "source_database",
        "output_database",
        "dao_snapshot",
        "rust_snapshot",
        "operation_log"
      ],
      "properties": {
        "scenario_id": { "$ref": "#/$defs/scenarioId" },
        "status": { "enum": ["pass", "fail", "blocked", "error", "skipped"] },
        "reason": { "type": "string", "minLength": 1 },
        "input": { "$ref": "#/$defs/fileReference" },
        "source_database": {
          "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/fileReference" }]
        },
        "output_database": {
          "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/fileReference" }]
        },
        "dao_snapshot": {
          "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/fileReference" }]
        },
        "rust_snapshot": {
          "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/fileReference" }]
        },
        "operation_log": {
          "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/fileReference" }]
        }
      }
    }
  }
}
