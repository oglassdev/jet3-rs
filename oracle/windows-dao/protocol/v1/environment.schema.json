{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jet3-rs.invalid/oracle/windows-dao/protocol/v1/environment.schema.json",
  "title": "DAO oracle environment record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "document_type",
    "captured_at_utc",
    "status",
    "status_reason",
    "host",
    "runtime",
    "regional",
    "provider_candidates",
    "accepted_provider"
  ],
  "properties": {
    "protocol_version": { "const": "1.0.0" },
    "document_type": { "const": "dao_environment" },
    "captured_at_utc": { "$ref": "#/$defs/timestamp" },
    "status": { "enum": ["ready", "blocked", "error"] },
    "status_reason": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "is_windows",
        "computer_name",
        "os_caption",
        "os_version",
        "os_build",
        "os_architecture",
        "process_architecture"
      ],
      "properties": {
        "is_windows": { "type": "boolean" },
        "computer_name": { "type": "string" },
        "os_caption": { "type": "string" },
        "os_version": { "type": "string" },
        "os_build": { "type": "string" },
        "os_architecture": { "type": "string" },
        "process_architecture": { "enum": ["x86", "x64", "arm64", "unknown"] }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["powershell_edition", "powershell_version", "dotnet_version"],
      "properties": {
        "powershell_edition": { "type": "string" },
        "powershell_version": { "type": "string" },
        "dotnet_version": { "type": "string" }
      }
    },
    "regional": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "culture",
        "ui_culture",
        "ansi_code_page",
        "oem_code_page",
        "timezone_id",
        "utc_offset"
      ],
      "properties": {
        "culture": { "type": "string" },
        "ui_culture": { "type": "string" },
        "ansi_code_page": { "type": "integer", "minimum": 0 },
        "oem_code_page": { "type": "integer", "minimum": 0 },
        "timezone_id": { "type": "string" },
        "utc_offset": { "type": "string", "pattern": "^[+-][0-9]{2}:[0-9]{2}$" }
      }
    },
    "provider_candidates": {
      "type": "array",
      "items": { "$ref": "#/$defs/providerCandidate" }
    },
    "accepted_provider": {
      "anyOf": [
        { "type": "null" },
        { "$ref": "#/$defs/acceptedProvider" }
      ]
    }
  },
  "$defs": {
    "timestamp": { "type": "string", "format": "date-time" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "providerCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prog_id",
        "clsid",
        "registry_view",
        "registration_scope",
        "registered",
        "server_path",
        "server_file_version",
        "server_sha256",
        "activation",
        "provider_version",
        "dbversion30_test"
      ],
      "properties": {
        "prog_id": { "type": "string", "minLength": 1 },
        "clsid": { "type": ["string", "null"] },
        "registry_view": { "enum": ["x86", "x64"] },
        "registration_scope": { "enum": ["user", "machine"] },
        "registered": { "type": "boolean" },
        "server_path": { "type": ["string", "null"] },
        "server_file_version": { "type": ["string", "null"] },
        "server_sha256": {
          "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/sha256" }]
        },
        "activation": { "enum": ["not_tested", "succeeded", "failed"] },
        "provider_version": { "type": ["string", "null"] },
        "dbversion30_test": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "detail"],
          "properties": {
            "status": { "enum": ["not_run", "pass", "fail", "error"] },
            "detail": { "type": "string" }
          }
        }
      }
    },
    "acceptedProvider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prog_id",
        "clsid",
        "registry_view",
        "registration_scope",
        "provider_version",
        "server_path",
        "server_file_version",
        "server_sha256",
        "database_version"
      ],
      "properties": {
        "prog_id": { "type": "string", "minLength": 1 },
        "clsid": { "type": "string", "minLength": 1 },
        "registry_view": { "enum": ["x86", "x64"] },
        "registration_scope": { "enum": ["user", "machine"] },
        "provider_version": { "type": "string", "minLength": 1 },
        "server_path": { "type": "string", "minLength": 1 },
        "server_file_version": { "type": "string", "minLength": 1 },
        "server_sha256": { "$ref": "#/$defs/sha256" },
        "database_version": { "const": "dbVersion30" }
      }
    }
  }
}
