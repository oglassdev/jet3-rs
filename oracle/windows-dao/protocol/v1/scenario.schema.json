{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jet3-rs.invalid/oracle/windows-dao/protocol/v1/scenario.schema.json",
  "title": "DAO oracle declarative scenario",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "document_type",
    "scenario_id",
    "title",
    "purpose",
    "capabilities",
    "traceability",
    "mode",
    "requirements",
    "database",
    "steps",
    "expected"
  ],
  "properties": {
    "protocol_version": { "const": "1.0.0" },
    "document_type": { "const": "dao_scenario" },
    "scenario_id": {
      "type": "string",
      "pattern": "^DAO-(GEN|READ|WRITE|UPDATE)-[A-Z0-9][A-Z0-9_-]{2,63}$"
    },
    "title": { "type": "string", "minLength": 1, "maxLength": 160 },
    "purpose": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
      }
    },
    "traceability": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Z]+-[0-9]{2}$" }
    },
    "mode": {
      "enum": [
        "dao_generate_fixture",
        "rust_read_dao",
        "dao_open_rust",
        "dao_verify_rust_update"
      ]
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["database_version", "provider_api", "provider_bitness"],
      "properties": {
        "database_version": { "const": "dbVersion30" },
        "provider_api": { "const": "DAO COM" },
        "provider_bitness": { "enum": ["x86", "x64", "either"] }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_role", "output_path"],
      "properties": {
        "input_role": {
          "enum": ["none", "dao_created", "rust_created", "rust_updated"]
        },
        "input_path": { "$ref": "#/$defs/relativePath" },
        "input_sha256": { "$ref": "#/$defs/sha256" },
        "output_path": { "$ref": "#/$defs/relativePath" }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/step" }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "reopen_before_snapshot"],
      "properties": {
        "outcome": { "enum": ["success", "expected_error"] },
        "error_class": { "type": "string", "minLength": 1, "maxLength": 160 },
        "snapshot_path": { "$ref": "#/$defs/relativePath" },
        "reopen_before_snapshot": { "type": "boolean" },
        "preserve_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 500 }
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step_id", "action", "arguments"],
      "properties": {
        "step_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "action": {
          "enum": [
            "create_database",
            "open_database",
            "close_database",
            "reopen_database",
            "create_table",
            "drop_table",
            "create_index",
            "drop_index",
            "create_relationship",
            "drop_relationship",
            "insert_row",
            "read_rows",
            "update_rows",
            "delete_rows",
            "export_snapshot"
          ]
        },
        "arguments": { "type": "object" }
      }
    }
  }
}
