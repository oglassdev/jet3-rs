{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jet3-rs.invalid/oracle/windows-dao/protocol/v1_2/coverage-receipt.schema.json",
  "title": "Rust reader coverage receipt",
  "properties": {
    "document_type": { "const": "rust_coverage_receipt" }
  },
  "anyOf": [
    { "$ref": "#/$defs/successReceipt" },
    { "$ref": "#/$defs/openingFailureReceipt" }
  ],
  "$defs": {
    "successReceipt": {
      "$ref": "#/$defs/successReceiptObject"
    },
    "successReceiptObject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "document_type", "scenario_id", "source_revision", "database_sha256", "allocated_set_sha256", "outcome", "error_class", "branches"],
      "properties": {
        "protocol_version": { "const": "1.2.0" },
        "document_type": { "const": "rust_coverage_receipt" },
        "scenario_id": { "$ref": "#/$defs/scenarioId" },
        "source_revision": { "type": "string", "minLength": 1, "maxLength": 200 },
        "database_sha256": { "$ref": "#/$defs/sha256" },
        "allocated_set_sha256": { "$ref": "#/$defs/sha256" },
        "outcome": { "const": "success" },
        "error_class": { "type": "null" },
        "branches": { "$ref": "#/$defs/branches" }
      }
    },
    "openingFailureReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "document_type", "scenario_id", "source_revision", "database_sha256", "allocated_set_sha256", "outcome", "error_class", "branches"],
      "properties": {
        "protocol_version": { "const": "1.2.0" },
        "document_type": { "const": "rust_coverage_receipt" },
        "scenario_id": { "$ref": "#/$defs/scenarioId" },
        "source_revision": { "type": "string", "minLength": 1, "maxLength": 200 },
        "database_sha256": { "$ref": "#/$defs/sha256" },
        "allocated_set_sha256": { "type": "null" },
        "outcome": { "const": "opening_failure" },
        "error_class": {
          "enum": ["unsupported_version", "encrypted_database", "password_protected"]
        },
        "branches": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "prefixItems": [
            { "const": "open.header_page" },
            { "const": "open.rejected_format" },
            { "const": "open.signature_geometry" }
          ],
          "items": false
        }
      }
    },
    "scenarioId": {
      "type": "string",
      "pattern": "^DAO-(READ|WRITE|UPDATE)-[A-Z0-9][A-Z0-9_-]{2,63}$"
    },
    "branches": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
