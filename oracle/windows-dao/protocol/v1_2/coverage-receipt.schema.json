{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jet3-rs.invalid/oracle/windows-dao/protocol/v1_2/coverage-receipt.schema.json",
  "title": "Rust reader coverage receipt written beside a canonical snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "document_type",
    "scenario_id",
    "producer",
    "database_sha256",
    "outcome",
    "error_class",
    "branches",
    "scenarios"
  ],
  "properties": {
    "protocol_version": { "const": "1.2.0" },
    "document_type": { "const": "coverage_receipt" },
    "scenario_id": { "type": "string", "pattern": "^DAO-(READ|WRITE|UPDATE)-[A-Z0-9][A-Z0-9_-]{2,63}$" },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "source_revision"],
      "properties": {
        "kind": { "const": "rust" },
        "source_revision": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    },
    "database_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "outcome": { "enum": ["success", "opening_failure"] },
    "error_class": { "enum": [null, "unsupported_version", "encrypted_database", "password_protected"] },
    "branches": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$" }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "outcome_matches", "missing_branches", "forbidden_observed", "satisfied"],
        "properties": {
          "id": { "type": "string", "pattern": "^DAO-(READ|WRITE|UPDATE)-[A-Z0-9][A-Z0-9_-]{2,63}$" },
          "outcome_matches": { "type": "boolean" },
          "missing_branches": { "type": "array", "items": { "type": "string" } },
          "forbidden_observed": { "type": "array", "items": { "type": "string" } },
          "satisfied": { "type": "boolean" }
        }
      }
    }
  }
}
