{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jet3-rs.invalid/schema/benchmark-resource-metrics-v1.json",
  "title": "jet3-rs per-case benchmark resource metrics",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "measurements"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "measurements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "criterion_id",
          "peak_rss_bytes",
          "output_size_bytes"
        ],
        "properties": {
          "criterion_id": {
            "type": "string",
            "minLength": 1
          },
          "peak_rss_bytes": {
            "type": "integer",
            "minimum": 1
          },
          "output_size_bytes": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  }
}
