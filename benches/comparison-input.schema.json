{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jet3-rs.invalid/schema/benchmark-comparison-input-v1.json",
  "title": "jet3-rs normalized benchmark comparison input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "suite_id",
    "metadata",
    "raw_measurement_artifacts",
    "measurements"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "suite_id": {
      "const": "BENCH-FORMAT-FOUNDATION-V1"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "git_commit",
        "dirty",
        "captured_at_utc",
        "os",
        "architecture",
        "cpu",
        "logical_cpus",
        "memory_bytes",
        "rustc",
        "cargo",
        "benchmark_manifest_sha256",
        "benchmark_lockfile_sha256",
        "suite_digest_sha256"
      ],
      "properties": {
        "git_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "dirty": {
          "type": "boolean"
        },
        "captured_at_utc": {
          "type": "string",
          "format": "date-time"
        },
        "os": {
          "type": "string",
          "minLength": 1
        },
        "architecture": {
          "type": "string",
          "minLength": 1
        },
        "cpu": {
          "type": "string",
          "minLength": 1
        },
        "logical_cpus": {
          "type": "integer",
          "minimum": 1
        },
        "memory_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "rustc": {
          "type": "string",
          "minLength": 1
        },
        "cargo": {
          "type": "string",
          "minLength": 1
        },
        "benchmark_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "benchmark_lockfile_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "suite_digest_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "raw_measurement_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "$ref": "#/$defs/repositoryPath"
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    },
    "measurements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "metrics"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^BENCH-"
          },
          "metrics": {
            "type": "object",
            "additionalProperties": false,
            "minProperties": 1,
            "required": [
              "median_latency_ns",
              "throughput_bytes_per_second",
              "peak_rss_bytes",
              "output_size_bytes"
            ],
            "properties": {
              "median_latency_ns": {
                "$ref": "#/$defs/positiveNumber"
              },
              "throughput_bytes_per_second": {
                "$ref": "#/$defs/positiveNumber"
              },
              "peak_rss_bytes": {
                "$ref": "#/$defs/positiveNumber"
              },
              "output_size_bytes": {
                "$ref": "#/$defs/positiveNumber"
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "repositoryPath": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+(?:[.][A-Za-z0-9_-]+)*(?:/[A-Za-z0-9_-]+(?:[.][A-Za-z0-9_-]+)*)*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "positiveNumber": {
      "type": "number",
      "exclusiveMinimum": 0
    }
  }
}
