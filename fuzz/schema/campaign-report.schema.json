{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://access97-rs.invalid/schema/fuzz-campaign-report.schema.json",
  "title": "Fuzz campaign evidence report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "commit",
    "target",
    "target_registry_sha256",
    "target_source_sha256",
    "corpus",
    "campaign",
    "result",
    "limits",
    "observed",
    "producer"
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "pattern": "^[^/]+$" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "version"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cargo", "cargo_fuzz", "rustc"],
      "properties": {
        "cargo": { "$ref": "#/$defs/tool" },
        "cargo_fuzz": { "$ref": "#/$defs/tool" },
        "rustc": { "$ref": "#/$defs/tool" }
      }
    },
    "executable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  },
  "properties": {
    "schema_version": { "const": 3 },
    "commit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha", "tree", "clean"],
      "properties": {
        "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "tree": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "clean": { "const": true }
      }
    },
    "target": { "type": "string", "minLength": 1 },
    "target_registry_sha256": { "$ref": "#/$defs/sha256" },
    "target_source_sha256": { "$ref": "#/$defs/sha256" },
    "corpus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest_sha256", "seeds"],
      "properties": {
        "manifest_sha256": { "$ref": "#/$defs/sha256" },
        "seeds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "path", "sha256"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "path": { "type": "string", "minLength": 1 },
              "sha256": { "$ref": "#/$defs/sha256" }
            }
          }
        }
      }
    },
    "campaign": {
      "type": "object",
      "additionalProperties": false,
      "required": ["duration_seconds", "kind", "deterministic_seed", "sanitizer"],
      "properties": {
        "duration_seconds": { "type": "integer", "minimum": 1 },
        "kind": { "enum": ["smoke", "full"] },
        "deterministic_seed": { "type": "integer", "minimum": 0 },
        "sanitizer": {
          "enum": ["address", "memory", "leak", "thread", "undefined", "none"]
        }
      }
    },
    "result": {
      "enum": ["clean", "crash", "panic", "hang", "sanitizer_finding", "limit_exceeded"]
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wall_clock_seconds", "peak_rss_bytes"],
      "properties": {
        "wall_clock_seconds": { "type": "number", "exclusiveMinimum": 0 },
        "peak_rss_bytes": { "type": "integer", "minimum": 1 }
      }
    },
    "observed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wall_clock_seconds",
        "peak_rss_bytes",
        "runs",
        "started_at",
        "finished_at",
        "exit_code"
      ],
      "properties": {
        "wall_clock_seconds": { "type": "number", "minimum": 0 },
        "peak_rss_bytes": { "type": "integer", "minimum": 1 },
        "runs": { "type": "integer", "minimum": 1 },
        "started_at": { "type": "string", "format": "date-time" },
        "finished_at": { "type": "string", "format": "date-time" },
        "exit_code": { "type": ["integer", "null"] }
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "log",
        "observer",
        "build_manifest",
        "cargo_metadata",
        "command",
        "toolchain",
        "build_environment",
        "executable"
      ],
      "properties": {
        "log": { "$ref": "#/$defs/artifact" },
        "observer": { "$ref": "#/$defs/artifact" },
        "build_manifest": { "$ref": "#/$defs/artifact" },
        "cargo_metadata": { "$ref": "#/$defs/artifact" },
        "command": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "toolchain": { "$ref": "#/$defs/toolchain" },
        "build_environment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "CARGO",
            "CARGO_HOME",
            "CARGO_INCREMENTAL",
            "CARGO_TARGET_DIR",
            "CARGO_TERM_COLOR",
            "LANG",
            "LC_ALL",
            "PATH",
            "RUSTC",
            "TMPDIR"
          ],
          "properties": {
            "CARGO": { "type": "string", "minLength": 1 },
            "CARGO_HOME": { "type": "string", "minLength": 1 },
            "CARGO_INCREMENTAL": { "const": "0" },
            "CARGO_TARGET_DIR": { "type": "string", "minLength": 1 },
            "CARGO_TERM_COLOR": { "const": "never" },
            "LANG": { "const": "C" },
            "LC_ALL": { "const": "C" },
            "PATH": { "type": "string", "minLength": 1 },
            "RUSTC": { "type": "string", "minLength": 1 },
            "TMPDIR": { "type": "string", "minLength": 1 },
            "COMSPEC": { "type": "string", "minLength": 1 },
            "PATHEXT": { "type": "string", "minLength": 1 },
            "SYSTEMROOT": { "type": "string", "minLength": 1 },
            "TEMP": { "type": "string", "minLength": 1 },
            "TMP": { "type": "string", "minLength": 1 }
          }
        },
        "executable": { "$ref": "#/$defs/executable" }
      }
    }
  }
}
